<!--
  The startup flow (App.OnAppStartup) requires the window to be mounted off-screen first and
  revealed only after the Splash finishes; system-level CenterScreen centers at Show time,
  which would reveal the main window early, so this must stay Manual.
  The real "center on the current monitor" is computed at reveal time by
  MainWindow.RevealAtStartupPosition.
-->
<Window x:Class="JuniGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JuniGrid.Components"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JuniGrid — Your Junimo helper"
        Height="1000" Width="1600"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#F3F6FB"
        ShowInTaskbar="True"
        Icon="Assets/junigrid-logo.ico">

    <!--
      AllowsTransparency must stay FALSE — WebView2 is a child HWND
      and layered/transparent windows cannot host it.
      Rounded corners come from DWM (see OnSourceInitialized).
    -->
    <!--
      CaptionHeight="0" is key: the title bar is drawn entirely by Blazor itself (jg-titlebar);
      dragging calls DragMove via a JS callback (see TitleBar.razor + junigridJs.enableWindowDrag).
      The earlier CaptionHeight="40" treated the top 40px as the system title bar and intercepted
      clicks, swallowing all Blazor buttons (minimize/close) and the built-in browser toolbar.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView"
                              HostPage="wwwroot/index.html"
                              Services="{StaticResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type local:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>

        <!-- ===== v1.1.2: theme-switch circular reveal overlay =====
             When switching themes, a screenshot of the old-theme page is laid here
             (on top of the WebView), then an OpacityMask carves a constantly growing
             circular hole from the toggle position to reveal the new theme.
             Pure WPF drawing path, completely bypassing the WebView2 View Transitions
             compositor defect. -->
        <Image x:Name="ThemeRevealOverlay"
               Stretch="Fill"
               IsHitTestVisible="False"
               Visibility="Collapsed"/>

        <!-- ===== Built-in Nexus browser: overlay inside the main window =====
             Free users click Mod Manager Download here; nxm:// links are intercepted and
             installed automatically. Uses a separate WebView2 environment (its own user data
             folder) to avoid state conflicts with the Blazor WebView (0x8007139F). -->
        <!-- Embedded content area (not a full-window overlay): leaves room for the 40px title
             bar + 232px sidebar + 46px top nav, with page padding around it, so it looks like a
             browser panel embedded in the "Mod Management" content area. -->
        <!-- The built-in Nexus browser overlay has been removed: links now open in the system browser -->
    </Grid>
</Window>
