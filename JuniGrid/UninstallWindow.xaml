<Window x:Class="JuniGrid.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall JuniGrid"
        Width="500" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4655" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF5A66" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E63A4A" />

    <!-- Red danger button (Uninstall) -->
    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource DangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#3A000000" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Light gray button (Cancel on white background) -->
    <Style x:Key="LightGrayButton" TargetType="Button">
      <Setter Property="Background" Value="#ECEEF0" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E0E3E6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D5D9DD" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Black button (Done) -->
    <Style x:Key="BlackButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#333333" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0F0F0F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title bar buttons: icon strokes are inline in each usage, Tag overrides the hover background -->
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=#22FFFFFF}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- ========== Blocked page (app is running) ========== -->
    <Grid x:Name="BlockedScreen" Visibility="Collapsed" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <Image Source="/Assets/junigrid-logo-256.png" Width="52" Height="52" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="JuniGrid Is Running" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,26,0,0" TextWrapping="Wrap" />
        <Rectangle Height="5" Width="170" HorizontalAlignment="Left" Fill="#1A1A1A" RadiusX="2.5" RadiusY="2.5" Margin="0,10,0,0" />
        <TextBlock Text="We can't uninstall while JuniGrid is still running. Please close JuniGrid and try again."
                   FontSize="15" Foreground="#555555" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0" />
      </StackPanel>
      <Button x:Name="BtnOk" Style="{StaticResource BlackButton}" Content="OK" Width="340" Height="56"
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Click="OnCancel" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== Confirm page (white background + washed-out key art) ========== -->
    <Grid x:Name="ConfirmScreen" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <Image Source="/Assets/junigrid-logo-256.png" Width="52" Height="52" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="Uninstall JuniGrid?" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,26,0,0" TextWrapping="Wrap" />
        <TextBlock Text="Program files, shortcuts, and local data (userdata) will be deleted. This action cannot be undone.&#x0a;Are you sure you want to uninstall JuniGrid?"
                   FontSize="15" Foreground="#555555" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="36,0,36,44">
        <Button x:Name="BtnCancel" Style="{StaticResource LightGrayButton}" Content="Cancel" Width="150" Height="48" Click="OnCancel" />
        <Button x:Name="BtnUninstall" Style="{StaticResource BlackButton}" Content="Uninstall" Width="150" Height="48" Margin="18,0,0,0" Click="OnUninstall" />
      </StackPanel>
      <!-- Dark window buttons on white background -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize" ToolTip="Minimize">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose" ToolTip="Close">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== Uninstalling (key art + red bar) ========== -->
    <Grid x:Name="WorkingScreen" Visibility="Collapsed">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" />
      <Rectangle VerticalAlignment="Bottom" Height="200" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#000D0F12" Offset="0" />
            <GradientStop Color="#E60D0F12" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <TextBlock Text="Uninstalling" Foreground="#F4F7F5" FontWeight="Bold" FontSize="14"
                 VerticalAlignment="Bottom" Margin="24,0,0,28" />
      <Rectangle VerticalAlignment="Bottom" Height="7" Fill="#2EFFFFFF" />
      <Canvas x:Name="IndHost" VerticalAlignment="Bottom" Height="7" ClipToBounds="True">
        <Rectangle x:Name="IndBar" Canvas.Top="0" Height="7" Width="140" Fill="{StaticResource DangerBrush}" RadiusX="3.5" RadiusY="3.5" />
      </Canvas>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#E81123" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== Done (white background + washed-out key art) ========== -->
    <Grid x:Name="DoneScreen" Visibility="Collapsed" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <TextBlock Text="Uninstall Complete" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" />
        <Rectangle Height="5" Width="150" HorizontalAlignment="Left" Fill="#1A1A1A" RadiusX="2.5" RadiusY="2.5" Margin="0,10,0,0" />
        <TextBlock Text="JuniGrid has been successfully uninstalled." FontSize="15" Foreground="#555555" Margin="0,22,0,0" />
      </StackPanel>
      <Button x:Name="BtnDone" Style="{StaticResource BlackButton}" Content="Done" Width="340" Height="56"
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Click="OnDone" />
      <!-- Dark window buttons on white background -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
