<Window x:Class="JuniGrid.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="560" Height="240"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <!-- Transparent splash window (this window hosts no WebView2, so AllowsTransparency=True is fine).
         Layout: a centered Canvas Stage containing the logo (slides left on its own),
         a transparent outlined word and a white-filled word.
         StrokePath draws the outline stroke by stroke (the stroke itself is transparent and only
         drives the fill timing); FillPath uses a Clip rectangle (in Path-local coordinates)
         expanding from zero width to achieve the left-to-right fill. -->
    <Canvas x:Name="Stage"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="560" Height="240"
            Background="Transparent">

        <!-- Logo is static: no fade-in/scale/slide-left animation, fixed at the far left -->
        <Image x:Name="LogoImg"
               Source="pack://application:,,,/Assets/junigrid-logo-256.png"
               Width="140" Height="140"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Opacity="1" />

        <!-- v0.26.0: StrokePath is transparent again and only drives the per-stroke timing (visually invisible) -->
        <Path x:Name="StrokePath"
              Stroke="Transparent"
              StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              IsHitTestVisible="False" />

        <!-- v0.26.0: FillPath white fill + black outer outline (the Splash itself stays transparent; the wordmark just carries its own outline) -->
        <Path x:Name="FillPath"
              Fill="#FFFFFF"
              Stroke="#111111"
              StrokeThickness="2.4"
              StrokeLineJoin="Round"
              IsHitTestVisible="False" />
    </Canvas>
</Window>