@namespace JuniGrid.Components.Layout
@inject IJSRuntime JS
@inject JuniGrid.Services.UpdateService Upd
@implements IAsyncDisposable

<div class="jg-titlebar">
    <div class="jg-titlebar-drag" @ref="_dragZone">
        <div class="jg-brand">
            <img class="jg-logo-img" src="assets/junigrid-logo-64.png" alt="JG" style="width:24px;height:24px;border-radius:6px" />
            <div class="jg-brand-text">
                <span class="jg-brand-name">JuniGrid</span>
            </div>
            @* Self-update button: completely absent (not rendered) until a newer release
               exists on GitHub, so there is nothing to click when up-to-date. *@
            @if (_selfUpdate is not null)
            {
                <button class="jg-upd-btn" @onclick="StartSelfUpdate" disabled="@_updating"
                        title="@(_updating ? _updateStatus : $"Update to {_selfUpdate.Version} available — click to install")">
                    <svg viewBox="0 0 1024 1024" width="16" height="16" aria-hidden="true">
                        <path d="M512 56.878545c251.345455 0 455.121455 203.776 455.121455 455.121455S763.345455 967.121455 512 967.121455 56.878545 763.345455 56.878545 512 260.654545 56.878545 512 56.878545z m1.629091 227.141819l-181.061818 181.061818a28.439273 28.439273 0 1 0 40.261818 40.215273l110.312727-110.312728v315.717818a28.439273 28.439273 0 0 0 56.878546 0V390.981818l114.408727 114.362182a28.439273 28.439273 0 1 0 40.215273-40.215273l-181.061819-181.061818z"></path>
                    </svg>
                    @if (_updating && _progressPercent is > 0)
                    {
                        <span class="jg-upd-pct">@($"{_progressPercent:0}%")</span>
                    }
                </button>
            }
        </div>
    </div>

    <div class="jg-titlebar-actions">
        <button class="jg-winbtn" @onclick="Minimize" title="Minimize">—</button>
        <button class="jg-winbtn" @onclick="ToggleMax" title="@(_isMax ? "Restore" : "Maximize")">@(_isMax ? "❐" : "☐")</button>
        <button class="jg-winbtn jg-winbtn-close" @onclick="Close" title="Close">✕</button>
    </div>
</div>

@code {
    private ElementReference _dragZone;
    private DotNetObjectReference<TitleBar>? _selfRef;
    private bool _isMax;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        // Safety net: if junigridJs isn't ready yet (script load failure), the first-render Task must not become an unobserved exception
        try { await JS.InvokeVoidAsync("junigridJs.enableWindowDrag", _dragZone, _selfRef); }
        catch { }

        // Track window maximized state: when maximized, the button icon switches to the "restore" shape (❐) and
        // the jg-max class is added to body to remove CSS rounded corners (DWM drops the rounded corners when maximized).
        var w = GetWindow();
        if (w is not null)
        {
            _isMax = w.WindowState == System.Windows.WindowState.Maximized;
            w.StateChanged += OnWindowStateChanged;
            await SyncMaxClass();
        }

        // Quiet self-update check shortly after startup: keeps the button hidden unless a
        // newer release is actually published.
        _ = CheckForSelfUpdateAsync();
    }

    // ---- Self-update button ----
    private JuniGrid.Services.SelfUpdateInfo? _selfUpdate;
    private bool _updating;
    private double? _progressPercent;
    private string? _updateStatus;

    private async Task CheckForSelfUpdateAsync()
    {
        var info = await Upd.CheckSelfUpdateAsync();
        if (info is null) return;   // up-to-date or offline: button stays hidden
        await InvokeAsync(() => { _selfUpdate = info; StateHasChanged(); });
    }

    private Progress<JuniGrid.Services.UpdateService.InstallProgress> MakeProgress() =>
        new(p => InvokeAsync(() =>
        {
            _updateStatus = p.Message;
            _progressPercent = p.Percent;
            StateHasChanged();
        }));

    private async Task StartSelfUpdate()
    {
        if (_selfUpdate is null || _updating) return;
        _updating = true;
        _updateStatus = "Downloading the update…";
        StateHasChanged();
        try
        {
            await Upd.DownloadAndRunSelfUpdateAsync(_selfUpdate, MakeProgress());
            // The silent installer is running — close the app so files can be replaced.
            await Task.Delay(1500);
            GetWindow()?.Dispatcher.Invoke(() => System.Windows.Application.Current.Shutdown());
        }
        catch (Exception ex)
        {
            _updateStatus = "Update failed: " + ex.Message;
            _updating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnWindowStateChanged(object? sender, EventArgs e)
    {
        var w = GetWindow();
        _isMax = w?.WindowState == System.Windows.WindowState.Maximized;
        _ = InvokeAsync(async () =>
        {
            await SyncMaxClass();
            StateHasChanged();
        });
    }

    private async Task SyncMaxClass()
    {
        try
        {
            await JS.InvokeVoidAsync("junigridJs.setMaximized", _isMax);
            await JS.InvokeVoidAsync("junigridJs.restored");   // remove the shrink fade-out style when restoring from minimized
        }
        catch { /* ignore if JS isn't ready yet */ }
    }

    // ---- Window dragging (JS mousedown → here; DragMove must be called while the left button is held)----
    [JSInvokable]
    public void BeginDrag()
    {
        var w = GetWindow();
        if (w is null) return;
        try
        {
            if (w.WindowState == System.Windows.WindowState.Maximized)
                w.WindowState = System.Windows.WindowState.Normal;
            w.DragMove();
        }
        catch (InvalidOperationException)
        {
            // DragMove throws this when the mouse is already released — normal, ignore
        }
    }

    [JSInvokable]
    public void ToggleMaximize() => ToggleMax();

    // ---- Window buttons ----
    private async Task Minimize()
    {
        var w = GetWindow();
        if (w is null) return;
        // Borderless window minimize: use StaticMethod.ShowWindow (Win32) to force the minimize so the
        // WebView child windows are withdrawn from the screen too, avoiding a leftover transparent
        // interactive window (the desktop can't be clicked at the original position after minimizing).
        try
        {
            await JS.InvokeVoidAsync("junigridJs.animateMinimize");
        }
        catch { }
        MainWindow.MinimizeWindow();
    }

    private void ToggleMax()
    {
        var w = GetWindow();
        if (w is null) return;
        w.WindowState = w.WindowState == System.Windows.WindowState.Maximized
            ? System.Windows.WindowState.Normal
            : System.Windows.WindowState.Maximized;
    }

    private void Close() => GetWindow()?.Close();

    private static System.Windows.Window? GetWindow()
    {
        var app = System.Windows.Application.Current;
        if (app is null) return null;
        if (app.MainWindow is not null) return app.MainWindow;
        foreach (System.Windows.Window w in app.Windows)
            return w;
        return null;
    }

    public ValueTask DisposeAsync()
    {
        var w = GetWindow();
        if (w is not null) w.StateChanged -= OnWindowStateChanged;
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
