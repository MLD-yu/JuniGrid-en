@namespace JuniGrid.Components.Layout
@inject TaskCenterService Center
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ConfigService Cfg
@implements IDisposable

@* v1.06.4: the dock stays permanently visible in real time — no longer auto-hides (it used to vanish 8 seconds
   after everything finished, and did not render at all on a cold start with no tasks). With no tasks it shows
   "No tasks"; while running it refreshes percent and speed live (every TaskCenterService.Report triggers a refresh).
   Colors: normally black; while downloading the whole pill turns gray and the black fill layer sweeps back over
   it from left to right following the download progress.
   v1.07: when everything is done the whole pill morphs into a circle + white checkmark (same morphing as the
   gsap smooth-morph demo, driven by taskDockMorph via width/height/padding transitions); it morphs back to a
   pill when new tasks arrive, the download-state display unchanged.
   v0.2.2: permanently hidden when the Settings toggle "Show task manager floating window" is off, shown only
   while download tasks run; the dock is draggable (makeTaskDockDraggable; dragging more than 5px swallows the click). *@
@if (Cfg.Current.ShowTaskDock || Center.RunningCount > 0)
{
    <button class="jg-taskdock @(Center.RunningCount > 0 ? "running" : "") @(_done ? "done" : "")" @onclick="Go" @oncontextmenu="HideFromMenu" @oncontextmenu:preventDefault title="Download/install tasks (left-click to open task center, right-click to hide)">
    @if (Center.RunningCount > 0)
    {
        <div class="jg-taskdock-fill" style="@($"width:{Center.TotalPercent:0}%")"></div>
    }
    <div class="jg-taskdock-body">
        <div class="jg-taskdock-title">@(Center.RunningCount > 0
            ? $"{Center.RunningCount} tasks running"
            : Center.RunningCount == 0 && Center.Items.Count > 0 ? "" : Center.Items.Count > 0 ? "All done" : "No tasks")</div>
        @if (Center.RunningCount > 0)
        {
            <div class="jg-taskdock-sub">@Center.TotalPercent.ToString("F0")% · @Center.TotalSpeedMBps.ToString("F1") M/s</div>
        }
    </div>
    <svg class="jg-taskdock-check" viewBox="0 0 1024 1024" aria-hidden="true">
        <path d="M392.533333 806.4L85.333333 503.466667l59.733334-59.733334 247.466666 247.466667L866.133333 213.333333l59.733334 59.733334L392.533333 806.4z" fill="#ffffff"></path>
        </svg>
    </button>
}

@code {
    private bool _done;          // whether the previous render was in the "all-done circle" state; drives the morph
    private bool _morphReady;    // no animation before the first render

    protected override void OnInitialized()
    {
        Center.OnChanged += Refresh;
        ConfigService.Saved += Refresh;   // show/hide instantly when the Settings page toggles "Show task manager floating window"
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Cursor perspective tilt (same as the gsap cursor-driven-perspective-tilt demo), bound once
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("junigridJs.taskDockTilt", ".jg-taskdock"); } catch { }
        }
        // Drag binding: the element can be rebuilt by show/hide toggles (the binding function guards against double-binding), so rebind after every render
        try { await JS.InvokeVoidAsync("junigridJs.makeTaskDockDraggable", ".jg-taskdock"); } catch { }

        // Pill ↔ circle morph (same as gsap smooth-morph): state flips are transitioned by a gsap timeline;
        // the first placement snaps to the state instantly, without animation
        var done = Center.RunningCount == 0 && Center.Items.Count > 0;
        if (!_morphReady)
        {
            _morphReady = true;
            _done = done;
            if (done)
            {
                try { await JS.InvokeVoidAsync("junigridJs.taskDockMorph", ".jg-taskdock", true, false); } catch { }
            }
        }
        else if (done != _done)
        {
            _done = done;
            try { await JS.InvokeVoidAsync("junigridJs.taskDockMorph", ".jg-taskdock", done, true); } catch { }
        }
    }

    public void Dispose()
    {
        Center.OnChanged -= Refresh;
        ConfigService.Saved -= Refresh;
    }

    // OnChanged may fire from a background download thread; must InvokeAsync back to the UI thread
    private void Refresh() => InvokeAsync(StateHasChanged);

    // v1.06.6: the tasks page expand/collapse animation is gone — a click is a plain toggle;
    // clicking the dock while on the tasks page = history.back to the page you came from
    private void Go()
    {
        if (Nav.Uri.EndsWith("/tasks", StringComparison.OrdinalIgnoreCase))
        {
            _ = JS.InvokeVoidAsync("junigridJs.goBack");
            return;
        }
        Nav.NavigateTo("/tasks");
    }

    // v1.1.4: right-clicking the dock = hide + turn off the Settings toggle "Show task manager floating window" in sync (persisted).
    // Right-click does nothing while tasks run — the dock is kept visible by the running tasks anyway
    // (render condition ShowTaskDock || RunningCount>0), so turning the toggle off would not hide it and would only
    // add "clicked but nothing happened" confusion; better to not respond at all.
    private void HideFromMenu()
    {
        if (Center.RunningCount > 0) return;
        var cfg = Cfg.Current;
        cfg.ShowTaskDock = false;
        Cfg.Save(cfg);   // Saved event → this component's Refresh makes it disappear instantly; the Settings page subscription keeps the toggle UI in sync
    }
}
