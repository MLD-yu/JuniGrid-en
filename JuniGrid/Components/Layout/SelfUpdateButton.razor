@namespace JuniGrid.Components.Layout
@inject SelfUpdateService SelfUpdate
@inject IJSRuntime JS

@* Self-update button behavior (finalized in v1.0.18):
   — Not rendered at all when there is no update;
   — New version detected → the button appears (no auto-download):
        · Not downloaded                → hover bubble "New version vX.Y.Z available, click to download and install"
        · cache complete (downloaded)  → bubble "Click to install" + full ring; clicking re-opens the wizard directly
        · Downloading                → bubble spinner + "Downloading" (button ring tracks progress; resumable download)
        · Download failed              → bubble "Download failed, click to retry"
   — Mouse leaves → the bubble disappears instantly (no exit animation);
   — Click → starts downloading if not downloaded yet; when the download completes, the install wizard pops up automatically and this app exits (v1.0.14 behavior restored);
   — If the user closes the wizard directly → the cache is kept; the next launch/click shows "Click to install" again;
   — After a successful install, the next launch automatically clears cached installers with version ≤ current. *@

@if (_selfUpdate is not null)
{
    <div class="jg-upd-wrap" @ref="_wrap">
        <button class="jg-upd-btn @(_downloading ? "jg-upd-running" : "")" @onclick="OnUpdateClick"
                aria-label="@TipText">
            @* Ring, green disc and arrow are drawn in the same SVG coordinate system — always centered, no reliance on CSS absolute positioning *@
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="2.2" />
                <circle class="jg-upd-ring-fill" cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                        stroke-dasharray="@RingCircumference.ToString("0.##")"
                        stroke-dashoffset="@RingOffset.ToString("0.##")" />
                <g class="jg-upd-icon">
                    <circle cx="12" cy="12" r="6.5" fill="#19943C" stroke="none" />
                    <path d="M12 8.2 L15.2 11.4 L13.2 11.4 L13.2 15.8 L10.8 15.8 L10.8 11.4 L8.8 11.4 Z" fill="#fff" stroke="none" />
                </g>
            </svg>
        </button>
        <div class="jg-upd-tip" @ref="_bubble" role="tooltip">
            @if (_downloading)
            {
                <span class="jg-upd-tip-spin" aria-hidden="true"></span>
                <span>Downloading@(_progressPercent is > 0 ? $" {_progressPercent:0}%" : "")</span>
            }
            else if (_ready)
            {
                <span>Click to install</span>
            }
            else if (_failed)
            {
                <span>Download failed, click to retry</span>
            }
            else
            {
                <span>@TipText</span>
            }
        </div>
    </div>
}

@code {
    private SelfUpdateInfo? _selfUpdate;
    private bool _downloading;          // downloading in the background
    private bool _ready;                // installer is cached; clicking pops the wizard
    private bool _failed;               // download failed (click to retry; resumable)
    private double? _progressPercent;
    private ElementReference _wrap;
    private ElementReference _bubble;

    // Ring geometry: r=10.5 in the 24x24 viewBox; the fill arc starts at the 12 o'clock position (CSS rotate),
    // and closes into a full circle exactly when the download reaches 100%.
    private const double RingCircumference = 2 * Math.PI * 10.5;
    private double RingOffset => _downloading && _progressPercent is > 0
        ? RingCircumference * (1 - Math.Min(1, _progressPercent.Value / 100))
        : _ready ? 0              // cache ready = full ring
        : RingCircumference;      // fully offset = no arc shown

    private string TipText => _downloading ? "Downloading"
        : _ready ? "Click to install"
        : _failed ? "Download failed, click to retry"
        : $"New version v{_selfUpdate?.LatestVersion} available, click to download and install";

    /// <summary>Silent check (runs after about 1 second); if an update exists → the button appears. No auto-download, no auto-install.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bind the hover bubble once the button appears (the JS side keeps __updTipBound to prevent double binding; rebinds automatically if Blazor rebuilds the wrap)
        if (_selfUpdate is not null)
        {
            try { await JS.InvokeVoidAsync("junigridJs.updTipInit", _wrap, _bubble); } catch { }
        }
        if (!firstRender) return;
        _ = Task.Run(async () =>
        {
            await Task.Delay(1000);
            await CheckForSelfUpdateAsync();
        });
    }

    private async Task CheckForSelfUpdateAsync()
    {
        var info = await SelfUpdate.CheckAsync();
        if (info is not { HasUpdate: true }) return;   // already up to date / offline / rate-limited: keep the button hidden
        // v1.0.18: adopt the cache at startup — if it was previously downloaded and complete (.done marker present), skip "click to download" and go straight to "click to install"
        var cached = SelfUpdate.CachedInstallerPath(info);
        await InvokeAsync(() =>
        {
            _selfUpdate = info;
            _ready = cached is not null;
            StateHasChanged();
        });
    }

    /// <summary>Click "download": if the cache is complete, go straight to ready; otherwise resume the download into the cache directory.</summary>
    private async Task EnsureDownloadAsync()
    {
        var info = _selfUpdate;
        if (info is null || _downloading || _ready) return;
        if (SelfUpdate.CachedInstallerPath(info) is not null)
        {
            _ready = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        _downloading = true;
        _failed = false;
        _progressPercent = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var path = await SelfUpdate.EnsureInstallerAsync(info,
                (msg, pct) => InvokeAsync(() =>
                {
                    _progressPercent = pct;
                    StateHasChanged();
                }));
            _downloading = false;
            _ready = true;
            await InvokeAsync(StateHasChanged);
            // v1.0.18: when the download completes, pop up the install wizard automatically and exit this app (v1.0.14 behavior restored);
            // closing the wizard doesn't affect the cache; the next launch/click shows "Click to install" again
            LaunchInstallerAndExit(path);
        }
        catch (Exception ex)
        {
            // Download failed: the bubble prompts to retry (the downloaded part is kept; click to resume)
            _downloading = false;
            _failed = true;
            AppLog.Warn("SelfUpdate", $"Installer download failed: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnUpdateClick()
    {
        if (_selfUpdate is null || _downloading) return;   // clicks while downloading are ignored (see the hover bubble for status)
        // already cached → pop the install wizard directly; no harm if the wizard is closed — the cache remains and the next click reopens it
        var path = SelfUpdate.CachedInstallerPath(_selfUpdate);
        if (path is null)
        {
            _ = EnsureDownloadAsync();   // not downloaded → clicking starts the download
            return;
        }
        LaunchInstallerAndExit(path);
    }

    /// <summary>
    /// v1.0.14: pop up the install wizard and exit this app.
    /// Key change: the installer is no longer launched directly by this process (v1.0.12's 800ms delay had a race —
    /// when the wizard started extracting, the old app might not have exited yet, and Inno replacing an in-use DLL would wait forever,
    /// showing an "install progress bar stuck, whole screen unclickable" symptom). Switched to detached launch: a separate process waits
    /// for this process to fully exit before starting the installer; this process begins its normal exit immediately, with a watchdog —
    /// if Shutdown hangs on a WebView2 release deadlock, Environment.Exit forcibly releases the file locks.
    /// </summary>
    private void LaunchInstallerAndExit(string path)
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo("powershell.exe",
                $"-NoProfile -WindowStyle Hidden -Command \"Wait-Process -Id {Environment.ProcessId} -Timeout 15 -ErrorAction SilentlyContinue; Start-Process -FilePath '{path}'\"")
            { CreateNoWindow = true, UseShellExecute = false };
            System.Diagnostics.Process.Start(psi);
        }
        catch
        {
            SelfUpdate.LaunchInstaller(path);   // fallback: if detaching fails, launch directly
        }

        _ = Task.Run(async () =>
        {
            await Task.Delay(500);
            try { System.Windows.Application.Current?.Dispatcher.Invoke(() => System.Windows.Application.Current.Shutdown()); } catch { }
            await Task.Delay(3500);
            Environment.Exit(0);   // watchdog: force-exit if the normal exit hangs, making sure file locks get released
        });
    }
}
