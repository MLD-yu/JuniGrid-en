@namespace JuniGrid.Components.Layout

<aside class="jg-sidenav">
    @foreach (var item in Items)
    {
        <NavLink class="jg-navitem" ActiveClass="active" Match="@item.Match" href="@item.Href">
            <span>@item.Icon</span>
            <span>@item.Label</span>
        </NavLink>
    }
</aside>

@code {
    private record NavItem(string Href, string Label, string Icon, NavLinkMatch Match);

    private readonly NavItem[] Items =
    {
        new("",        "Home",      "🏠", NavLinkMatch.All),
        new("mods",    "Mods",      "📦", NavLinkMatch.Prefix),
        new("shaders", "Shader Presets", "✨", NavLinkMatch.Prefix),
        new("nexus",   "Nexus",     "🌐", NavLinkMatch.Prefix),
        new("logs",    "Log",       "📋", NavLinkMatch.Prefix),
        new("settings","Settings",  "⚙️", NavLinkMatch.Prefix),
    };
}
