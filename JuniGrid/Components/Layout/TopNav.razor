@namespace JuniGrid.Components.Layout
@inject NavigationManager Nav
@inject PageRefreshService PageRefresh
@inject IJSRuntime JS
@inject ConfigService Cfg
@implements IDisposable

<nav class="jg-topnav">
    @* Selection highlight block: pale green background extending down into the content area, like a piece of it peeking out; left/width are slid to the active item by JS *@
    <div class="jg-topnav-thumb"></div>
    @foreach (var item in Items)
    {
        @* v0.24.0: icon-only navigation + hover pill tooltips.
           data-tip feeds the CSS ::after bubble; no text span is rendered anymore.
           (v1.0.17: update notices were consolidated into the title bar's self-update button bubble;
             the red-dot badge on the settings icon was a leftover from the settings-page update era and has been removed) *@
        <NavLink class="jg-topnav-item" ActiveClass="active" Match="@item.Match" href="@item.Href"
                 data-tip="@item.Label" aria-label="@item.Label"
                 @onclick="() => OnIconClick(item)">
            @* v1.1.2: light/dark dual icons — dark theme swaps in the -on-dark bright variants (the
               dark-gray fills of home/mods/settings are invisible on dark; nexus/smapi are colorful, both states share one image) *@
            <img class="jg-topnav-icon jg-topnav-icon-light" src="@item.Icon" alt="" draggable="false" />
            <img class="jg-topnav-icon jg-topnav-icon-dark" src="@(item.DarkIcon ?? item.Icon)" alt="" draggable="false" />
        </NavLink>
    }
</nav>

@code {
    private record NavItem(string Href, string Label, string Icon, NavLinkMatch Match, string? DarkIcon = null);

    private readonly NavItem[] Items =
    {
        new("",         "Home",       "assets/nav/home.svg",     NavLinkMatch.All,   "assets/nav/home-on-dark.svg"),
        new("mods",     "Mods",   "assets/nav/mods.svg",     NavLinkMatch.Prefix, "assets/nav/mods-on-dark.svg"),
        new("nexus",    "NEXUS MODS", "assets/nav/nexus.svg",    NavLinkMatch.Prefix),
        new("logs",     "SMAPI Logs", "assets/nav/smapi.svg",    NavLinkMatch.Prefix),
        new("settings", "Settings",   "assets/nav/settings.svg", NavLinkMatch.Prefix, "assets/nav/settings-on-dark.svg"),
    };

    protected override void OnInitialized()
    {
        // v0.35.0: reposition the thumb immediately after route changes (when .active moves), preventing "element moves first, background arrives later"
        // v1.1.6: switched to a named method with IDisposable unsubscription — an anonymous lambda can never be removed
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try { await InvokeAsync(StateHasChanged); } catch { }
        try { await JS.InvokeVoidAsync("junigridJs.placeNavThumb"); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Reposition after every render (double rAF internally waits for .active to settle); also covers the Mod force-refresh jump
        try { await JS.InvokeVoidAsync("junigridJs.placeNavThumb"); } catch { }
    }

    // v1.06.7: only clicking the icon of the page you're already on (mods/nexus) sends a refresh signal,
    // and the page re-scans/re-fetches/re-checks updates on subscription; clicking from another page = normal navigation (component rebuild loads naturally,
    // no extra requests). The old forceLoad:true full-page reload is retired.
    private void OnIconClick(NavItem item)
    {
        if (item.Href is not ("mods" or "nexus")) return;
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (path.EndsWith(item.Href, StringComparison.OrdinalIgnoreCase))
            PageRefresh.Request(item.Href);
    }
}
