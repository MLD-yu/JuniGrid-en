@namespace JuniGrid.Components.Layout
@inject ConfigService Cfg
@inject GameService Game
@inject LauncherService Launcher
@inject SteamService Steam
@inject UpdateService Updater
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<aside class="jg-account">
    <div class="jg-mode-pills @(_cfg.LaunchMode)">
        <span class="jg-pill-thumb"></span>
        <button class="jg-pill @(_cfg.LaunchMode == "steam" ? "active" : "")"
                disabled="@(_busy || _isRunning)" @onclick='() => SetMode("steam")'>
            <img src="assets/steam.svg" alt="Steam" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;" />
            Official
        </button>
        <button class="jg-pill @(_cfg.LaunchMode == "smapi" ? "active" : "")"
                disabled="@(_busy || _isRunning)" @onclick='() => SetMode("smapi")'>
            <img src="assets/smapi-pufferchick.svg" alt="SMAPI" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;border-radius:4px;" />
            SMAPI
        </button>
    </div>

    <div class="jg-account-mid">
        <div class="jg-avatar-wrap">
            @if (_profile.Found && _profile.AvatarDataUri is not null)
            {
                <img class="jg-avatar" src="@_profile.AvatarDataUri" alt="Steam avatar" />
            }
            else
            {
                <div class="jg-avatar jg-avatar-fallback">@AvatarInitial</div>
            }
            @if (_isRunning)
            {
                <span class="jg-avatar-dot" title="Game running"></span>
            }
        </div>

        <div class="jg-account-name">@AccountLabel</div>
        <div class="jg-account-sub">
            @(_cfg.LaunchMode == "steam" ? "Official (no mods)" : "SMAPI (with mods)")
        </div>
    </div>

    <div class="jg-launch-row @(_isRunning ? "running" : "")">
    <button id="launch-btn"
            class="jg-launch-big"
            disabled="@_launching"
            @onclick="OnButtonClick">
        <span class="jg-launch-main">@MainButtonLabel</span>
        @if (!_isRunning && !_launching)
        {
            <span class="jg-launch-ver">
                Game version: @(_gameVersion ?? "Not found")
                @if (_gameHasUpdate && _gameLatest is not null)
                {
                    <span class="jg-upd-arrow">→ @_gameLatest</span>
                }
            </span>
        }
    </button>

    <button class="jg-close-btn" data-tip="Close game" @onclick="OnButtonClick">
        ✕
    </button>
</div>
</aside>

@if (@_showConfirm)
{
    <div class="jg-dlg-overlay" @onclick="DismissConfirm">
        <div class="jg-dialog" @onclick:stopPropagation>
            <div class="jg-dialog-body">Closing the game may lose unsaved progress.<br />Are you sure you want to close it?</div>
            <div class="jg-dialog-actions">
                <button type="button" class="jg-pill-ghost" @onclick="DismissConfirm">Cancel</button>
                <button type="button" class="jg-pill-danger" @onclick="KillGame">Close game</button>
            </div>
        </div>
    </div>
}

@code {

    private JuniGridConfig _cfg = new();
    private SteamProfile _profile = SteamProfile.None;
    private string? _smapiVersion;
    private string? _gameVersion;
    private string? _gameLatest;
    private bool _gameHasUpdate;
    private SmapiUpdateInfo? _update;
    private bool _launching;
    private bool _isRunning;
    private bool _showConfirm;
    private readonly CancellationTokenSource _cts = new();

    private bool _busy => _launching;

    private string AccountLabel =>
        _profile.Found
            ? (_profile.PersonaName ?? _profile.AccountName ?? "Steam user")
            : "No Steam account detected";

    private string AvatarInitial =>
        AccountLabel.Length > 0 ? AccountLabel[..1].ToUpperInvariant() : "?";

    private string MainButtonLabel =>
        _launching ? "Launching…" :
        _isRunning ? "Running…" :
        _gameHasUpdate ? "⬆ Update game" :
        "▶ Launch game";

    protected override void OnInitialized()
    {
        _cfg = Cfg.Current;

        if (string.IsNullOrWhiteSpace(_cfg.GamePath))
        {
            var detected = Game.DetectGamePath();
            if (!string.IsNullOrEmpty(detected))
            {
                _cfg.GamePath = detected;
                Cfg.Save(_cfg);
            }
        }

        _profile = Steam.GetProfile();
        ProbeVersions();
        _ = CheckGameVersionAsync();
        Launcher.OnLogLine += HandleLogLine;
    }

    protected override async Task OnInitializedAsync()
    {
        _update = await Updater.CheckSmapiAsync(_smapiVersion);
        StateHasChanged();

        // Poll the real game process so the "Close game" button works for both SMAPI and official Steam modes
        _ = PollRunningAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        Launcher.OnLogLine -= HandleLogLine;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Launch button: cursor-driven 3D perspective tilt (GSAP quickTo)
            try { await JS.InvokeVoidAsync("junigridJs.tiltPerspective", "#launch-btn"); } catch { }
            // Launch button: hover pixel-dissolve into "Click to launch!" (PixelSwap)
            try { await JS.InvokeVoidAsync("junigridJs.launchHover", "#launch-btn"); } catch { }
        }
    }

    private void HandleLogLine(string line)
    {
        if (line.StartsWith("[JuniGrid] Game process exited"))
        {
            InvokeAsync(() =>
            {
                _isRunning = false;
                StateHasChanged();
            });
        }
    }

    private void ProbeVersions()
    {
        _smapiVersion = Game.ProbeSmapiVersion(_cfg.GamePath);
        _gameVersion = Updater.GetGameVersion(_cfg.GamePath);
    }

    // Check the latest base-game version once on every JuniGrid start; show it in the launch button when an update exists
    private async Task CheckGameVersionAsync()
    {
        var latest = await Updater.GetLatestGameVersionAsync();
        if (string.IsNullOrWhiteSpace(latest)) { _gameLatest = null; _gameHasUpdate = false; return; }
        _gameLatest = latest;
        // Version comparison: local 1.6.15 vs remote 1.6.16; if local can't be parsed, treat as unknown and don't false-positive
        _gameHasUpdate = false;
        if (!string.IsNullOrWhiteSpace(_gameVersion)
            && Version.TryParse(_gameVersion, out var local)
            && Version.TryParse(latest, out var remote))
        {
            _gameHasUpdate = remote > local;
        }

        StateHasChanged();
    }

    private void SetMode(string mode)
    {
        _cfg.LaunchMode = mode;
        Cfg.Save(_cfg);
    }

    private async Task Launch()
    {
        _launching = true;
        StateHasChanged();
        // Immediately clear any leftover pixel-dissolve mask and tilt transform on the button so it can't cover "Launching…"
        try { await JS.InvokeVoidAsync("junigridJs.clearLaunchFx", "#launch-btn"); } catch { }

        try { await JS.InvokeVoidAsync("junigridJs.popAnimate", "#launch-btn"); } catch { }

        Steam.Refresh();
            _profile = Steam.GetProfile();
            StateHasChanged();

            LaunchResult result = _cfg.LaunchMode == "steam"
            ? Launcher.LaunchSteam(_cfg.SteamAppId)
            : Launcher.LaunchSmapi(_cfg.GamePath);

        if (result.Success)
        {
            _cfg.LastLaunchTime = DateTime.Now.ToString("o");
            _cfg.LastLaunchMode = _cfg.LaunchMode;
            _cfg.TotalLaunchCount++;
            Cfg.Save(_cfg);

            if (_cfg.LaunchMode == "smapi")
            {
                // Like PCL: after SMAPI launches, switch to the log page automatically to watch the output (running state is handled by process polling)
                Nav.NavigateTo("/logs");
            }

            // Launch succeeded but the process may still be being spawned by Steam/the runtime:
            // keep showing "Launching…" until IsGameRunning is truly true (or timeout), avoiding a bounce back to "▶ Launch game".
            _ = WaitForRunningAsync();
        }
        else
        {
            // Launch failed → toast "Launch failed" and make the button clickable again
            ShowToast("Launch failed");
            _launching = false;
            StateHasChanged();
        }
    }

    // Wait for the game to truly enter the running state: the button keeps showing "Launching…"; on timeout (e.g. Steam didn't spawn it) fall back to "▶ Launch game"
    private async Task WaitForRunningAsync(int timeoutMs = 90_000)
    {
        var deadline = Environment.TickCount64 + timeoutMs;
        while (!_cts.IsCancellationRequested)
        {
            if (Launcher.IsGameRunning)
            {
                // Truly running: settle into the "Running" state so "Launching…" ends
                _launching = false;
                _isRunning = true;
                StateHasChanged();
                return;
            }
            if (Environment.TickCount64 >= deadline)
            {
                _launching = false;
                StateHasChanged();
                return;
            }
            await Task.Delay(500, _cts.Token);
        }
    }

    // Single entry point for the main button: running → confirm dialog to close the game; update available → update; otherwise launch
    private void OnButtonClick()
    {
        if (_launching) return;
        if (_isRunning)
        {
            _showConfirm = true;
            return;
        }
        if (_gameHasUpdate)
        {
            OpenUpdatePage();
            return;
        }
        _ = Launch();
    }

    // New version available → open the Steam store page so the user can click Update (don't launch the game directly, or the old version would start)
    private void OpenUpdatePage()
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                UseShellExecute = true,
                FileName = "steam://store/413150"
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception)
        {
            ShowToast("Launch failed");
        }
    }

    // Cancel close / clicking the overlay → dismiss the confirm dialog, do nothing
    private void DismissConfirm()
    {
        _showConfirm = false;
    }

    // Confirm close game: dismiss the dialog first, then actually end the process
    private void KillGame()
    {
        _showConfirm = false;
        Launcher.KillGame();
    }

    // Poll the real game process so the "Close game" button works for both SMAPI and official Steam modes
    private async Task PollRunningAsync()
    {
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                var r = Launcher.IsGameRunning;
                if (r != _isRunning)
                {
                    _isRunning = r;
                    await InvokeAsync(StateHasChanged);
                }
                await Task.Delay(1500, _cts.Token);
            }
        }
        catch (OperationCanceledException) { }
    }


    private void ShowToast(string text)
    {
        // v0.43.1: errors → red-background white-text toast, also written to the log
        AppLog.Error("AccountPanel", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, "err");
    }
}
