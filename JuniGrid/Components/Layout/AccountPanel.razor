@namespace JuniGrid.Components.Layout
@inject ConfigService Cfg
@inject GameService Game
@inject LauncherService Launcher
@inject SteamService Steam
@inject UpdateService Updater
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<aside class="jg-account">
    <div class="jg-mode-row">
        <div class="jg-mode-pills @(_cfg.LaunchMode)">
            <span class="jg-pill-thumb"></span>
            <button class="jg-pill @(_cfg.LaunchMode == "steam" ? "active" : "")"
                    disabled="@(_busy || _isRunning)" @onclick='() => SetMode("steam")'>
                <img src="assets/steam.svg" alt="Steam" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;" />
                Official
            </button>
            <button class="jg-pill @(_cfg.LaunchMode == "smapi" ? "active" : "")"
                    disabled="@(_busy || _isRunning)" @onclick='() => SetMode("smapi")'>
                <img src="assets/smapi-pufferchick.svg" alt="SMAPI" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;border-radius:4px;" />
                SMAPI
            </button>
        </div>
    </div>

    <div class="jg-account-mid">
        <div class="jg-avatar-wrap">
            @if (_profile.Found && _profile.AvatarDataUri is not null)
            {
                <img class="jg-avatar" src="@_profile.AvatarDataUri" alt="Steam avatar" />
            }
            else
            {
                @* Steam not detected (or avatar unavailable) → fall back to the built-in Steam round logo instead of an initial-letter block *@
                <img class="jg-avatar" src="assets/steam.svg" alt="Steam" />
            }
            @if (_isRunning)
            {
                <span class="jg-avatar-dot" title="Game running"></span>
            }
        </div>

        <div class="jg-account-name">@AccountLabel</div>
        <div class="jg-account-sub">
            @(_cfg.LaunchMode == "steam" ? "Official (no mods)" : "SMAPI (with mods)")
        </div>
    </div>

    <div class="jg-launch-row @(_isRunning ? "running" : (_launching ? "launching" : ""))">
    <button id="launch-btn"
            class="jg-launch-big"
            disabled="@_launching"
            @onclick="OnButtonClick">
        <span class="jg-launch-main">@MainButtonLabel</span>
        @if (!_isRunning && !_launching)
        {
            <span class="jg-launch-ver">
                Current game version: @(_gameVersion ?? "Not detected")
                @if (_gameHasUpdate && _gameLatest is not null)
                {
                    <span class="jg-upd-arrow">→ @_gameLatest</span>
                }
            </span>
        }
    </button>

    <button class="jg-close-btn" data-tip="@(_launching ? "Cancel launch" : "Close game")" @onclick="OnButtonClick">
        ✕
    </button>
</div>
</aside>

@if (@_showConfirm)
{
    <div class="jg-dlg-overlay" @onclick="DismissConfirm">
        <div class="jg-dialog" @onclick:stopPropagation>
            <div class="jg-dialog-body">Closing the game may cause unsaved progress to be lost.<br />Are you sure you want to close the game?</div>
            <div class="jg-dialog-actions">
                <button type="button" class="jg-pill-ghost" @onclick="DismissConfirm">Cancel</button>
                <button type="button" class="jg-pill-danger" @onclick="KillGame">Close game</button>
            </div>
        </div>
    </div>
}

@code {

    private JuniGridConfig _cfg = new();
    private SteamProfile _profile = SteamProfile.None;
    private string? _smapiVersion;
    private string? _gameVersion;
    private string? _gameLatest;
    private bool _gameHasUpdate;
    private SmapiUpdateInfo? _update;
    private bool _launching;
    private bool _isRunning;
    private bool _showConfirm;
    private readonly CancellationTokenSource _cts = new();

    private bool _busy => _launching;

    private string AccountLabel =>
        _profile.Found
            ? (_profile.PersonaName ?? _profile.AccountName ?? "Steam user")
            : "No Steam account detected";

    private string MainButtonLabel =>
        _launching ? "Launching..." :
        _isRunning ? "Running..." :
        _gameHasUpdate ? "⬆ Update game" :
        "▶ Launch game";

    protected override void OnInitialized()
    {
        _cfg = Cfg.Current;

        if (string.IsNullOrWhiteSpace(_cfg.GamePath))
        {
            var detected = Game.DetectGamePath();
            if (!string.IsNullOrEmpty(detected))
            {
                _cfg.GamePath = detected;
                Cfg.Save(_cfg);
            }
        }

        _profile = Steam.GetProfile();
        ProbeVersions();
        _ = CheckGameVersionAsync();
        Launcher.OnLogLine += HandleLogLine;
        ConfigService.Saved += HandleCfgSaved;
    }

    protected override async Task OnInitializedAsync()
    {
        _update = await Updater.CheckSmapiAsync(_smapiVersion);
        StateHasChanged();

        // Poll the real game process so the "Close game" button works for both SMAPI and official Steam modes
        _ = PollRunningAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        try { _cts.Dispose(); } catch { }   // v1.1.6: dispose after Cancel; the polling loop exits normally via OCE
        Launcher.OnLogLine -= HandleLogLine;
        ConfigService.Saved -= HandleCfgSaved;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Launch button: cursor-driven 3D perspective tilt (GSAP quickTo)
            // v1.1.2: the hover pixel-dissolve "Click to launch!" overlay was removed by request; only the mouse-follow tilt remains
            try { await JS.InvokeVoidAsync("junigridJs.tiltPerspective", "#launch-btn"); } catch { }
        }
    }

    private void HandleLogLine(string line)
    {
        if (line.StartsWith("[JuniGrid] Game process exited"))
        {
            InvokeAsync(() =>
            {
                _isRunning = false;
                StateHasChanged();
            });
        }
    }

    private string? _probedGamePath;   // Directory used by the last version probe (the config is a shared mutable object that _cfg follows, so it can't tell whether the directory changed)

    private void ProbeVersions()
    {
        _smapiVersion = Game.ProbeSmapiVersion(_cfg.GamePath);
        _gameVersion = Updater.GetGameVersion(_cfg.GamePath);
        _probedGamePath = _cfg.GamePath;
    }

    // v1.1.2: re-probe versions right after the game directory is saved on the Settings page — AccountPanel lives in MainLayout and is never rebuilt,
    // so previously the launch button kept saying "Not detected" until the app restarted. Saved may fire on a background thread → InvokeAsync back to the UI (same as TaskDock.Refresh).
    private void HandleCfgSaved()
    {
        // Skip saves where the directory didn't change (frequent writes like theme/notes/fingerprint) — don't probe files needlessly
        if (string.Equals(Cfg.Current.GamePath, _probedGamePath, StringComparison.OrdinalIgnoreCase)) return;
        InvokeAsync(() =>
        {
            _cfg = Cfg.Current;
            ProbeVersions();
            RecomputeGameHasUpdate();
            StateHasChanged();
        });
    }

    // Version comparison: local 1.6.15 vs remote 1.6.16; if the local version can't be parsed, treat it as unknown and don't report a false update
    private void RecomputeGameHasUpdate()
    {
        _gameHasUpdate = false;
        if (_gameLatest is not null
            && !string.IsNullOrWhiteSpace(_gameVersion)
            && Version.TryParse(_gameVersion, out var local)
            && Version.TryParse(_gameLatest, out var remote))
        {
            _gameHasUpdate = remote > local;
        }
    }

    // On every JuniGrid start, check the latest vanilla game version once; if there's an update, show it in the launch button
    private async Task CheckGameVersionAsync()
    {
        var latest = await Updater.GetLatestGameVersionAsync();
        if (string.IsNullOrWhiteSpace(latest)) { _gameLatest = null; _gameHasUpdate = false; return; }
        _gameLatest = latest;
        RecomputeGameHasUpdate();

        StateHasChanged();
    }

    private void SetMode(string mode)
    {
        _cfg.LaunchMode = mode;
        Cfg.Save(_cfg);
    }

    private async Task Launch()
    {
        _launching = true;
        _launchCancelled = false;   // v1.1.2c: clear the previous run's cancel flag
        StateHasChanged();
        // Immediately clear any leftover pixel-dissolve mask and tilt transform on the button so it doesn't cover "Launching..."
        try { await JS.InvokeVoidAsync("junigridJs.clearLaunchFx", "#launch-btn"); } catch { }

        try { await JS.InvokeVoidAsync("junigridJs.popAnimate", "#launch-btn"); } catch { }

        try
        {
            Steam.Refresh();
            _profile = Steam.GetProfile();
            StateHasChanged();

            LaunchResult result = _cfg.LaunchMode == "steam"
                ? Launcher.LaunchSteam(_cfg.SteamAppId)
                : Launcher.LaunchSmapi(_cfg.GamePath);

            if (result.Success)
            {
                _cfg.LastLaunchTime = DateTime.Now.ToString("o");
                _cfg.LastLaunchMode = _cfg.LaunchMode;
                _cfg.TotalLaunchCount++;
                Cfg.Save(_cfg);

                if (_cfg.LaunchMode == "smapi")
                {
                    // Like PCL: after SMAPI launches, switch to the logs page automatically to watch the output (running state is taken over by process polling)
                    Nav.NavigateTo("/logs");
                }

                // Launch succeeded but the process may still be being spawned by Steam/the runtime:
                // keep "Launching..." until IsGameRunning is actually true (or times out) instead of snapping back to "▶ Launch game".
                _ = WaitForRunningAsync();
            }
            else
            {
                // Launch failed → toast "Launch failed" and make the button clickable again
                ShowToast("Launch failed");
                _launching = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // v1.1.2: catch-all around Launch — previously any exception thrown after _launching=true
            // (saving/navigation/JS calls etc.) left the button stuck on "Launching..." with no message
            AppLog.Error("AccountPanel", "Launch error: " + ex.Message);
            ShowToast("Launch error: " + ex.Message);
            _launching = false;
            StateHasChanged();
        }
    }

    // Wait for the game to actually reach the running state: the button keeps showing "Launching...";
    // on timeout/Steam exit it falls back to "▶ Launch game".
    // v1.1.2c: every exit path (timeout/cancel/Steam exit/exception) guarantees _launching is reset,
    // so the button can never get stuck on "Launching..." forever.
    // v1.1.2c: mid-launch cancel during the launch wait — abort the wait and close the game process (if it was spawned).
    private volatile bool _launchCancelled;
    private volatile bool _cancelWatchdog;   // cancel-cleanup watchdog running: while active, polling won't flip the button to "Running..."

    private void CancelLaunch()
    {
        if (!_launching) return;
        _launchCancelled = true;
        ShowToast("Launch cancelled");
        _launching = false;    // WaitForRunningAsync's finally also resets it as a fallback
        StateHasChanged();
        // Steam's spawn pipeline may bring up the game process only after the cancel (family sharing checks take a few seconds),
        // so a one-shot KillGame would miss it → use a watchdog to keep cleaning up for 20s; it yields automatically if launch is clicked again
        _cancelWatchdog = true;
        _ = Launcher.KillGameWatchdogAsync(20000, stopWhen: () => _launching || !_launchCancelled)
                .ContinueWith(_ => _cancelWatchdog = false);
    }

    private async Task WaitForRunningAsync(int timeoutMs = 45_000)
    {
        var deadline = Environment.TickCount64 + timeoutMs;
        var hinted = false;
        var steamGoneChecks = 0;
        var steamSeen = false;
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                // User clicked ✕ to cancel → return immediately (cleanup is handled by KillGameWatchdogAsync)
                if (_launchCancelled) return;
                if (Launcher.IsGameRunning)
                {
                    // Actually reached the running state: settle on "Running" and let "Launching" exit
                    _launching = false;
                    _isRunning = true;
                    StateHasChanged();
                    return;
                }
                // In official Steam mode, no game process after 25 seconds → most likely Steam is waiting for the user
                // to handle a popup (family sharing "borrow this game" confirmation/login/update), or the current account doesn't own this game —
                // previously it just waited silently, with no hint that Steam was waiting for a click
                if (!hinted && _cfg.LaunchMode == "steam" && Environment.TickCount64 >= deadline - 20_000)
                {
                    hinted = true;
                    ShowToast("Game not started: check whether Steam has popped up a confirmation window.");
                }
                // Steam was closed → nothing can spawn the game anymore, cancel the wait immediately (previously it waited out the full
                // timeout, which felt like "closed Steam but the button is still Launching").
                // Launching Steam via the steam:// protocol takes a few seconds: only start checking for "disappearance" after Steam has been seen once;
                // if Steam never appears within 12s, treat that as a failed launch too.
                if (_cfg.LaunchMode == "steam")
                {
                    if (LauncherService.IsSteamRunning) steamSeen = true;
                    if (steamSeen && !LauncherService.IsSteamRunning)
                    {
                        if (++steamGoneChecks >= 8)   // require ~4s of continuous absence before deciding (guards against momentary flicker)
                        {
                            ShowToast("Steam exited; the launch wait was cancelled.");
                            return;
                        }
                    }
                    else steamGoneChecks = 0;
                    if (!steamSeen && Environment.TickCount64 >= deadline - 30_000)
                    {
                        ShowToast("Steam never started running; the launch wait was cancelled. Start Steam first and try again, or switch to SMAPI.");
                        return;
                    }
                }
                if (Environment.TickCount64 >= deadline)
                {
                    ShowToast("Timed out waiting: no game process detected");
                    return;
                }
                await Task.Delay(500, _cts.Token);
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _launching = false;
            StateHasChanged();
        }
    }

    // Single entry point for the main button: running → confirm dialog to close the game; update available → go update; otherwise launch
    private void OnButtonClick()
    {
        // v1.1.2c: clicking ✕ during the launch wait = mid-launch cancel — whether or not the game was spawned, abort the wait and
        // close the game process (same ✕ button as the "Running" state; behavior branches on state)
        if (_launching) { CancelLaunch(); return; }
        if (_isRunning)
        {
            _showConfirm = true;
            return;
        }
        if (_gameHasUpdate)
        {
            OpenUpdatePage();
            return;
        }
        _ = Launch();
    }

    // New version available → open the Steam game page so the user can click update (no longer launches the game directly, otherwise the old version would start)
    private void OpenUpdatePage()
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                UseShellExecute = true,
                FileName = "steam://store/413150"
            };
            System.Diagnostics.Process.Start(psi);
        }
        catch (Exception)
        {
            ShowToast("Launch failed");
        }
    }

    // Cancel button / overlay click → dismiss the confirm dialog without doing anything
    private void DismissConfirm()
    {
        _showConfirm = false;
    }

    // Confirm closing the game: dismiss the dialog first, then actually kill the process
    private void KillGame()
    {
        _showConfirm = false;
        Launcher.KillGame();
    }

    // Poll the real game process so the "Close game" button works in both SMAPI and official Steam modes
    private async Task PollRunningAsync()
    {
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                // While the cancel-cleanup watchdog is running, a game process spawned late by Steam doesn't count as "Running" (it gets killed right away)
                var r = !_cancelWatchdog && Launcher.IsGameRunning;
                if (r != _isRunning)
                {
                    _isRunning = r;
                    await InvokeAsync(StateHasChanged);
                }
                await Task.Delay(1500, _cts.Token);
            }
        }
        catch (OperationCanceledException) { }
    }


    private void ShowToast(string text)
    {
        // v0.43.1: errors → red toast with white text, also written to the log
        AppLog.Error("AccountPanel", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, "err");
    }
}
