@namespace JuniGrid.Components.Layout
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ConfigService Cfg
@implements IDisposable

<div class="jg-shell">
    <TitleBar />

    <div class="jg-body">
        <AccountPanel />

        <div class="jg-content">
            <TopNav />
            <main class="jg-main">
                @Body
            </main>
            @* ── v1.1.2: back to top (shown on Mods / Mod details / Nexus; appears after scrolling one screen) ──
               Click tweens scrollTop with GSAP for a smooth scroll back; placed on the left to avoid the task-center floating ball in the bottom-right ── *@
            <button id="jgBackTop" class="jg-backtop" data-tip="Back to top" aria-label="Back to top">
                <img src="assets/back-top.svg" alt="" draggable="false" />
            </button>
        </div>
    </div>
</div>
<TaskDock />

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocChanged;
    }

    private void OnLocChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Automatically collapse the built-in browser overlay when navigating away from Mods-related pages —
        // it is semantically the content area of the Mods page, so it must go when the route leaves.
        var rel = Nav.ToBaseRelativePath(e.Location).ToLowerInvariant().TrimEnd('/');
        var onModsPage = rel.StartsWith("mods") || rel.StartsWith("mod/");
        if (!onModsPage) JuniGrid.MainWindow.HideNexusOverlay();

        // v0.31.0: play the enter animation on <main.jg-main> on every page switch (PCL style)
        _ = InvokeAsync(async () =>
        {
            try { await JS.InvokeVoidAsync("junigridJs.playPageEnter"); } catch { }
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // v0.20.0: don't notify right after mount — the shell DOM exists but the CSS hasn't finished applying,
            // so an immediate WPF fade-in would show the dark fallback background. Let the JS side wait two rAF frames plus a short stabilize,
            // until the light theme is truly painted, before telling the WPF main window to fade in.
            // Guard: a failed call (script not ready) must not become an unobserved exception — the App side has its own 6s force-reveal fallback.
            try { await JS.InvokeVoidAsync("junigridJs.splashUiReadyWhenStable"); }
            catch { }
            // v0.31.0: also play the enter animation when first entering the home page
            try { await JS.InvokeVoidAsync("junigridJs.playPageEnter"); } catch { }
            // v1.1.2: back-to-top button (scroll listener + route show/hide + smooth scroll back on click)
            try { await JS.InvokeVoidAsync("junigridJs.backTopInit"); } catch { }
        }
    }
}
