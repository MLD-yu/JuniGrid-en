    /// <summary>Common dependency UniqueIDs -> friendly names. Missing, uninstalled dependencies have no local name; this table provides a readable one.</summary>
    private static string FriendlyDepName(string uniqueId)
    {
        if (string.IsNullOrWhiteSpace(uniqueId)) return uniqueId;
        // match case-insensitively; normalize to a lowercase first letter for lookup
        var key = uniqueId.Trim();
        if (_depNameMap.TryGetValue(key, out var name)) return name;
        // common pitfall: also try when the casing differs
        foreach (var (k, v) in _depNameMap)
            if (string.Equals(k, key, StringComparison.OrdinalIgnoreCase)) return v;
        return key;
    }

    private static readonly Dictionary<string, string> _depNameMap = new(StringComparer.OrdinalIgnoreCase)
    {
        // common SMAPI framework dependencies (these names are certain; used in place of the raw UniqueID when a dependency is missing)
        { "Pathoschild.ContentPatcher", "Content Patcher" },
        { "Pathoschild.LookupAnything", "Lookup Anything" },
        { "spacechase0.JsonAssets", "JsonAssets" },
        { "spacechase0.GenericModConfigMenu", "Generic Mod Config Menu (GMCM)" },
        { "spacechase0.SpaceCore", "SpaceCore" },
        { "PeacefulEnd.CustomCompanions", "Custom Companions" },
        { "Esca.FarmTypeManager", "Farm Type Manager (FTM)" },
        { "Cherry.ExpandedPreconditionsUtility", "Expanded Preconditions Utility (EPU)" },
        { "bcmpinc.StardewHack", "StardewHack" },
        { "bcmpinc.WearMoreRings", "Wear More Rings" },
        { "MuseumHeir.CJBCheatsMenu", "CJB Cheats Menu" },
        { "SMAPI", "SMAPI" },
    };

    /// <summary>A dependency (one entry of the expanded indirect dependency set).</summary>
    private sealed class ResolvedDep
    {
        public string UniqueID = "";
        public string Name = "";
        public string? Version;
        public int? NexusModId;
        public string? CoverUrl;
        public bool Installed;
        public bool Required = true;
    }

    /// <summary>
    /// BFS-expands the current mod's "transitive dependencies + CP hosts" (cycle-safe, deduplicated).
    /// Only "required" dependencies are collected; optional ones (already filtered out of Dependencies
    /// by the backend) do not participate in the recursion.
    /// </summary>
    private void ResolveDepTree()
    {
        _resolvedDeps.Clear();
        if (_thisEntry is null) return;

        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        // The same UniqueID may be installed multiple times (duplicate folders); strict ToDictionary would throw
        // on duplicate keys, so keep the first occurrence on conflict and let the BFS use it to locate installed dependencies as usual.
        var byUid = new Dictionary<string, ModEntry?>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _localMods)
            if (!string.IsNullOrWhiteSpace(m.UniqueID))
                byUid.TryAdd(m.UniqueID, m);

        // start from this mod's dependencies + CP hosts
        var queue = new Queue<string>();
        foreach (var d in _thisEntry.HasManifest ? _thisEntry.Dependencies : new List<string>())
            if (!string.IsNullOrWhiteSpace(d)) queue.Enqueue(d);
        foreach (var h in _thisEntry.ContentPackIds)
            if (!string.IsNullOrWhiteSpace(h)) queue.Enqueue(h);

        while (queue.Count > 0)
        {
            var uid = queue.Dequeue();
            if (!visited.Add(uid)) continue;

            var installed = byUid.TryGetValue(uid, out var depEntry) ? depEntry : null;
            var cover = installed is not null
                && Cfg.Current.ModCovers.TryGetValue(installed.Folder, out var cu) ? cu : null;

            _resolvedDeps.Add(new ResolvedDep
            {
                UniqueID = uid,
                Name = installed?.Name ?? FriendlyDepName(uid),
                Version = installed?.Version,
                NexusModId = installed?.NexusModId,
                CoverUrl = cover,
                Installed = installed is not null
            });

            // recurse into its dependencies (only installed ones can be expanded further)
            if (installed is not null)
            {
                foreach (var sub in installed.Dependencies.Concat(installed.ContentPackIds))
                    if (!string.IsNullOrWhiteSpace(sub)) queue.Enqueue(sub);
            }
        }
    }

    /// <summary>Dependency -> open its detail page. If a mod_id is available, go to the internal detail; only fall back to Nexus search when it is (=0).</summary>
    private void GoDep(int modId, string name)
    {
        if (modId > 0)
        {
            Nav.NavigateTo($"mod/{modId}");
            return;
        }
        if (!string.IsNullOrWhiteSpace(name))
            UpdateService.OpenUrl("https://www.nexusmods.com/stardewvalley/search/?gsearch="
                + Uri.EscapeDataString(name));
    }

    // v0.69.2: accordion toggling / opening external links
    private int _pendingAnimAcc;
    private bool _pendingAnimOpening;
    private void ToggleAcc(int n)
    {
        var opening = !_openAccs.Contains(n);
        if (opening) _openAccs.Add(n); else _openAccs.Remove(n);
        _pendingAnimAcc = n; _pendingAnimOpening = opening;   // GSAP plays in OnAfterRenderAsync after the DOM updates
    }
    private static void OpenExt(string url) => UpdateService.OpenUrl(url);

    /// <summary>Replaces hard-coded gray text colors in the detail rich text with inherit, so they stay readable in dark mode.</summary>
    private static string NormalizeGrayColors(string html)
    {
        if (string.IsNullOrEmpty(html)) return html ?? "";
        return Regex.Replace(html,
            @"(?i)color\s*:\s*(#(77|88|99|aa){2,3}\b|gray|grey|dimgray|darkgray|darkgrey|lightgray|lightgrey)",
            "color: inherit");
    }

    private static string FormatDownloads(long n) =>
        n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 1_000 ? $"{n / 1_000.0:0.#}K"
        : n.ToString();

    /// <summary>v1.04.0: file size formatting (the detail page's "size" stat; 0 renders as 0 B).</summary>
    private static string FormatBytes(long b) => b >= 1_048_576 ? (b / 1_048_576.0).ToString("0.#") + " MB"
        : b >= 1024 ? (b / 1024.0).ToString("0.#") + " KB" : b + " B";
}
