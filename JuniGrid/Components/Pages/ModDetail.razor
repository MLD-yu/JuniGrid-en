    /// <summary>Rewrite hard-coded gray text colors in the description rich text to the inherited color so they stay readable in dark mode.</summary>
    /// <summary>
    /// v1.1.1: description HTML readability normalization (white-background detail page) —
    /// 1) neutral gray text always becomes color:inherit (≈black). Authors use light gray for
    ///    de-emphasized emphasis, which is unreadable on white; near-white (#f7+) is treated as
    ///    white text on a dark block and kept.
    /// 2) colored text keeps its hue and gains a 0.5px black outline (-webkit-text-stroke) to
    ///    improve readability on the white background.
    /// The old regex only recognized #77~#aa prefix grays, so #efefef/#d8d8d8 all slipped through
    /// (e.g. the Weather Wonders weather names).
    /// </summary>
    private static string NormalizeGrayColors(string html)
    {
        if (string.IsNullOrEmpty(html)) return html ?? "";
        // (?<![a-z-]) avoids hitting background-color / border-color and similar properties
        return Regex.Replace(html,
            @"(?i)(?<![a-z-])(color\s*:\s*)(#[0-9a-f]{3,8}\b|rgba?\(\s*[\d.]+\s*,\s*[\d.]+\s*,\s*[\d.]+[^)]*\)|hsla?\(\s*[\d.]+\s*,\s*[\d.]+%\s*,\s*[\d.]+%[^)]*\)|[a-z]+)",
            m => NormalizeDescColor(m.Groups[1].Value, m.Groups[2].Value));
    }

    private static string NormalizeDescColor(string prefix, string value)
    {
        if (!TryParseDescColor(value, out var r, out var g, out var b))
            return prefix + value;   // unknown forms (var(--x), rare color names) kept as-is
        int max = Math.Max(r, Math.Max(g, b)), min = Math.Min(r, Math.Min(g, b));
        if (max - min <= 16)   // neutral gray
        {
            double lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
            if (lum >= 0.97) return prefix + value;   // near-white: most likely white text on a dark background
            return prefix + "inherit";
        }
        // colored: keep the original color + thin black outline
        return $"{prefix}{value}; -webkit-text-stroke: 0.5px #000";
    }

    private static bool TryParseDescColor(string s, out int r, out int g, out int b)
    {
        r = g = b = 0;
        s = s.Trim();
        try
        {
            if (s.StartsWith("#"))
            {
                var hex = s[1..];
                if (hex.Length is 3 or 4) hex = string.Concat(hex.Select(c => $"{c}{c}"))[..6];
                if (hex.Length != 6 && hex.Length != 8) return false;
                r = Convert.ToInt32(hex[..2], 16);
                g = Convert.ToInt32(hex.Substring(2, 2), 16);
                b = Convert.ToInt32(hex.Substring(4, 2), 16);
                return true;
            }
            if (s.StartsWith("rgb") || s.StartsWith("hsl"))
            {
                var nums = Regex.Matches(s, @"[\d.]+");
                if (s.StartsWith("rgb"))
                {
                    if (nums.Count < 3) return false;
                    r = (int)double.Parse(nums[0].Value, CultureInfo.InvariantCulture);
                    g = (int)double.Parse(nums[1].Value, CultureInfo.InvariantCulture);
                    b = (int)double.Parse(nums[2].Value, CultureInfo.InvariantCulture);
                    return true;
                }
                if (nums.Count < 3) return false;
                double h = double.Parse(nums[0].Value, CultureInfo.InvariantCulture) % 360;
                double sat = double.Parse(nums[1].Value, CultureInfo.InvariantCulture);
                double l = double.Parse(nums[2].Value, CultureInfo.InvariantCulture);
                if (sat <= 10) { r = g = b = (int)(l * 2.55); return true; }   // low saturation ≈ gray
                double c = (1 - Math.Abs(2 * l / 100 - 1)) * sat / 100;
                double x = c * (1 - Math.Abs(h / 60 % 2 - 1));
                double m2 = l / 100 - c / 2;
                // Note: can't use `h switch { < 60 => ... }` — Razor parses a relational pattern `< 60` at the start of a line as an HTML tag
                double rr, gg, bb;
                if (h < 60) { rr = c; gg = x; bb = 0.0; }
                else if (h < 120) { rr = x; gg = c; bb = 0.0; }
                else if (h < 180) { rr = 0.0; gg = c; bb = x; }
                else if (h < 240) { rr = 0.0; gg = x; bb = c; }
                else if (h < 300) { rr = x; gg = 0.0; bb = c; }
                else { rr = c; gg = 0.0; bb = x; }
                r = (int)((rr + m2) * 255); g = (int)((gg + m2) * 255); b = (int)((bb + m2) * 255);
                return true;
            }
            (int, int, int)? named = s.ToLowerInvariant() switch
            {
                "gray" or "grey" => (128, 128, 128),
                "dimgray" or "dimgrey" => (105, 105, 105),
                "darkgray" or "darkgrey" => (169, 169, 169),
                "lightgray" or "lightgrey" => (211, 211, 211),
                "gainsboro" => (220, 220, 220),
                "silver" => (192, 192, 192),
                "whitesmoke" => (245, 245, 245),
                "black" => (0, 0, 0),
                "white" => (255, 255, 255),
                "red" => (255, 0, 0),
                "green" => (0, 128, 0),
                "lime" => (0, 255, 0),
                "blue" => (0, 0, 255),
                "yellow" => (255, 255, 0),
                "orange" => (255, 165, 0),
                "purple" => (128, 0, 128),
                "pink" => (255, 192, 203),
                "brown" => (165, 42, 42),
                "cyan" or "aqua" => (0, 255, 255),
                "magenta" or "fuchsia" => (255, 0, 255),
                _ => null
            };
            if (named is null) return false;
            (r, g, b) = named.Value;
            return true;
        }
        catch { return false; }
    }

    private static string FormatDownloads(long n) =>
        n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 1_000 ? $"{n / 1_000.0:0.#}K"
        : n.ToString();

    /// <summary>v1.04.0: file size formatting (the "Size" stat on the detail page; 0 shows as 0 B).</summary>
    private static string FormatBytes(long b) => b >= 1_048_576 ? (b / 1_048_576.0).ToString("0.#") + " MB"
        : b >= 1024 ? (b / 1024.0).ToString("0.#") + " KB" : b + " B";
}
