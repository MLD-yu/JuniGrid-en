    private List<NexusModListEntry> _homeMods = new();

    private async Task LoadHomeAsync()
    {
        if (string.IsNullOrEmpty(_key)) { _homeLoading = false; return; }
        _homeLoading = true;
        StateHasChanged();
        try
        {
            // v0.96.0: Trending = released in the last 7 days, sorted by endorsements (mirrors ?sort=endorsements&timeRange=7).
            // Take 10 so both large cards and all 4 small cards can be filled (occasional server truncation
            // is compensated inside FetchChunkedAsync)
            // v0.79.0: Home Trending + Mods fetched in parallel (Task.WhenAll); first paint roughly twice as fast
            var tTask = NexusApi.BrowseModsAsync("trending", 0, 10, timeRange: "week");
            // v0.88.0: Exactly 20 entries (FetchChunkedAsync loops to top up if truncated)
            var mTask = NexusApi.BrowseModsAsync(_homeTab, 0, 20);
            await Task.WhenAll(tTask, mTask);
            var t = tTask.Result;
            if (t is not null) _trendingHome = t;
            // v0.75.0: The home Mods section shows 20 mods
            var m = mTask.Result;
            if (m is not null) _homeMods = m.Take(20).ToList();   // v0.84.0
        }
        catch { }
        finally { _homeLoading = false; StateHasChanged(); }
    }

    private async Task SetHomeTab(string key)
    {
        if (_homeTab == key || _homeLoading || string.IsNullOrEmpty(_key)) return;
        _homeTab = key;
        _homeLoading = true;
        StateHasChanged();
        try
        {
            // v1.04.0: All home tab chips (New/Updated/Downloads/Popular/Surprise) default to all time
            var m = await NexusApi.BrowseModsAsync(key, 0, 20, timeRange: "all");
            if (m is not null) _homeMods = m;
            // v1.06.8: Switching tab = new content → scroll back to top
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
        }
        catch { }
        finally { _homeLoading = false; StateHasChanged(); }
    }

