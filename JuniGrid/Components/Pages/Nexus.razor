        Cfg.Save(cfg);
    }

    private async Task LoadNexusUserAsync()
    {
        if (string.IsNullOrEmpty(_key))
        {
            _userName = ""; _userAvatar = ""; _isPremium = false; _profileUrl = null;
            return;
        }
        // Render fast from cached data first
        _userName = Cfg.Current.NexusUserName;
        _isPremium = Cfg.Current.NexusIsPremium;
        _profileUrl = Cfg.Current.NexusProfileUrl;
        // v1.08.3: Avatar cache first — the old logic started _userAvatar empty on every visit and needed two
        // network round trips (validate + image download) before showing the real picture, flashing the initial-letter
        // fallback the whole time ("the Nexus page flashes Y on every visit"). The cache is written back at the end
        // of this method / on Settings refresh, shared with the Settings page via nexusAvatarDataUri.
        var cachedAvatar = Cfg.Current.NexusAvatarDataUri;
        _userAvatar = cachedAvatar is not null && cachedAvatar.StartsWith("data:image/", StringComparison.Ordinal) ? cachedAvatar : "";
        try
        {
            var u = await NexusApi.ValidateAsync(_key);
            if (u is null) return;
            _userName = u.Name;
            _isPremium = u.IsPremium;
            _profileUrl = u.ProfileUrl;
            _memberId = u.MemberId;
            if (u.MemberId > 0)
                _ = Task.Run(async () =>
                {
                    try
                    {
                        _userExtras = await NexusApi.GetUserExtrasAsync(u.MemberId);
                        // v1.08.0: GraphQL user.avatar is the authoritative direct link (/missing placeholder already filtered) —
                        // v1.08.3: distinguish two kinds of "empty" — only fall back to the initial letter when GraphQL
                        // explicitly has no avatar; a mere download failure keeps the existing (cached/fetched) value
                        if (_userExtras is not null)
                        {
                            if (string.IsNullOrWhiteSpace(_userExtras.Avatar))
                                _userAvatar = "";
                            else
                            {
                                var gav = await NexusApi.FetchAvatarAsync(_userExtras.Avatar);
                                if (!string.IsNullOrEmpty(gav) && gav != _userAvatar) _userAvatar = gav;
                            }
                        }
                        await InvokeAsync(StateHasChanged);
                    }
                    catch { }
                });
            var cfg = Cfg.Current;
            cfg.NexusUserName = u.Name;
            cfg.NexusUserEmail = u.Email;
            cfg.NexusProfileUrl = u.ProfileUrl;
            cfg.NexusIsPremium = u.IsPremium;
            Cfg.Save(cfg);
            // v1.08.0: validate already built the avatar direct link from user_id → try fetching it;
            // v1.08.3: only update and write back when different from the cache — the next visit shows the cache instantly, no fallback flash
            if (!string.IsNullOrEmpty(u.Avatar))
            {
                var av = await NexusApi.FetchAvatarAsync(u.Avatar);
                if (!string.IsNullOrEmpty(av) && av != _userAvatar)
                {
                    _userAvatar = av;
                    var cfg2 = Cfg.Current;
                    cfg2.NexusAvatarDataUri = av;
                    Cfg.Save(cfg2);
                }
            }
        }
        catch { /* fail silently; the UI uses the cache or the initial-letter fallback */ }
    }

    private void OpenProfile()
    {
        // v1.05.0: use the site's own /profile/{username} — the profile_url cached from validate
        // once sent users to wrong pages like avatars.nexusmods.com/missing
        var name = string.IsNullOrWhiteSpace(_userName) ? Cfg.Current.NexusUserName : _userName;
        if (!string.IsNullOrWhiteSpace(name))
            UpdateService.OpenUrl("https://www.nexusmods.com/profile/" + Uri.EscapeDataString(name));
        else if (!string.IsNullOrEmpty(_profileUrl))
            UpdateService.OpenUrl(_profileUrl);
