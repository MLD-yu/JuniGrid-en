@namespace JuniGrid.Components.Pages
@page "/nexus"
@implements IDisposable
@inject ConfigService Cfg
@inject NexusService NexusApi
@inject NexusSsoService Sso
@inject ModService ModSvc
@inject GameService Game
@inject InstallService Installer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PageRefreshService PageRefresh

<div class="jg-page jg-nexus-scope">
    @* ─── v1.06.2: Two-part header — left (logo + search island) flex:1 / right (login/avatar) flex:1.
         Search island restored to its pre-v1.05.4 shape: magnifier button right after the logo; the input
         expands to the right on click (GSAP back.out). No longer permanently expanded (class is no longer
         fixed to open; expand/collapse is driven by searchIslandInit). ─── *@
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:0;">
        <div style="display:flex;align-items:center;gap:10px;flex:1 1 0;min-width:0">
            <img class="jg-nexus-logo" src="assets/nexus-mods-logo.svg" alt="Nexus Mods"
                 style="flex-shrink:0;height:50px;width:auto;cursor:pointer;"
                 @onclick="OpenNexusHome" />
            @* ─── Relatively-positioned wrapper for the search island + history panel.
                 The history panel hangs off the wrapper so the island's overflow:hidden can't clip it. ─── *@
            <div class="jg-island-wrap">
                <div class="jg-nexus-island" id="jgNexusIsland">
                    <button type="button" class="jg-island-btn" id="jgNexusIslandBtn" aria-label="Search">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </button>
                    <div class="jg-island-field">
                        <input class="jg-island-input" id="jgNexusIslandInput" placeholder="Search mod name / Nexus mod ID" autocomplete="off"
                               value="@_searchText" @oninput="OnIslandInput" @onkeydown="OnIslandKeyDown" />
                        @if (!string.IsNullOrEmpty(_searchText))
                        {
                            <button type="button" class="jg-island-clear" @onclick="ClearSearch">✕</button>
                        }
                    </div>
                </div>
                @* ─── v1.05.1: Search history (clear button at the far left of the "Search history" label;
                     keeps the latest 10 entries at most). Visibility is fully driven by JS toggling the
                     .history-open class — in practice the focus event triggered by JS focus() never reaches
                     Blazor (@onfocus never fires, so the panel never appeared), so DOM events are no longer relied on. ─── *@
                @if (_searchHistory.Count > 0)
                {
                    <div class="jg-search-history">
                        <div class="jg-search-history-head">
                            <span>Search history</span>
                            <button type="button" class="jg-search-history-clearall" @onclick="ClearAllHistory">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                Clear history
                            </button>
                        </div>
                        @foreach (var h in _searchHistory)
                        {
                            <div class="jg-search-history-row" @onclick="() => PickHistory(h)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                <span class="jg-search-history-text">@h</span>
                                <button type="button" class="jg-search-history-del" @onclick="() => RemoveHistory(h)" @onclick:stopPropagation>✕</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex:1 1 0;justify-content:flex-end">
            @if (!string.IsNullOrEmpty(_key))
            {
                @* ─── v0.70.1: Avatar only; hovering pops up a user card with GSAP easeReverse tooltip ─── *@
                <div class="jg-user-tip" id="jgUserTip">
                    @if (!string.IsNullOrEmpty(_userAvatar))
                    {
                        <img class="jg-user-tip-avatar" src="@_userAvatar" alt="avatar" />
                    }
                    else
                    {
                        <div class="jg-user-tip-avatar jg-user-tip-fallback">
                            @(_userName.Length>0 ? _userName[..1].ToUpperInvariant() : "N")
                        </div>
                    }
                    <div class="jg-user-tip-bubble" id="jgUserTipBubble">
                        <div class="jg-user-tip-name">
                            @(_userName.Length==0 ? "Nexus user" : _userName)
                            @if (_isPremium) { <span class="jg-premium-badge">Premium</span> }
                            else { <span style="opacity:.55;font-size:11px;font-weight:400">Free account</span> }
                        </div>
                        @if (_userExtras is not null)
                        {
                            <div class="jg-user-tip-stats">
                                @if (_userExtras.ModCount > 0) { <span>Released @_userExtras.ModCount mods</span> }
                                @if (_userExtras.UniqueModDownloads > 0) { <span>@FormatNum(_userExtras.UniqueModDownloads) downloads</span> }
                                @if (_userExtras.EndorsementsGiven > 0) { <span>@_userExtras.EndorsementsGiven endorsements</span> }
                                @if (!string.IsNullOrEmpty(_userExtras.Joined)) { <span>Joined @_userExtras.Joined[..Math.Min(10, _userExtras.Joined.Length)]</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_userExtras.About))
                            {
                                <div class="jg-user-tip-about">@(_userExtras.About.Length > 90 ? _userExtras.About[..90] + "…" : _userExtras.About)</div>
                            }
                        }
                        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:8px;margin-top:9px;">
                            <button class="jg-user-tip-link" style="margin-top:0" @onclick="OpenProfile">View profile →</button>
                            <button class="jg-user-tip-logoutbtn" @onclick="LogoutNexus">Log out</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <button class="jg-login-btn" @onclick="OpenLoginDialog">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Log in
                </button>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_ssoMsg)) { <div class="jg-note" style="margin-top:6px;">@_ssoMsg</div> }
    @* ─── v0.74.0: Site-style home page (Trending + Mods sections) ─── *@
    @if (_viewMode == "home")
    {
        <section class="jg-home-sec jg-home-sec-hero jg-hero-cream">
            <div class="jg-trend-grain" id="jgTrendGrain"></div>
            <div class="jg-home-sec-head">
                <span class="jg-home-sec-title" style="display:inline-flex;align-items:center;gap:6px"><svg width="18" height="18" viewBox="0 0 24 24" style="vertical-align:-3px"><defs><linearGradient id="jgFlameG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#bcd2ff"/></linearGradient></defs><path d="M12 14.5 21 9.2 12 4 3 9.2Z" fill="#f2994a"/><path d="M12 16.8 21 11.5 21 9.2 12 14.5 3 9.2 3 11.5Z" fill="#d17a26"/><path d="M12 0.8c1.7 2.2 3.6 3.6 3.6 5.9 0 2-1.6 3.4-3.6 3.4s-3.6-1.4-3.6-3.4c0-1.1.5-1.9 1.1-2.6.2.9.7 1.5 1.4 1.7-.5-1.8 0-3.7 1.1-5Z" fill="url(#jgFlameG)"/></svg><DepthText Text="Trending Mods" FontSize="15px" /></span>
                <button type="button" class="jg-viewall" @onclick='@(() => EnterBrowse("trending"))'>View all@((MarkupString)ViewAllArrow)</button>
            </div>
            @* v0.75.0: Check login state first — show guidance text when logged out; while logged in, keep Shimmer until data arrives *@
            @if (string.IsNullOrEmpty(_key))
            {
                <div style="font-size:12px;opacity:.6">Log in to view the official Nexus Trending list.</div>
            }
            else if (_homeLoading && _trendingHome.Count == 0)
            {
                <div class="jg-trend-grid">
                    <div class="jg-trend-big jg-shimmer"></div>
                    <div class="jg-trend-big jg-shimmer"></div>
                </div>
            }
            else if (_trendingHome.Count > 0)
            {
                <div class="jg-trend-grid">
                    @foreach (var mod in _trendingHome.Take(2))
                    {
                        <div class="jg-trend-big" @onclick="() => OpenDetail(mod.Id)">
                            @if (!string.IsNullOrEmpty(mod.PictureUrl ?? mod.ThumbnailUrl))
                            {
                                <img class="jg-trend-big-cover" src="@(mod.PictureUrl ?? mod.ThumbnailUrl)" loading="lazy" alt="" />
                            }
                            <div class="jg-trend-big-info">
                                <div class="jg-trend-big-name">@mod.Name</div>
                                <div class="jg-trend-big-sub">by @(string.IsNullOrEmpty(mod.Uploader) ? "unknown" : mod.Uploader) · <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg> @mod.Endorsements</div>
                                @if (!string.IsNullOrWhiteSpace(mod.Summary))
                                {
                                    <div class="jg-trend-big-sum">@mod.Summary</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_trendingHome.Count > 2)
                {
                    <div class="jg-trend-smalls">
                        @foreach (var mod in _trendingHome.Skip(2).Take(4))
                        {
                            <div class="jg-trend-sm" @onclick="() => OpenDetail(mod.Id)">
                                @if (!string.IsNullOrEmpty(mod.ThumbnailUrl ?? mod.PictureUrl))
                                {
                                    <img class="jg-trend-sm-cover" src="@(mod.ThumbnailUrl ?? mod.PictureUrl)" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <div class="jg-trend-sm-cover jg-trend-sm-fb">@(mod.Name.Length>0 ? mod.Name[..1].ToUpperInvariant() : "?")</div>
                                }
                                <div class="jg-trend-sm-name">@mod.Name</div>
                                <div class="jg-trend-sm-sub">by @(string.IsNullOrEmpty(mod.Uploader) ? "unknown" : mod.Uploader) · <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg> @mod.Endorsements</div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div style="font-size:12px;opacity:.6">Failed to load the list — try refreshing later.</div>
            }
        </section>

        <section class="jg-home-sec jg-home-sec-hero jg-hero-cream">
            <div class="jg-home-sec-head">
                <span class="jg-home-sec-title" style="display:inline-flex;align-items:center;gap:6px"><svg width="18" height="18" viewBox="0 0 24 24" style="vertical-align:-3px"><defs><linearGradient id="jgGemG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#c9d2ff"/></linearGradient></defs><path d="M12 4.5 21 9.8 12 15.2 3 9.8Z" fill="url(#jgGemG)" stroke="#aab4e8" stroke-width=".5"/><path d="M12 15.2 21 9.8 21 12 12 17.4 3 12 3 9.8Z" fill="#8f9bd6" opacity=".55"/></svg><DepthText Text="Mods" FontSize="15px" /></span>
                <button type="button" class="jg-viewall" @onclick="() => EnterBrowse(_homeTab)">View all@((MarkupString)ViewAllArrow)</button>
            </div>
            <div class="jg-chips">
                @foreach (var tab in _browseTabs)
                {
                    <button type="button" class="jg-chip @(_homeTab == tab.Key ? "active" : "")"
                            disabled="@_homeLoading" @onclick="() => SetHomeTab(tab.Key)">
                        @((MarkupString)TabIcon(tab.Key))@tab.Label
                    </button>
                }
            </div>
            @if (string.IsNullOrEmpty(_key))
            {
                <div style="font-size:12px;opacity:.6;margin-top:8px">Log in to view the official Nexus mod lists.</div>
            }
            else if (_homeLoading && _homeMods.Count == 0)
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @for (var i = 0; i < _pageSize; i++)
                    {
                        <div class="jg-modcard2 jg-modcard2-skel">
                            <div class="jg-modcard2-cover-wrap"><div class="jg-modcard2-cover jg-shimmer"></div></div>
                            <div class="jg-modcard2-body">
                                <div class="jg-shimmer" style="height:14px;border-radius:4px"></div>
                                <div class="jg-shimmer" style="height:11px;border-radius:4px;width:55%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_homeMods.Count > 0)
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @foreach (var mod in _homeMods)
                    {
                        <div class="jg-modcard2" @onclick="() => OpenDetail(mod.Id)">
                            <div class="jg-modcard2-cover-wrap">
                                @if (!string.IsNullOrEmpty(mod.ThumbnailUrl) || !string.IsNullOrEmpty(mod.PictureUrl))
                                {
                                    <img class="jg-modcard2-cover" src="@(mod.ThumbnailUrl ?? mod.PictureUrl)" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <div class="jg-modcard2-cover jg-modcard2-fb">@(mod.Name.Length>0 ? mod.Name[..1].ToUpperInvariant() : "?")</div>
                                }
                                @if (_installedIds.Contains(mod.Id))
                                {
                                    <span class="jg-modcard2-badge">Installed</span>
                                }
                            </div>
                            <div class="jg-modcard2-body">
                                @* ─── v1.04.0: Site-style compact layout — cover / title / category chip / two-line summary ─── *@
                                <div class="jg-modcard2-title">@mod.Name</div>
                                @if (!string.IsNullOrEmpty(mod.Category))
                                {
                                    <span class="jg-modcard2-cat-chip">@mod.Category</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(mod.Summary))
                                {
                                    <div class="jg-modcard2-summary">@(mod.Summary.Length > 90 ? mod.Summary[..90] + "…" : mod.Summary)</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @* ─── v1.04.0: The Mods section's bottom "View all" became a pill button (arrow after the text, follows text color) ─── *@
                <div style="display:flex;justify-content:center;margin-top:14px;">
                    <button type="button" class="jg-viewall-cap" @onclick="() => EnterBrowse(_homeTab)">View all@((MarkupString)ViewAllArrow)</button>
                </div>
            }
        </section>
    }

    @* ─── v1.02.0: Search page (standalone view, no longer reuses the "view all" page; an ID match shows an "Exact match" card) ─── *@
    else if (_viewMode == "search")
    {
        <section class="jg-home-sec">
            <div class="jg-home-sec-head">
                <div style="display:flex;align-items:center;gap:10px;min-width:0">
                    <button type="button" class="jg-back-btn" @onclick="BackFromSearch" aria-label="Back">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <span class="jg-home-sec-title" style="font-size:15px;font-weight:700">Search: @_searchTitle</span>
                </div>
            </div>
            @if (_exactMod is not null)
            {
                var exName = PropStr(_exactMod, "Name");
                var exPic = PropStr(_exactMod, "PictureUrl");
                var exVer = PropStr(_exactMod, "Version");
                <div class="jg-search-exact" @onclick="() => OpenDetail(_exactMod.Id)">
                    @if (!string.IsNullOrEmpty(exPic))
                    {
                        <img class="jg-search-exact-cover" src="@exPic" alt="" />
                    }
                    else
                    {
                        <div class="jg-search-exact-cover jg-search-exact-fb">@(!string.IsNullOrEmpty(exName) ? exName[..1].ToUpperInvariant() : "#")</div>
                    }
                    <div class="jg-search-exact-body">
                        <div class="jg-search-exact-name">@(!string.IsNullOrEmpty(exName) ? exName : $"Mod with ID #{_exactMod.Id}")</div>
                        <div class="jg-search-exact-sub">ID #@_exactMod.Id · Exact match@(string.IsNullOrEmpty(exVer) ? "" : $" · v{exVer}")</div>
                    </div>
                    <span class="jg-search-exact-go">View →</span>
                </div>
            }
            @if (_browseLoading)
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @for (var i = 0; i < 8; i++)
                    {
                        <div class="jg-modcard2-cover jg-shimmer" style="aspect-ratio:16/10;border-radius:10px"></div>
                    }
                </div>
            }
            else if (_browse.Count > 0)
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @foreach (var mod in _browse)
                    {
                        <div class="jg-modcard2" @onclick="() => OpenDetail(mod.Id)">
                            <div class="jg-modcard2-cover-wrap">
                                @if (!string.IsNullOrEmpty(mod.ThumbnailUrl) || !string.IsNullOrEmpty(mod.PictureUrl))
                                {
                                    <img class="jg-modcard2-cover" src="@(mod.ThumbnailUrl ?? mod.PictureUrl)" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <div class="jg-modcard2-cover jg-modcard2-fb">@(mod.Name.Length>0 ? mod.Name[..1].ToUpperInvariant() : "?")</div>
                                }
                                @if (_installedIds.Contains(mod.Id))
                                {
                                    <span class="jg-modcard2-badge">Installed</span>
                                }
                            </div>
                            <div class="jg-modcard2-body">
                                @* ─── v1.04.0: Site-style compact layout — cover / title / category chip / two-line summary ─── *@
                                <div class="jg-modcard2-title">@mod.Name</div>
                                @if (!string.IsNullOrEmpty(mod.Category))
                                {
                                    <span class="jg-modcard2-cat-chip">@mod.Category</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(mod.Summary))
                                {
                                    <div class="jg-modcard2-summary">@(mod.Summary.Length > 90 ? mod.Summary[..90] + "…" : mod.Summary)</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="jg-pager">
                    <div class="jg-pager-side">
                        <span class="jg-pager-info">
                            Page @_page@(TotalPages is int tp ? $" / {tp}" : "")@(TotalPages is not null && NexusApi.LastBrowseTotalCount is int tc ? $" · {tc:N0} total" : "")
                        </span>
                    </div>
                    <div class="jg-pager-side">
                        <button class="jg-pager-btn" disabled="@(_page <= 1)" @onclick="PrevPage">‹ Prev</button>
                        @foreach (var it in PageNumbers)
                        {
                            if (it.Dots)
                            {
                                <span class="jg-pager-dots">…</span>
                            }
                            else
                            {
                                var p = it.Page;
                                <button class="jg-pager-btn @(p == _page ? "cur" : "")" @onclick="() => GoToPage(p)">@p</button>
                            }
                        }
                        <button class="jg-pager-btn" disabled="@(!_hasNextPage)" @onclick="NextPage">Next ›</button>
                        <input class="jg-pager-jump" placeholder="Page" @bind="_jumpText" />
                        <button class="jg-pager-btn" @onclick="JumpToPage">Go</button>
                    </div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(_searchTitle))
            {
                <div class="jg-note" style="margin-top:10px">Type a mod name or Nexus mod ID in the search box above to start searching.</div>
            }
            else if (_exactMod is null)
            {
                <div class="jg-note" style="margin-top:10px">No mods found for "@_searchTitle" — try another keyword or a Nexus mod ID.</div>
            }
            else
            {
                <div class="jg-note" style="margin-top:10px">No results by name, but one mod matched the ID exactly above.</div>
            }
        </section>
    }

    @* ─── v0.74.0: Browse page ("view all") — top bar with back + filters + full list + pagination ─── *@
    else if (_viewMode == "browse")
    {
        <section class="jg-home-sec">
            <div class="jg-home-sec-head">
                <div style="display:flex;align-items:center;gap:10px;min-width:0">
                    <button type="button" class="jg-back-btn" @onclick="BackToHome" aria-label="Back">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                </div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    @* ─── v1.04.0: Filters (formerly the New/Updated/Downloads/Popular/Surprise button bar), time range, and
                       sort direction — three GSAP easeReverse dropdowns (springy expand + arrow rotation + staggered menu items
                       + accelerated reverse exit) ─── *@
                    <div class="jg-sort-dd @(_kindOpen ? "open" : "")" id="jgKindDd">
                        <button type="button" class="jg-sort-trigger" disabled="@_browseLoading" @onclick="ToggleKindDd">
                            @((MarkupString)TabIcon(_browseKind))@KindLabel
                            <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="jg-sort-menu">
                            @* v1.07.0: Visual inner layer — the springy animation only applies to this layer; the outer box stays
                               at its final rectangle (hit area equals the final position from the first frame of opening,
                               so clicks no longer pass through to mod cards below during the animation) *@
                            <div class="jg-sort-menu-in">
                                @foreach (var tab in _browseTabs)
                                {
                                    <button type="button" class="jg-sort-item @(_browseKind == tab.Key ? "active" : "")"
                                            disabled="@_browseLoading" @onclick="() => LoadBrowse(tab.Key)">
                                        @((MarkupString)TabIcon(tab.Key))@tab.Label
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="jg-sort-dd jg-dd-right @(_timeOpen ? "open" : "")" id="jgTimeDd">
                        <button type="button" class="jg-sort-trigger" disabled="@_browseLoading" @onclick="ToggleTimeDd">
                            @TimeLabel
                            <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="jg-sort-menu">
                            @* v1.07.0: Visual inner layer (same as above) — outer box keeps its final rectangle; hit area doesn't scale with the animation *@
                            <div class="jg-sort-menu-in">
                                @* v1.04.0: The "Custom" time range and related code have been removed *@
                                @foreach (var o in _timeOptions)
                                {
                                    <button type="button" class="jg-sort-item @(_timeRange == o.Key ? "active" : "")"
                                            disabled="@_browseLoading" @onclick="() => SetTimeRange(o.Key)">@o.Label</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="jg-sort-dd jg-dd-right @(_dirOpen ? "open" : "")" id="jgDirDd">
                        <button type="button" class="jg-sort-trigger" disabled="@_browseLoading" @onclick="ToggleDirDd">
                            @(_direction == "DESC" ? "Descending" : "Ascending")
                            <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="jg-sort-menu">
                            @* v1.07.0: Visual inner layer (same as above) — outer box keeps its final rectangle; hit area doesn't scale with the animation *@
                            <div class="jg-sort-menu-in">
                                <button type="button" class="jg-sort-item @(_direction == "DESC" ? "active" : "")"
                                        @onclick='() => SetDirection("DESC")'>Descending (most → least)</button>
                                <button type="button" class="jg-sort-item @(_direction == "ASC" ? "active" : "")"
                                        @onclick='() => SetDirection("ASC")'>Ascending (least → most)</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* v1.07.0: The overlay stays in the DOM permanently — previously the @if render lagged one beat behind the JS
               menu (Blazor re-render is queued after interop), so during the "menu open but overlay not yet shown" window
               clicks could pass through to mod cards below (most visible while the open animation plays).
               The open/close class is flipped in the same frame as the menu by the dropdownToggle JS; this binding only
               re-aligns state as a fallback on re-render. *@
            <div class="jg-dd-overlay @((_kindOpen || _timeOpen || _dirOpen) ? "open" : "")" @onclick="CloseAllDd"></div>
            @if (string.IsNullOrEmpty(_key))
            {
                <div style="font-size:12px;opacity:.6;margin-top:8px">Log in to view official Nexus lists.</div>
            }
            else if (_browseLoading)
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @for (var i = 0; i < _pageSize; i++)
                    {
                        <div class="jg-modcard2 jg-modcard2-skel">
                            <div class="jg-modcard2-cover-wrap"><div class="jg-modcard2-cover jg-shimmer"></div></div>
                            <div class="jg-modcard2-body">
                                <div class="jg-shimmer" style="height:14px;border-radius:4px"></div>
                                <div class="jg-shimmer" style="height:11px;border-radius:4px;width:55%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_browse.Count == 0)
            {
                <div style="font-size:12px;opacity:.6;margin-top:8px">No data yet (try different filters or retry later).</div>
            }
            else
            {
                <div class="jg-browse2" style="margin-top:10px">
                    @foreach (var mod in _browse)
                    {
                        <div class="jg-modcard2" @onclick="() => OpenDetail(mod.Id)">
                            <div class="jg-modcard2-cover-wrap">
                                @if (!string.IsNullOrEmpty(mod.ThumbnailUrl) || !string.IsNullOrEmpty(mod.PictureUrl))
                                {
                                    <img class="jg-modcard2-cover" src="@(mod.ThumbnailUrl ?? mod.PictureUrl)" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <div class="jg-modcard2-cover jg-modcard2-fb">@(mod.Name.Length>0 ? mod.Name[..1].ToUpperInvariant() : "?")</div>
                                }
                                @if (_installedIds.Contains(mod.Id))
                                {
                                    <span class="jg-modcard2-badge">Installed</span>
                                }
                            </div>
                            <div class="jg-modcard2-body">
                                @* ─── v1.04.0: Site-style compact layout — cover / title / category chip / two-line summary ─── *@
                                <div class="jg-modcard2-title">@mod.Name</div>
                                @if (!string.IsNullOrEmpty(mod.Category))
                                {
                                    <span class="jg-modcard2-cat-chip">@mod.Category</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(mod.Summary))
                                {
                                    <div class="jg-modcard2-summary">@(mod.Summary.Length > 90 ? mod.Summary[..90] + "…" : mod.Summary)</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @* ─── v0.90.0: Paginator (mirrors the site: page numbers + jump + refresh; v1.04.0 removed per-page size selection, fixed at 40) ─── *@
                @if (!_browseLoading && _browse.Count > 0)
                {
                    <div class="jg-pager">
                        @if (_browseKind == "surprise")
                        {
                            @* Surprise "shuffle" = change the server-side random seed and re-query (mirrors the site's random sort) *@
                            <button class="jg-pager-btn" @onclick="ReshuffleSurpriseAsync">🎲 Shuffle</button>
                        }
                        else
                        {
                            <div class="jg-pager-side">
                                <span class="jg-pager-info">
                                    Page @_page@(TotalPages is int tp ? $" / {tp}" : "")@(TotalPages is not null && NexusApi.LastBrowseTotalCount is int tc ? $" · {tc:N0} total" : "")
                                </span>
                            </div>
                            <div class="jg-pager-side">
                                <button class="jg-pager-btn" disabled="@(_page <= 1)" @onclick="PrevPage">‹ Prev</button>
                                @foreach (var it in PageNumbers)
                                {
                                    if (it.Dots)
                                    {
                                        <span class="jg-pager-dots">…</span>
                                    }
                                    else
                                    {
                                        var p = it.Page;
                                        <button class="jg-pager-btn @(p == _page ? "cur" : "")" @onclick="() => GoToPage(p)">@p</button>
                                    }
                                }
                                <button class="jg-pager-btn" disabled="@(!_hasNextPage)" @onclick="NextPage">Next ›</button>
                                <input class="jg-pager-jump" placeholder="Page" @bind="_jumpText" />
                                <button class="jg-pager-btn" @onclick="JumpToPage">Go</button>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    }

</div>

@* ── v0.39.0: Login dialog (method choice → API key entry → authorization wait → Pixel Reveal success card) ── *@
@if (_loginStep != LoginStep.Closed)
{
    <div class="jg-login-overlay" @onclick="CloseLoginDialog">
        <div class="jg-login-card @(_loginStep == LoginStep.Success ? "success" : "")" @onclick:stopPropagation>

            @if (_loginStep == LoginStep.Choose)
            {
                <div class="jg-login-title">Choose a login method</div>
                <div class="jg-login-sub">Connect your Nexus Mods account to unlock browsing and one-click install</div>
                <div class="jg-login-options">
                    <button class="jg-login-option" @onclick="() => _loginStep = LoginStep.ApiKey">
                        <span class="jg-login-option-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m11 12 9.5-9.5"/><path d="m15.5 7.5 3 3"/><path d="m18.5 4.5 2 2"/></svg>
                        </span>
                        <span class="jg-login-option-text">
                            <span class="jg-login-option-name">Log in with API Key</span>
                            <span class="jg-login-option-desc">Paste your personal API key to sign in instantly</span>
                        </span>
                    </button>
                    @* v1.08.4: The SSO app name "junigrid" is not yet on Nexus's official whitelist, so the
                       authorization page reports "invalid application ID" — this entry stays disabled until official approval *@
                    <button class="jg-login-option jg-login-option-disabled" disabled
                            title="Pending official approval: Nexus site authorization opens once the app name is approved. Please use API Key login for now.">
                        <span class="jg-login-option-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        </span>
                        <span class="jg-login-option-text">
                            <span class="jg-login-option-name">Website authorization login</span>
                            <span class="jg-login-option-desc">Pending official approval — coming soon</span>
                        </span>
                    </button>
                </div>
                <button class="jg-login-cancel" @onclick="CloseLoginDialog">Cancel</button>
            }
            else if (_loginStep == LoginStep.ApiKey)
            {
                <div class="jg-login-title">Enter your API Key</div>
                <div class="jg-login-sub">The API Key is stored only on this machine and is used to access official Nexus Mods data</div>
                <input class="jg-login-input" placeholder="Paste your Nexus API Key"
                       @bind="_apiKeyInput" @bind:event="oninput" disabled="@_apiKeyBusy" />
                @if (!string.IsNullOrEmpty(_apiKeyError))
                {
                    <div class="jg-login-error">@_apiKeyError</div>
                }
                <div class="jg-login-actions">
                    <button class="jg-login-get" @onclick="OpenApiKeyPage" disabled="@_apiKeyBusy">
                        Get API Key
                    </button>
                    <button class="jg-login-confirm @(_apiKeyBusy ? "busy" : "")"
                            disabled="@(_apiKeyBusy || string.IsNullOrWhiteSpace(_apiKeyInput))"
                            @onclick="ConfirmApiKey">
                        @if (_apiKeyBusy)
                        {
                            <span class="jg-login-spinner"></span>
                        }
                        else
                        {
                            <text>Confirm</text>
                        }
                    </button>
                </div>
                <button class="jg-login-cancel" @onclick="BackToChoose" disabled="@_apiKeyBusy">Back</button>
            }
            else if (_loginStep == LoginStep.SsoWaiting)
            {
                <div class="jg-login-title">Waiting for authorization</div>
                <div class="jg-login-sub">The Nexus authorization page has opened — click Authorise in your browser to finish</div>
                <div class="jg-login-waiting">
                    <span class="jg-login-spinner large"></span>
                    <span>Waiting for browser authorization…</span>
                </div>
                <button class="jg-login-cancel" @onclick="CancelSsoFlow">Cancel authorization</button>
            }
            else if (_loginStep == LoginStep.Success)
            {
                @* Pixel Reveal: a canvas pixel sweep reveals the content; avatar/nickname/welcome message are hidden under the pixel curtain *@
                <canvas id="jg-pixel-reveal" class="jg-pixel-reveal"></canvas>
                <div class="jg-login-success-inner">
                    @if (!string.IsNullOrEmpty(_userAvatar))
                    {
                        <img class="jg-login-avatar" src="@_userAvatar" alt="avatar" />
                    }
                    else
                    {
                        <div class="jg-login-avatar fallback">@(_userName.Length>0 ? _userName[..1].ToUpperInvariant() : "N")</div>
                    }
                    <div class="jg-login-success-name">@(_userName.Length==0 ? "Nexus user" : _userName)</div>
                    <div class="jg-login-success-welcome">Welcome to JuniGrid!</div>
                </div>
                <button class="jg-login-confirm" style="width:100%;justify-content:center" @onclick="CloseLoginDialog">Get started</button>
            }

        </div>
    </div>
}

@* Success toast: centered black bar at the top of the screen *@
@if (_loginToast)
{
    <div class="jg-login-toast">✓ Logged in</div>
}

@code {
    // v0.59.0: First-paint shimmer

    private string? _ssoMsg;

    // ---- v0.39.0: Login dialog state machine ----
    private enum LoginStep { Closed, Choose, ApiKey, SsoWaiting, Success }
    private LoginStep _loginStep = LoginStep.Closed;
    private string _apiKeyInput = "";
    private bool _apiKeyBusy;
    private string? _apiKeyError;
    private bool _loginToast;

    private void OpenLoginDialog()
    {
        _loginStep = LoginStep.Choose;
        _apiKeyInput = "";
        _apiKeyError = null;
    }

    private void CloseLoginDialog()
    {
        // Clicking the overlay while waiting for authorization is the same as canceling
        if (_loginStep == LoginStep.SsoWaiting) { CancelSsoFlow(); return; }
        _loginStep = LoginStep.Closed;
    }

    private void BackToChoose() => _loginStep = LoginStep.Choose;

    private void OpenApiKeyPage()
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(
                "https://www.nexusmods.com/users/myaccount?tab=api") { UseShellExecute = true });
        }
        catch { }
    }

    // API Key login: validate → save → success card
    private async Task ConfirmApiKey()
    {
        if (_apiKeyBusy) return;
        _apiKeyBusy = true;
        _apiKeyError = null;
        StateHasChanged();
        try
        {
            var key = _apiKeyInput.Trim();
            var user = await NexusApi.ValidateAsync(key);
            if (user is null)
            {
                _apiKeyError = "Invalid API Key — please check and try again";
                return;
            }
            _key = key;
            _userName = user.Name ?? "";
            _isPremium = user.IsPremium;
            // vNext: Persist user info right at login — saving only the key would make the Settings page
            // flash "Not logged in" first (the name only appears after the Settings page's background
            // validate self-heal, about 1s later)
            {
                var c0 = Cfg.Current;
                c0.NexusApiKey = _key;
                c0.NexusUserName = _userName;
                c0.NexusUserEmail = user.Email ?? "";
                c0.NexusProfileUrl = user.ProfileUrl ?? "";
                c0.NexusIsPremium = _isPremium;
                Cfg.Save(c0);
            }
            _userName = user.Name ?? "";
            _isPremium = user.IsPremium;
            // v1.08.3: The success card shows the initial-letter fallback first, then fetches the avatar in the
            // background, converts it to a data URI and caches it — the pixel reveal animation runs 2.6s, enough
            // time for the image to be in place; next visit to the page reads the cache and shows instantly
            _userAvatar = "";
            _ = Task.Run(async () =>
            {
                try
                {
                    var av = await NexusApi.FetchAvatarAsync(user.Avatar ?? "");
                    if (!string.IsNullOrEmpty(av))
                    {
                        _userAvatar = av;
                        var c = Cfg.Current; c.NexusAvatarDataUri = av; Cfg.Save(c);
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch { }
            });
            await ShowLoginSuccess();
        }
        catch (Exception ex)
        {
            _apiKeyError = "Validation failed: " + ex.Message;
        }
        finally
        {
            _apiKeyBusy = false;
            StateHasChanged();
        }
    }

    // Site authorization: enter waiting state → SSO → success card
    private async Task StartSsoFlow()
    {
        _loginStep = LoginStep.SsoWaiting;
        StateHasChanged();
        using var cts = _ssoCts = new CancellationTokenSource();
        try
        {
            var key = await Sso.LoginAsync("junigrid", cts.Token);
            if (!string.IsNullOrEmpty(key))
            {
                _key = key;
                Save();
                await LoadNexusUserAsync();
                await ShowLoginSuccess();
            }
            else if (_ssoCts?.IsCancellationRequested != true)
            {
                // Non-cancellation failure: return to the method choice with a message
                _loginStep = LoginStep.Choose;
                _ssoMsg = "SSO not completed: " + (Sso.LastError ?? "Timed out (5 minutes)");
            }
        }
        finally
        {
            _ssoCts = null;
            if (_loginStep == LoginStep.SsoWaiting) _loginStep = LoginStep.Choose;
            StateHasChanged();
        }
    }

    private void CancelSsoFlow()
    {
        _ssoCts?.Cancel();
        _loginStep = LoginStep.Choose;
    }

    // Success card: switch to the Success step → play Pixel Reveal → toast
    private async Task ShowLoginSuccess()
    {
        _loginStep = LoginStep.Success;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("junigridJs.pixelReveal", "#jg-pixel-reveal"); } catch { }
        _ = Task.Run(async () =>
        {
            await Task.Delay(2600);
            _loginToast = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(2400);
            _loginToast = false;
            await InvokeAsync(StateHasChanged);
        });
        // After login succeeds, refresh the current view's data (v0.97.1: previously only browse lists were
        // refreshed — in home mode neither the Trending nor the Mods section had anything loading its data,
        // so it always showed "failed to load")
        if (!string.IsNullOrEmpty(_key))
        {
            if (_viewMode == "browse")
                _ = LoadBrowse(_browseKind);
            else
                _ = LoadHomeAsync();
        }
