    // ---- v0.70.2: Infinite scroll + GraphQL pagination ----
    private async Task LoadBrowse(string kind)
    {
        _browseKind = kind;
        NormalizeTimeRangeForKind();  // v0.77.0: force Surprise back to all
        await ReloadBrowseAsync();
    }

    /// <summary>v0.90.0: Filters changed → back to page 1 and reload.</summary>
    private async Task ReloadBrowseAsync()
    {
        _page = 1;
        await LoadCurrentPageAsync();
    }

    /// <summary>v0.90.0: Load the current page (paged data source, offset = (page-1) × page size).
    /// v1.04.0: Passes the sort direction; category and custom time parameters were removed with the feature.</summary>
    private async Task LoadCurrentPageAsync()
    {
        if (string.IsNullOrEmpty(_key)) return;
        _browseLoading = true;
        StateHasChanged();
        try
        {
            _browse = await NexusApi.BrowseModsAsync(_browseKind, (_page - 1) * _pageSize, _pageSize,
                searchText: _searchText, timeRange: _timeRange, direction: _direction) ?? new();
        }
        catch { _browse = new(); }
        _browseLoading = false;
        StateHasChanged();
    }

    // ─── v0.90.0: Pagination ───
    /// <summary>Total pages: since v0.96.0 moved time filtering server-side, every range has an exact totalCount, so the last page is always reachable.</summary>
    private int? TotalPages => NexusApi.LastBrowseTotalCount is int tc && tc > 0
        ? (int)Math.Ceiling(tc / (double)_pageSize) : null;
    private bool _hasNextPage => TotalPages is int tp ? _page < tp : _browse.Count >= _pageSize;

    /// <summary>Page number window: current ±2 plus first/last, ellipsis in between.</summary>
    private List<(int Page, bool Dots)> PageNumbers
    {
        get
        {
            var list = new List<(int, bool)>();
            var last = TotalPages ?? (_hasNextPage ? _page + 1 : _page);
            var pages = new SortedSet<int> { 1, last };
            for (var p = _page - 2; p <= _page + 2; p++) if (p >= 1 && p <= last) pages.Add(p);
            var prev = 0;
            foreach (var p in pages)
            {
                if (prev > 0 && p - prev > 1) list.Add((0, true));
                list.Add((p, false));
                prev = p;
            }
            return list;
        }
    }

    private async Task GoToPage(int p)
    {
        if (_browseLoading || string.IsNullOrEmpty(_key)) return;
        if (TotalPages is int t) p = Math.Min(p, t);
        p = Math.Max(1, p);
        if (p == _page) return;
        _page = p;
        await LoadCurrentPageAsync();
        try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }   // scroll back to top on page change
    }
    private Task PrevPage() => GoToPage(_page - 1);
    private Task NextPage() => GoToPage(_page + 1);
    private async Task JumpToPage()
    {
        if (int.TryParse(_jumpText, out var p)) await GoToPage(p);
        _jumpText = "";
    }
    // v1.04.0: per-page size selection removed — fixed at 40 (the _pageSize constant)

    /// <summary>v1.05.0: Search box X — clears only the input, keeps the displayed results,
    /// stays on the search page, and refocuses the input.</summary>
    private async Task ClearSearch()
    {
        _searchText = "";
        if (_viewMode == "search")
        {
            // keep the result list and exact-match card as-is — clearing the input ≠ clearing the results
            StateHasChanged();
            try { await JS.InvokeVoidAsync("junigridJs.focusElement", "#jgNexusIslandInput"); } catch { }
        }
        else
        {
            await ReloadBrowseAsync();
        }
    }

    // v0.90.0: lazy loading removed; Dispose only needs to clean up state
    public void Dispose()
    {
        // v0.93.0: snapshot the current browse state before leaving (restored on return)
        _nexusDisposed = true;
        PageRefresh.OnRefresh -= OnPageRefresh;
        _svMode = _viewMode; _svKind = _browseKind; _svPage = _page;
        _svRange = _timeRange; _svSearch = _searchText; _svExact = _exactMod;
        _svBrowse = _browse; _svTrending = _trendingHome; _svHomeMods = _homeMods; _svHomeTab = _homeTab;
    }

    // ---- Install a new mod: one-click direct install (silent, in the background); fall back to the embedded browser only on failure ----
    private async Task InstallBrowse(NexusModListEntry mod)
    {
        if (string.IsNullOrEmpty(_key)) return;
        if (!Cfg.Current.EnableOneClickInstall)
        {
            // One-click install toggle is off → open the embedded browser for a manual download
            OpenEmbedded(mod.Id);
            return;
        }
        _installing.Add(mod.Id);
        _browseStates[mod.Id] = null;   // the in-progress state is shown by the button's "Installing…" label
        StateHasChanged();
        try
        {
            var err = await Installer.InstallModDirectAsync(mod.Id);
            if (err is null)
            {
                _browseStates[mod.Id] = "✅ Installed";
            }
            else if (err.Contains("premium", StringComparison.OrdinalIgnoreCase))
            {
                // v0.44.0: no long hint text on the card (it deforms the layout); download progress is visible in the download list
                _browseStates[mod.Id] = null;
                MainWindow.OpenNexusOverlay(
                    $"https://www.nexusmods.com/stardewvalley/mods/{mod.Id}?tab=files");
            }
            else
            {
                _browseStates[mod.Id] = "Install failed: " + err;
            }
        }
        catch (Exception ex)
        {
            _browseStates[mod.Id] = "Failed: " + ex.Message;
        }
        finally
        {
            _installing.Remove(mod.Id);
        }
    }

