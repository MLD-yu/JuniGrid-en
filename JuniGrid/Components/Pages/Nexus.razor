    private void OnPageRefresh(string key)
    {
        if (key != "nexus") return;
        _ = InvokeAsync(async () =>
        {
            if (string.IsNullOrEmpty(_key)) return;
            // vNext: Manual refresh = start over — scroll to the top and write 0 into the scroll archive
            // (forward navigation restores position from the archive; without writing, it would restore the
            // pre-refresh position)
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
            try { await JS.InvokeVoidAsync("junigridJs.saveCurrentUrlScroll", 0); } catch { }
            if (_viewMode == "search") await RunSearchAsync();
            else if (_viewMode == "browse") await LoadCurrentPageAsync();
            else await LoadHomeAsync();
        });
    }

    private bool _nexusDisposed;

protected override async Task OnInitializedAsync()
    {
        // v0.75.0: No longer force-close the first-paint loading state after 400ms — keep the Shimmer skeleton up
        // until user info + first-screen lists actually finish loading; when logged out, close immediately and show login guidance.
        _key = Cfg.Current.NexusApiKey;
        if (string.IsNullOrEmpty(_key)) _homeLoading = false;
        // Arrived via the Settings page "Log in" pill (/nexus?login=1): when logged out, open the login dialog directly
        if (string.IsNullOrEmpty(_key) && new Uri(Nav.Uri).Query.Contains("login=1"))
        {
            OpenLoginDialog();
            StateHasChanged();
        }
        // v0.93.0: Returning from the detail page → restore the snapshot (empty snapshot on first visit → default home)
        if (_svMode is not null)
        {
            _viewMode = _svMode; _browseKind = _svKind ?? "new";
            _page = _svPage < 1 ? 1 : _svPage; _pageSize = 40;   // v1.04.0: fixed at 40
            _timeRange = _svRange ?? "all"; _searchText = _svSearch ?? ""; _searchTitle = _svSearch ?? "";
            _exactMod = _svExact;   // v1.02.0: search page snapshot restored
            _browse = _svBrowse ?? new(); _trendingHome = _svTrending ?? new();
            _homeMods = _svHomeMods ?? new(); _homeTab = _svHomeTab ?? "new";
            _homeLoading = false;   // v1.03.0: snapshot restored = data already in hand, show directly without loading
        }
        LoadSearchHistory();   // v1.01.0: load history into memory on page entry so it pops on focus
        // vNext: Scan the "Installed" badge set on a background thread — parsing manifests for hundreds of
        // mods no longer blocks first paint (the old version scanned synchronously before requesting lists); fill in badges when done
        _ = InvokeAsync(async () =>
        {
            try
            {
                var ids = await Task.Run(() => BuildInstalledIds());
                if (!_nexusDisposed) { _installedIds = ids; await InvokeAsync(StateHasChanged); }
            }
            catch { /* on scan failure, treat everything as not installed */ }
        });
        // vNext: Fetch user info (validate + avatar) in the background — the UI shows cached data instantly,
        // and the login-validation network round trip no longer blocks the mod lists
        _ = InvokeAsync(async () =>
        {
            try { await LoadNexusUserAsync(); if (!_nexusDisposed) StateHasChanged(); }
            catch { }
        });
        // Auto-load the default list on page entry (no need to click a tab first)
        if (!string.IsNullOrEmpty(_key))
        {
            // v1.03.0: use snapshot data directly when present (no repeat request when returning); only re-fetch when the snapshot is missing (e.g. leftover mode after an app restart)
            if (_viewMode == "search" && _browse.Count > 0) { /* search page snapshot restored, zero requests */ }
            else if (_viewMode == "browse" && _browse.Count > 0) { /* browse page snapshot restored, zero requests */ }
            else if (_viewMode == "home" && (_trendingHome.Count > 0 || _homeMods.Count > 0)) { /* home snapshot restored */ }
            else if (_viewMode == "search") await RunSearchAsync();
            else if (_viewMode == "browse") await LoadCurrentPageAsync();
            else await LoadHomeAsync();
        }
        // v0.75.0: only close the first-paint loading state after the home page fully loads
        StateHasChanged();
        // v1.04.0: the category facets background fetch was removed along with the "category select" feature
    }

    private HashSet<int> BuildInstalledIds()
    {
        HashSet<int> ids = new();
        try
        {
            var gamePath = Cfg.Current.GamePath;
            if (string.IsNullOrWhiteSpace(gamePath)) return ids;
            foreach (var m in ModSvc.Scan(gamePath))
            {
                if (m.NexusModId is int id) ids.Add(id);
            }
            // SMAPI lives in the game root, not the Mods folder, so the scan above misses it;
            // when SMAPI is detected, add its Nexus mod ID so cards show the "Installed" badge
            if (Game.ProbeSmapiVersion(gamePath) is not null) ids.Add(SmapiNexusId);
        }
        catch { /* on scan failure, treat everything as not installed */ }
        return ids;
    }

    /// <summary>SMAPI's mod ID on Nexus (nexusmods.com/stardewvalley/mods/2400).</summary>
    private const int SmapiNexusId = 2400;

