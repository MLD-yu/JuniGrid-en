    private readonly HashSet<string> _collapsed = new();

    private readonly (string Key, string Label)[] _filterOptions =
    {
        ("all",       "All"),
        ("enabled",   "Enabled"),
        ("disabled",  "Disabled"),
        ("updatable", "Updatable"),
    };

    private HashSet<string> InstalledUids =>
        _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
             .Select(m => m.UniqueID)
             .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<ModEntry> _filteredCache = Array.Empty<ModEntry>();

    /// <summary>The mod list after filtering and search are applied.</summary>
    private IReadOnlyList<ModEntry> FilteredMods
    {
        get
        {
            IEnumerable<ModEntry> q = _mods;
            switch (_filter)
            {
                case "enabled": q = q.Where(m => !m.Disabled); break;
                case "disabled": q = q.Where(m => m.Disabled); break;
                case "updatable":
                    q = q.Where(m => IsUpdatable(m));
                    break;
            }
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var s = SearchText.Trim();
                // Purely numeric input is treated as a fuzzy Nexus ID (NexusModId) match — e.g. 4964794 or just 9647 both locate the mod.
                bool numeric = int.TryParse(s, out _);
                q = q.Where(m =>
                    m.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.Author.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.UniqueID.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (numeric && m.NexusModId is not null
                        && m.NexusModId.Value.ToString().Contains(s, StringComparison.Ordinal)));
            }
            return q.ToList();
        }
    }

    private int CountFor(string key) => key switch
