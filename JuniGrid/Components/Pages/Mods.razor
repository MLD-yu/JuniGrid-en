    // ------------------------------------------------------------------
    private void SetDisabled(ModEntry m, bool disabled)
    {
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        if (err is not null) ShowNotice("err", err);
        else
        {
            // v0.46.0: dependency linkage (modeled after Stardrop) —
            // disable: also disable enabled mods that depend on it; enable: also enable its disabled dependencies
            var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (disabled) DisableDependents(m.UniqueID, visited, x => SetDisabledDirect(x, true));
            else EnableDependencies(m, visited, x => SetDisabledDirect(x, false));
            ShowNotice("ok", $"{(disabled ? "Disabled" : "Enabled")} {m.Name}");
            // v0.42.0: after renaming .X <-> X, migrate the update state + cover cache to the new name,
            // otherwise GetCover misses the cache under the new folder name and falls back to the letter placeholder
            MigrateFolderCaches(m.Folder, disabled);
        }
        Rescan();
        // v0.49.0: write the current profile back immediately after a state change
        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
    }

    private void Uninstall(ModEntry m)
    {
        var err = ModSvc.Uninstall(Cfg.Current.GamePath, m.Folder);
        if (err is not null) ShowNotice("err", err);
        else ShowNotice("ok", $"Deleted {m.Name}");
        Rescan();
    }

    // ------------------------------------------------------------------
    // Batch operations
    // ------------------------------------------------------------------
    /// <summary>Low-level enable/disable without dependency linkage (used by the linkage recursion to avoid infinite loops).</summary>
    private void SetDisabledDirect(ModEntry m, bool disabled)
    {
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        if (err is not null) { AppLog.Warn("Mods", $"Linked {(disabled ? "disable" : "enable")} {m.Folder} failed: {err}"); return; }
        MigrateFolderCaches(m.Folder, disabled);
    }

    /// <summary>After disable/enable, migrate the update state + cover/category caches to the new folder name (.X ↔ X).</summary>
    private void MigrateFolderCaches(string folder, bool disabled)
    {
        var newFolder = disabled
            ? (folder.StartsWith('.') ? folder : "." + folder)
            : folder.TrimStart('.');
        if (newFolder == folder) return;
        if (_states.TryGetValue(folder, out var st)) { _states[newFolder] = st; _states.Remove(folder); }
        MigrateDictKey(Cfg.Current.ModCovers, folder, newFolder);
        MigrateDictKey(Cfg.Current.ModCategories, folder, newFolder);
        _coversDirty = true;
        Cfg.Save(Cfg.Current);
    }

    private static void MigrateDictKey(Dictionary<string, string> dict, string oldKey, string newKey)
    {
        if (dict.TryGetValue(oldKey, out var v)) { dict[newKey] = v; dict.Remove(oldKey); }
    }

    private async Task BatchSetDisabled(bool disabled)
    {
        // v0.72.7: batch enable/disable moved to a background thread (same pattern as ApplyProfile) — the old
        // version ran N Directory.Move calls synchronously on the UI thread, and 63 mods froze the window.
        // Watcher OFF/ON is wrapped in try/finally so a mid-way exception never leaves file watching disabled.
        var topLevels = _selected
            .Select(f => f.Split('/')[0])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var gamePath = Cfg.Current.GamePath;
        var selCount = _selected.Count;

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        int failed;
        try
        {
            failed = await Task.Run(() =>
            {
                var f = 0;
                foreach (var top in topLevels)
                    if (ModSvc.SetDisabled(gamePath, top, disabled) is not null)
                        f++;
                return f;
            });
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0
                ? $"{(disabled ? "Disabled" : "Enabled")} {selCount} mods"
                : $"{failed} operations failed");
        ClearSelection();

        // v0.72.9: after a batch rename, migrate cover/category caches uniformly — v0.72.7 omitted
        // MigrateFolderCaches from the batch path, so _states/ModCovers/ModCategories keys stayed on the old
        // folder name and GetCover/GetNexusCategory missed → covers vanished and categories fell back to "code mod".
        foreach (var top in topLevels)
            MigrateFolderCaches(top, disabled);

        Rescan();
        // v0.72.9: explicitly trigger one cover backfill (concurrency-gated, never stacks) — folders changed
        // after the batch rename, so covers under the new keys must be re-fetched.
        if (!string.IsNullOrWhiteSpace(_apiKey)) _ = BackfillCoversAsync();

        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
    }

    private void BatchDelete()
    {
        _pendingBatchDelete = false;
        var count = _selected.Count;
        var failed = 0;
        foreach (var folder in _selected.ToList())
            if (ModSvc.Uninstall(Cfg.Current.GamePath, folder) is not null)
                failed++;

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0 ? $"Deleted {count} mods" : $"{failed} failed to delete");
        ClearSelection();
        Rescan();
    }

    private async Task BatchUpdate()
    {
        // v0.68.0: batch update — routed strictly by "verified Premium":
        //  free users -> the browser opens the Nexus files page for each selected mod (one tab each);
        //            v0.68.2: anything with a Nexus source goes to Nexus (dual-source mods included);
        //            only GitHub-only mods (no Nexus source) update in-app for free;
        //  Premium   -> everything auto-updates in-app one by one (Nexus first), no web pages opened.
        var selectedMods = _mods.Where(m => _selected.Contains(m.Folder)).ToList();
        if (selectedMods.Count == 0)
        {
            ShowNotice("err", "No mods selected.");
            return;
        }
        var isPremium = Cfg.Current.NexusIsPremium;
        var ghTargets = selectedMods
            .Where(m => m.NexusModId is null && m.GitHubRepo is not null && !m.Disabled).ToList();

        if (!isPremium)
        {
            var webTargets = selectedMods
                .Where(m => m.NexusModId is not null).ToList();
            foreach (var m in webTargets)
            {
                UpdateService.OpenUrl(
                    $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                await Task.Delay(200);   // open one at a time so the browser does not merge/block the tabs
            }
            if (webTargets.Count > 0)
                ShowNotice("ok", $"Opened download pages for {webTargets.Count} mods (free accounts must download manually in the browser)");
            if (webTargets.Count == 0 && ghTargets.Count == 0)
            {
                ShowNotice("err", "None of the selected mods has a Nexus ID or GitHub source, so they cannot be updated (mostly local/other-source mods)");
                return;
            }
            if (ghTargets.Count > 0)
            {
                ShowNotice("ok", $"Updating {ghTargets.Count} GitHub-source mods in-app…");
                await RunUpdatePipeline(ghTargets);
            }
            return;
        }

        var targets = selectedMods
            .Where(m => (m.NexusModId is not null || m.GitHubRepo is not null) && !m.Disabled)
            .ToList();
        if (targets.Count == 0)
        {
            ShowNotice("err", "None of the selected mods can be auto-updated (missing Nexus/GitHub update markers, or disabled).");
            return;
        }
        ShowNotice("ok", $"Updating {targets.Count} mods in-app one by one… (runs in the background; you will be notified when done)");
        if (!string.IsNullOrEmpty(_apiKey))
            _ = BackfillCoversAsync();
        await RunUpdatePipeline(targets);
        // v0.68.1: GitHub-source releases without a zip that cannot be installed in-app -> open their download page
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    /// <summary>v0.41.0: back-fill Nexus covers for every mod missing one (disabled mods included).
    /// v0.72.7: per-instance concurrency gate — at most one backfill task runs at a time.
    /// vNext: switched from serial one-by-one fetching to 6-way concurrency (sharing the update-check
    /// concurrency budget) — with dozens of missing covers the old serial version waited through dozens of
    /// network round trips, with covers "popping in" one by one.</summary>
    private int _backfillRunning;

    private async Task BackfillCoversAsync()
    {
        // The old wrapper BackfillCoversCoreAsync recursively called itself in its try block (not the real
        // implementation), so the moment the gate opened it dead-looped and blew the stack — deleted outright;
        // the gate now lives at the top of this method
        if (Interlocked.Exchange(ref _backfillRunning, 1) == 1) return;
        try
        {
            var need = _mods
                .Where(m => m.NexusModId is not null)
                .Where(m => string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                            && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                            && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                .ToList();
            if (need.Count == 0) return;
            var semaphore = new SemaphoreSlim(12);   // v1.06.8: doubled cover-backfill concurrency
            await Task.WhenAll(need.Select(async m =>
            {
                await semaphore.WaitAsync();
                try
                {
                    var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                    if (info is not null && !string.IsNullOrEmpty(info.PictureUrl))
                    {
                        GetState(m.Folder).PictureUrl = info.PictureUrl;
                        Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                        _coversDirty = true;
                    }
                    // v0.46.0: cache the site category along the way (category_id -> name via the NexusCategories table)
                    if (info?.CategoryId is int cid)
                    {
                        GetState(m.Folder).CategoryId = cid;
                        if (Cfg.Current.NexusCategories.TryGetValue(cid, out var cname))
                            Cfg.Current.ModCategories[m.Folder] = cname;
                    }
                }
                catch (Exception ex) { AppLog.Warn("Mods", "Cover backfill failed (" + m.Folder + "): " + ex.Message); }
                finally { semaphore.Release(); }
            }));
            if (_coversDirty)
            {
                Cfg.Save(Cfg.Current);
                _coversDirty = false;
            }
            await InvokeAsync(StateHasChanged);
        }
        finally { Interlocked.Exchange(ref _backfillRunning, 0); }
    }

    // ------------------------------------------------------------------
    // Update checks + auto-update
    // ------------------------------------------------------------------

    private async Task AutoUpdateOnEnterAsync()
    {
        // v0.68.3: auto-update policy on entering the Mods page — decided entirely by the Settings page's
        // "auto-install updates" toggle (EnableAutoInstall, Premium only); no more prompt.
        //  (1) toggle off / free account -> CheckOnlyOne just marks ⇧, never installs
        //  (2) toggle on (Premium)        -> after checking, RunUpdatePipeline installs every updatable mod in-app
        await CheckUpdates();

        if (!Cfg.Current.NexusIsPremium || !Cfg.Current.EnableAutoInstall) return;

        var targets = _mods.Where(IsUpdatable).ToList();
        if (targets.Count == 0) return;
        ShowNotice("ok", $"Auto-updating {targets.Count} mods…");
        await RunUpdatePipeline(targets);
        // GitHub-source releases without a zip asset: open their download pages
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    private async Task CheckUpdates(bool force = false)
    {
        var targets = _mods
            .Where(m => (m.NexusModId is not null || m.GitHubRepo is not null) && !m.Disabled)
            // v0.44.0: skip mods checked within 60 minutes (no request issued right now); their remote version
            // state stays displayed
            // v1.06.7: force=true (top-bar current-page icon refresh) ignores the TTL and re-checks everything —
            // otherwise after installing an older mod version, a refresh within the hour would skip it and
            // "no update found"
            .Where(m => force || !_lastCheckedUtc.TryGetValue(m.Folder, out var t)
                        || DateTime.UtcNow - t > UpdateCheckTtl)
            .ToList();

        // v0.46.0: fetch the official category table on the first update check (requires a key)
        if (!string.IsNullOrEmpty(_apiKey)) _ = EnsureCategoriesAsync();

        // works without a Nexus key too — GitHub-source mods need no key at all
        if (string.IsNullOrEmpty(_apiKey))
            targets = targets.Where(m => m.GitHubRepo is not null).ToList();

        // vNext: nothing to check (all hit the TTL / no key and no GitHub sources) -> return silently
        // instead of flashing the "checking for updates…" state every time you switch back to the page
        if (targets.Count == 0) return;

        // vNext: the list is already visible; the checking state only shows as small header text, no full-page skeleton swap
        _checkingUpdates = true;
        _checkingTick = Environment.TickCount64;
        StateHasChanged();

        // v0.41.0: cover backfill — disabled mods are excluded from update checks, but their covers are still
        // fetched once via Nexus detail to avoid "disable = lose cover". Only the lightweight GetModAsync runs;
        // it caches the PictureUrl and triggers no update logic.
        // vNext: moved to AFTER the check pipeline — the fingerprint fast path already brings most covers back
        // (zero requests in the vast majority of cases); the remainder (failed batches / GitHub sources / disabled
        // rows) fall back to this, no longer competing with version checks for connections and rate-limit windows.
        // v0.68.0: checking uses the "detect-only" pipeline (CheckOnlyOne never downloads or installs);
        // installation only happens via RunUpdatePipeline after user confirmation.
        await RunCheckPipeline(targets);
        if (!string.IsNullOrEmpty(_apiKey))
            _ = BackfillCoversAsync();
    }

    /// <summary>v0.68.0: parallel pipeline that only detects versions — never downloads or installs.
    /// vNext: runs the "fingerprint batch fast path" first — one key-free GraphQL batch call (50 mods/batch)
    /// fetches updatedAt for all Nexus mods and compares it verbatim against persisted fingerprints: mods whose
    /// fingerprints match reuse the latest MAIN file version found by the last precise check (the file list has
    /// not changed, so the result cannot be stale) and the whole batch returns instantly with zero requests.
    /// Only the few mods with changed/missing fingerprints or missing batch results fall through to per-mod
    /// files.json precise checks, whose results (plus new fingerprints) are written back to the cache.
    /// A regular page entry (after app restart / past the 60-minute TTL) collapses from N requests to ~N/50,
    /// and the shimmer skeleton drops from tens of seconds to about 1 second. If the whole batch fails, everything
    /// falls back to precise checks (same behavior as before; slow is preferred over wrong).</summary>
    private async Task RunCheckPipeline(List<ModEntry> targets)
    {
        var precise = targets;
        Dictionary<int, string>? fpUpdatedAt = null;   // modId -> batch fingerprint updatedAt (written back to cache after a precise check succeeds)
        if (!string.IsNullOrEmpty(_apiKey))
        {
            var nexusIds = targets.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToList();
            if (nexusIds.Count > 0)
            {
                var fps = await Nexus.GetModFingerprintsBatchAsync(nexusIds);
                if (fps is not null)
                {
                    fpUpdatedAt = fps.ToDictionary(kv => kv.Key, kv => kv.Value.UpdatedAt);
                    var rest = new List<ModEntry>();
                    foreach (var m in targets)
                    {
                        if (m.NexusModId is int id && fps.TryGetValue(id, out var fp))
                        {
                            _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
                            // grab covers along the way: the batch comes with pictureUrl for free, eliminating most cover-backfill requests
                            if (!string.IsNullOrEmpty(fp.PictureUrl)
                                && string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                                && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                                && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                            {
                                Cfg.Current.ModCovers[m.Folder] = fp.PictureUrl;
                                _coversDirty = true;
                            }
                            if (Cfg.Current.ModUpdateFingerprints.TryGetValue(id, out var cached)
                                && string.Equals(cached.UpdatedAt, fp.UpdatedAt, StringComparison.Ordinal)
                                && !string.IsNullOrWhiteSpace(cached.LatestFileVersion)
                                && DateTime.UtcNow - cached.CheckedAtUtc < FingerprintMaxAge)
                            {
                                // fingerprint match -> remote file list unchanged -> reuse the file version from the last precise check
                                RememberRemoteVersion(m.Folder, cached.LatestFileVersion);
                                _states[m.Folder] = new ModUpdateState
                                {
                                    Status = IsNewer(cached.LatestFileVersion, m.Version) ? "available" : "latest",
                                    RemoteVersion = cached.LatestFileVersion,
                                };
                                continue;
                            }
                        }
                        rest.Add(m);   // fingerprint missing/changed / no cache / GitHub source -> precise check one by one
                    }
                    precise = rest;
                    StateHasChanged();   // paint fast-path results first; precise-check states let the ⇧ markers appear gradually
                }
            }
        }

        if (precise.Count > 0)
        {
            var semaphore = new SemaphoreSlim(32);   // v1.06.8: detect-only (no downloads), so push concurrency to 32
            // vNext: precise-check requests for the same modId are shared across the whole pipeline (a mod installed twice issues only one request)
            var byId = new System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>();
            await Task.WhenAll(precise.Select(async m =>
            {
                await semaphore.WaitAsync();
                try { await CheckOnlyOne(m, byId, fpUpdatedAt); }
                finally { semaphore.Release(); }
            }));
        }

        if (_fpDirty)
        {
            // prune fingerprints of uninstalled mods so the cache does not grow without bound
            var liveIds = _mods.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToHashSet();
            foreach (var staleId in Cfg.Current.ModUpdateFingerprints.Keys.Where(id => !liveIds.Contains(id)).ToList())
                Cfg.Current.ModUpdateFingerprints.Remove(staleId);
        }
        if (_coversDirty || _fpDirty)
        {
            Cfg.Save(Cfg.Current);
            _coversDirty = false;
            _fpDirty = false;
        }
        // vNext: the list stays visible during checks (no more skeleton swap); the artificial 0.6s minimum delay was removed
        _checkingUpdates = false;
        StateHasChanged();
    }

    /// <summary>
    /// v0.68.0: "detect-only" for a single mod — fetches the remote version + cover + category;
    /// if an update exists it only sets the ⇧ marker and never starts a download or install.
    /// (Split out of UpdateOne: separating check from install is the prerequisite for "ask before updating")
    /// </summary>
    private async Task CheckOnlyOne(ModEntry m,
        System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>? sharedFetch = null,
        IReadOnlyDictionary<int, string>? fpUpdatedAt = null)
    {
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        try
        {
            // v0.68.2: check the Nexus source first; only fall back to GitHub when there is no Nexus source or the fetch fails
            // v0.72.0: detection source unified with the install source — the version of the latest MAIN file in
            // files.json is authoritative (the same source as UpdateOne / one-click install's GetLatestMainFileAsync).
            // The old logic read the top-level version of mods/{id}.json (author-maintained, often lagging the main
            // file), which caused the contradiction "1.3.0 local judged up to date, yet clicking update installs 1.3.1".
            if (m.NexusModId is not null && !string.IsNullOrEmpty(_apiKey))
            {
                // vNext: precise-check results are shared within the pipeline for the same modId — a mod installed
                // twice (current + stale copy) issues a single files.json request and both rows share the result
                NexusFileInfo? file;
                if (sharedFetch is not null)
                    file = await sharedFetch.GetOrAdd(m.NexusModId!.Value,
                        k => Nexus.GetLatestMainFileAsync(_apiKey, k));
                else
                    file = await Nexus.GetLatestMainFileAsync(_apiKey, m.NexusModId!.Value);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // fallback when the main file has no version: use the mod's top-level version (also grabbing
                    // the cover; routine cover gaps are BackfillCoversAsync's job, so no extra requests here)
                    var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }
                if (remoteVer is not null)
                {
                    st.RemoteVersion = remoteVer;
                    RememberRemoteVersion(m.Folder, remoteVer);
                    st.Status = IsNewer(remoteVer, m.Version) ? "available" : "latest";
                    // vNext: on precise-check success, persist the result together with this round's batch updatedAt
                    // fingerprint; next entry with an unchanged fingerprint reuses this version directly (the data
                    // source behind the fast path's zero-request hits)
                    if (fpUpdatedAt is not null && fpUpdatedAt.TryGetValue(m.NexusModId!.Value, out var ua))
                    {
                        Cfg.Current.ModUpdateFingerprints[m.NexusModId!.Value] = new ModUpdateFingerprintEntry
                        {
                            UpdatedAt = ua,
                            LatestFileVersion = remoteVer,
                            CheckedAtUtc = DateTime.UtcNow,
                        };
                        _fpDirty = true;
                    }
                    StateHasChanged();
                    return;
                }
            }

            // GitHub fallback: mods with no Nexus source (or whose Nexus query failed)
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    st.Status = IsNewer(gh.Tag, m.Version) ? "available" : "latest";
                    StateHasChanged();
                    return;
                }
            }

            if (st.Status is "checking")
                st.Status = st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version)
                    ? "available" : "latest";
        }
        catch (Exception ex)
        {
            st.Status = "failed"; st.Message = ex.Message;
        }
        StateHasChanged();
    }

    private async Task RunUpdatePipeline(List<ModEntry> targets)
    {
        StateHasChanged();

        // v0.60.0: run version detection in parallel (concurrency speedup) so one slow/timing-out source cannot drag the whole page's update states.
        var semaphore = new SemaphoreSlim(16);
        await Task.WhenAll(targets.Select(async m =>
        {
            await semaphore.WaitAsync();
            try { await UpdateOne(m); }
            finally { semaphore.Release(); }
        }));

        if (_coversDirty)
        {
            Cfg.Save(Cfg.Current);   // persist the covers picked up along the way
            _coversDirty = false;
        }

        _checkingUpdates = false;

        var states = targets.Select(t => GetState(t.Folder)).ToList();
        var updated = states.Count(s => s.Status == "updated");
        var failed = states.Count(s => s.Status == "failed");
        var premiumBlocked = states.Count(s => s.Status == "premium");
        if (updated > 0) Rescan();
        // v0.68.0: merge into a single completion summary (the old two toasts kept displacing each other),
        // and give clear feedback when premium-blocked (a free account that slipped into the pipeline) — no more "nothing happens"
        var manualGh = states.Count(s => s.Status == "available");
        if (updated > 0 || failed > 0 || premiumBlocked > 0 || manualGh > 0)
            ShowNotice(failed == 0 && premiumBlocked == 0 ? "ok" : "err",
                $"Auto-updated {updated} mods ✔"
                + (failed > 0 ? $", {failed} failed (see each row's message)" : "")
                + (premiumBlocked > 0 ? $", {premiumBlocked} require Premium (use the row update button to download manually on the site)" : "")
                + (manualGh > 0 ? $", {manualGh} releases have no install package — download page opened / use the row ⇧ to update manually" : ""));

        // vNext: the artificial 0.6s "loading feel" delay was removed — updating states render in-row in real time

        StateHasChanged();
    }

    private async Task UpdateOne(ModEntry m)
    {
        // v0.61.0: keep the old RemoteVersion when creating a new state, so the updatable list is not wiped and rebuilt mid-check (flicker)
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        StateHasChanged();
        try
        {
            // ── (1) Nexus source first (v0.68.2): mods with a Nexus source always detect and download via Nexus,
            //    so dual-source mods like SDV-Glow are no longer snatched by the GitHub source
            //    (free users' batch updates can also open Nexus pages) ──
            if (m.NexusModId is not null && !string.IsNullOrEmpty(_apiKey))
            {
                // v0.72.0: resolve the "latest MAIN file" first; detection and installation share this one authoritative source.
                // The old logic detected via the mods/{id}.json top-level version but only consulted the files.json main
                // file at install time, so mismatched versions produced "no update detected, yet updating installs a higher version".
                var file = await Nexus.GetLatestMainFileAsync(_apiKey, m.NexusModId!.Value);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // fallback when the main file has no version: use the mod's top-level version (grabbing the cover too)
                    var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }

                if (remoteVer is not null)
                {
                    st.RemoteVersion = remoteVer;
                    RememberRemoteVersion(m.Folder, remoteVer);

                    if (IsNewer(remoteVer, m.Version))
                    {
                        // ── new version found -> auto-download & install via the Nexus direct link, no site redirect ──
                        if (file is null)
                        {
                            // judged updatable but no downloadable file -> mark as available for the in-row ⇧ manual path instead of hard-failing
                            st.Status = "available"; st.Message = null;
                            StateHasChanged(); return;
                        }
                        st.Status = "updating";
                        st.Message = $"New version {remoteVer} found (Nexus source), auto-updating…";
                        StateHasChanged();

                        var dl = await Nexus.GetDownloadUrlAsync(_apiKey, m.NexusModId!.Value, file.FileId);
                        if (dl.NeedsPremium)
                        {
                            st.Status = "premium";
                            st.Message = null;   // minimal: only the purple ⇧ new tag next to the version; no extra yellow text
                            StateHasChanged(); return;
                        }
                        if (dl.Url is null)
                        {
                            st.Status = "failed"; st.Message = "Failed to get download URL: " + dl.Error;
                            StateHasChanged(); return;
                        }

                        var zip = Path.Combine(StoragePaths.DownloadsDir,
                            $"mod-{m.NexusModId}-{file.FileId}.zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(zip)!);
                        await DownloadWithTask(
                            dl.Url, zip,
                            $"Update mod \"{m.Name}\"",
                            $"Downloading {m.Name}…",
                            (msg, pct, spd) => { st.Message = msg; StateHasChanged(); });

                        var err = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, zip, out var newVer);
                        if (err is null)
                        {
                            st.Status = "updated";
                            st.Message = null;   // v0.60.0: no green message row after a successful update
                            // v0.69.0: record the download date (used by the detail page's "last downloaded")
                            Cfg.Current.ModLastDownload[m.NexusModId!.Value.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            Cfg.Current.ModFileLastDownload[file.FileId.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            Cfg.Save(Cfg.Current);
                        }
                        else
                        {
                            st.Status = "failed"; st.Message = "Install failed: " + err;
                        }
                        StateHasChanged();
                        return;
                    }

                    // already latest on Nexus: dual-source mods keep checking GitHub as a fallback; Nexus-only mods conclude here
                    if (m.GitHubRepo is null)
                    {
                        st.Status = "latest"; st.Message = null;
                        StateHasChanged(); return;
                    }
                }
            }

            // ── (2) GitHub fallback: GitHub-only mods (no Nexus source), or dual-source mods whose Nexus query failed ──
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    if (IsNewer(gh.Tag, m.Version) && gh.ZipUrl is not null)
                    {
                        st.Status = "updating";
                        st.Message = $"New version {gh.Tag} found (GitHub source), auto-updating…";
                        StateHasChanged();

                        var ghZip = Path.Combine(StoragePaths.DownloadsDir,
                            "gh-" + m.GitHubRepo.Replace('/', '-') + ".zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(ghZip)!);
                        await DownloadWithTask(
                            gh.ZipUrl, ghZip,
                            $"Update mod \"{m.Name}\"",
                            $"Downloading {m.Name} (GitHub source)…",
                            (msg, pct, spd) => { st.Message = msg; StateHasChanged(); });

                        // expectedUniqueId safety lock: prevents installing into the wrong mod when several share a repo
                        var ghErr = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, ghZip,
                            out var ghNewVer,
                            expectedUniqueId: string.IsNullOrEmpty(m.UniqueID) ? null : m.UniqueID);
                        if (ghErr is null)
                        {
                            st.Status = "updated";
                            st.Message = null;
                        }
                        else
                        {
                            st.Status = "failed";
                            st.Message = "GitHub update failed: " + ghErr;
                        }
                        StateHasChanged();
                        return;
                    }
                    if (IsNewer(gh.Tag, m.Version))
                    {
                        st.Status = "available";
                        st.Message = $"GitHub {gh.Tag}";
                        StateHasChanged();
                        return;
                    }
                }
            }

            // no update from either source / both queries failed -> keep the existing remote marker or conclude "latest"
            if (st.Status is "checking")
            {
                st.Status = st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version)
                    ? "available" : "latest";
                st.Message = null;
            }
        }
        catch (Exception ex)
        {
            st.Status = "failed"; st.Message = ex.Message;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Mod downloads also go through the task center (bottom-right task pill + /tasks page),
    /// sharing the same download page as the SMAPI update. Reports percent/speed/current step while downloading.
    /// </summary>
    private async Task DownloadWithTask(
        string url, string zipPath, string taskTitle, string startMsg,
        Action<string, double?, double?>? onTick = null)
    {
        var task = Center.Start(taskTitle, "download");
        try
        {
            Center.Report(task, startMsg, 0, 0);
            onTick?.Invoke(startMsg, null, null);
            var progress = new Progress<NexusDownloadProgress>(p =>
                _ = InvokeAsync(() =>
                {
                    Center.Report(task, p.Message, p.Percent, p.SpeedMBps);
                    onTick?.Invoke(p.Message, p.Percent, p.SpeedMBps);
                }));
            await Nexus.DownloadFileAsync(url, zipPath, progress);
            Center.Finish(task, true, "Download complete");
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, ex.Message);
            throw;
        }
    }

    /// <summary>
    /// One-click SMAPI auto-update: downloads the official installer in the background -> runs
    /// SMAPI.Installer.exe unattended (--install --no-prompt --game-path).
    /// No windows pop up and no browser opens; the state refreshes automatically when done.
    /// </summary>
    /// <summary>v0.36.0: one-click download & install when SMAPI is missing — shares the same fully automatic
    /// installer with UpdateSmapi (RunSmapiInstallerAsync just downloads the zip and deploys files silently);
    /// no manual steps required from the user.</summary>
    private async Task InstallSmapi()
    {
        if (_smapiUpdating) return;
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null || _smapiUpdate.InstallerZipUrl is null)
        {
            ShowNotice("err", "SMAPI download URL not available yet; try again later (or check your network).");
            return;
        }

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "install");
        var progress = new Progress<UpdateService.InstallProgress>(p =>
            _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));

        // jump to the tasks page to watch live progress
        Nav.NavigateTo("/tasks");

        try
        {
            var err = await Updater.RunSmapiInstallerAsync(
                _smapiUpdate, Cfg.Current.GamePath, progress);

            if (err is null)
            {
                Center.Finish(task, true, $"✅ SMAPI {_smapiUpdate.LatestVersion} installed");
                _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath);
                _smapiUpdate = await Updater.CheckSmapiAsync(_smapiVersion);
                // rescan the mod list after installing (SMAPI's bundled ConsoleCommands/SaveBackup will appear in it)
                _ = InvokeAsync(RescanAndRestate);
            }
            else
            {
                Center.Finish(task, false, "❌ " + err);
            }
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, "❌ " + ex.Message);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateSmapi()
    {
        if (_smapiUpdating) return;
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null) return;

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "update");
        var progress = new Progress<UpdateService.InstallProgress>(p =>
            _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));

        // jump to the tasks page immediately to watch progress (the bottom-right pill updates in sync)
        Nav.NavigateTo("/tasks");

        try
        {
            var err = await Updater.RunSmapiInstallerAsync(
                _smapiUpdate, Cfg.Current.GamePath, progress);

            if (err is null)
            {
                Center.Finish(task, true, $"✅ SMAPI updated to {_smapiUpdate.LatestVersion}");
                _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath);
                _smapiUpdate = await Updater.CheckSmapiAsync(_smapiVersion);
            }
            else
            {
                Center.Finish(task, false, "❌ " + err);
            }
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, "❌ " + ex.Message);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>v0.68.1: open the mod's download page (GitHub releases first, then the Nexus files page).</summary>
    private static void OpenUpdateDownloadPage(ModEntry m)
    {
        if (m.GitHubRepo is not null)
            UpdateService.OpenUrl($"https://github.com/{m.GitHubRepo}/releases/latest");
        else if (m.NexusModId is not null)
            UpdateService.OpenUrl($"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }

    private void ShowNotice(string kind, string text)
    {
        // v0.43.1: success/delete -> black toast with white text; errors -> red toast with white text; everything is also logged
        if (kind == "err") AppLog.Error("Mods", text); else AppLog.Warn("Mods", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, kind == "err" ? "err" : "ok");
    }

    private static bool IsNewer(string remote, string local)
    {
        // v0.71.8: numeric per-segment semantic version comparison. The old logic degraded to
        // "string inequality = update available" whenever Version.TryParse failed — pre-release suffixes
        // (0.2.8-beta), four-part versions (0.2.8.1), or space/hyphen differences could misjudge identical
        // versions as updatable (the root cause of Event Lookup showing an update button while already current).
        // Now the v/V prefix and -beta-style suffixes are stripped, segments are compared numerically,
        // missing segments are padded with 0; full equality -> not an update.
        static int[] Parts(string v)
        {
            var s = v.Trim().TrimStart('v', 'V');
            var dash = s.IndexOfAny(new[] { '-', '+', ' ' });   // strip pre-release/build metadata
            if (dash >= 0) s = s[..dash];
            var segs = s.Split('.', StringSplitOptions.RemoveEmptyEntries);
            var nums = new int[segs.Length];
            for (var i = 0; i < segs.Length; i++)
            {
                var digits = new string(segs[i].TakeWhile(char.IsDigit).ToArray());
                nums[i] = int.TryParse(digits, out var n) ? n : 0;
            }
            return nums;
        }
        var rp = Parts(remote); var lp = Parts(local);
        var len = Math.Max(rp.Length, lp.Length);
        for (var i = 0; i < len; i++)
        {
            var r = i < rp.Length ? rp[i] : 0;
            var l = i < lp.Length ? lp[i] : 0;
            if (r != l) return r > l;
        }
        return false;   // numerically identical -> not an update
    }
}
