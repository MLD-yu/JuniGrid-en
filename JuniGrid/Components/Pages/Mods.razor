    /// <summary>The mod list after filter + search are applied.</summary>
    private IReadOnlyList<ModEntry> FilteredMods
    {
        get
        {
            IEnumerable<ModEntry> q = _mods;
            switch (_filter)
            {
                case "enabled": q = q.Where(m => !m.Disabled); break;
                case "disabled": q = q.Where(m => m.Disabled); break;
                case "updatable":
                    q = q.Where(m => IsUpdatable(m));
                    break;
                case "missing":
                    // v1.1.4: missing-deps filter — includes a missing ContentPackFor host (SMAPI skips those too)
                    q = q.Where(m => MissingDeps(m).Count > 0);
                    break;
            }
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var s = SearchText.Trim();
                // purely numeric input is fuzzy-matched against the Nexus mod ID (NexusModId) — 4964794 or just 9647 both find it.
                bool numeric = int.TryParse(s, out _);
                // v1.1.4: remark and original names both participate in search — the list title shows
                // "Remark(Original)", so searching either part must find the mod (remarks live in config, not m.Name)
                var remarks = Cfg.Current.ModRemarks;
                var originals = Cfg.Current.ModOriginalNames;
                q = q.Where(m =>
                    m.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.Author.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.UniqueID.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (remarks.TryGetValue(m.Folder, out var rk) && rk.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (originals.TryGetValue(m.Folder, out var og) && og.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (numeric && m.NexusModId is not null
                        && m.NexusModId.Value.ToString().Contains(s, StringComparison.Ordinal)));
            }
            return q.ToList();
        }
    }

