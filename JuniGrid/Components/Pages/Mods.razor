    // v0.36.0: mod list AnimatedList scroll effect (scale/opacity when entering the viewport + top/bottom fade)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v0.71.1: restore the scroll position when returning from the detail page — setScrollWhenReady polls until the container is tall enough
        // v0.72.0: carries the at-bottom flag from when we left, so the restorer no longer guesses the bottom via y>limit
        var dedicatedRan = false;
        if (!_initialLoading && _restoreScroll >= 0)
        {
            dedicatedRan = true;   // v1.06.8: this pass used the dedicated snapshot restore; the firstRender fallback must yield
            _entryRestoreRan = true;
            var y = _restoreScroll;
            var atBottom = _restoreAtBottom;
            _restoreScroll = -1;
            _restoreAtBottom = false;
            _scrollRestoreClassPending = false;
            AppLog.Warn("Mods", $"[Diag] scroll restore start y={y} atBottom={atBottom}");
            try
            {
                var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, atBottom, reporter);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[Diag] scroll restore call failed: " + ex.Message);
                try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
            }
        }
        else if (!_initialLoading && _scrollRestoreClassPending)
        {
            // v0.72.4: back on the list with the restore-pending flag but no snapshot to restore
            // (e.g. clicking top nav from the detail page and returning) -> remove the hide flag and show the list normally
            _scrollRestoreClassPending = false;
            _entryRestoreRan = true;
            try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
        }
        // v1.1.4: re-bind the entrance-animation observers after every list render. The old filter/search path via
        // _skipListAnimOnce only unbound without rebinding, so new result rows lost their scroll effects and never
        // recovered even back on "All". animatedListInit skips already-bound rows at zero cost (__alBound) and only
        // measures new/unbound rows — no perceptible overhead per-frame render.
        if (!_initialLoading)
        {
            try { await JS.InvokeVoidAsync("junigridJs.animatedListInit", ".jg-main", ".jg-modrows"); } catch { }
        }
        if (firstRender)
        {
            // v0.45.0: remember the /mods scroll position — returning from the detail page restores the previous
            // scroll height instead of jumping back to the top
            try { await JS.InvokeVoidAsync("junigridJs.scrollSpy", ".jg-main", "modslist", false); } catch { }
        }

        // vNext: entering the page always restores the position we left at — no longer limited to popstate returns.
        // Coming back from another page via a nav icon (forward navigation) restores too: scrollSpy keeps writing the
        // leave position to the modslist key, which we simply read here. On cold start sessionStorage is empty (y≈0)
        // so nothing restores; a manual refresh doesn't rebuild the component and skips this. The dedicated snapshot
        // (detail-page return) takes priority.
        // vNext: only run after the list is really visible (_initialLoading=false) — marking "restore pending" during
        // the skeleton phase would hide the skeleton itself too (.jg-modrows-skeleton shares the class).
        if (!_initialLoading && !_entryRestoreRan)
        {
            _entryRestoreRan = true;
            if (!dedicatedRan && _restoreScroll < 0)
            {
                try
                {
                    var y = await JS.InvokeAsync<double>("junigridJs.readScrollKey", "modslist");
                    if (y > 1)
                    {
                        AppLog.Warn("Mods", $"[Diag] entry restore (generic) y={y}");
                        // first set the restore-pending hide flag (.jg-main persists across navigation); setScrollWhenReady
                        // un-hides it in the same frame once positioned, avoiding a one-frame flash of the list at the top
                        await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                        var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                        await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, false, reporter);
                    }
                }
                catch (Exception ex)
                {
                    AppLog.Error("Mods", "[Diag] generic entry restore failed: " + ex.Message);
                    try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
                }
            }
        }
    }

    /// <summary>vNext: gate so the generic entry restore runs once (not during the skeleton phase; on the first render after the list shows).</summary>
    private bool _entryRestoreRan;

    /// <summary>v1.1.5: clicking a group header = select/deselect all sub-packages of that bundle (clears when fully selected).
