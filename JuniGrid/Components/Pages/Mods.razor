@namespace JuniGrid.Components.Pages
@page "/mods"
@inject ConfigService Cfg
@inject ModService ModSvc
@inject GameService Game
@inject UpdateService Updater
@inject NexusService Nexus
@inject InstallService Installer
@inject UpdateQueueService Queue
@inject PageRefreshService PageRefresh
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaskCenterService Center
@inject CoverCacheService Covers
@implements IDisposable

<div class="jg-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                <h1 style="margin-top:0;margin-bottom:4px">Mod Management</h1>
                @* v1.07.3: plain folder icon, opens the Mods directory on click; data-tip uses the same pill tooltip style as the nav bar *@
                <button class="jg-mods-folder-btn" data-tip="Open mods folder" aria-label="Open mods folder"
                        @onclick="OpenModsRootFolder">
                    <svg viewBox="0 0 1024 1024" width="32" height="32" fill="#f2b544">
                        <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"/>
                    </svg>
                </button>
            </div>
            <div style="opacity:.7;font-size:13px">
                @* v1.08: the skeleton screen only covers the disk-scan phase; the list keeps rendering during update checks *@
                @if (_initialLoading) { <span>Loading mod list…</span> }
                else { <text>@_mods.Count total (@_mods.Count(m => !m.Disabled) enabled)</text> }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            @* v0.47.0: profile dropdown moved to the far right; GSAP easeReverse elastic open/close (after the official demo) *@
            <div class="jg-profile-dd @(_profileOpen ? "open" : "")" data-dd="profile">
                @* v0.71.4: rename moved to the right of the dropdown button — clicking the pencil turns the button into an input and the pencil into confirm; renaming happens only in this one place *@
                @if (_renamingProfile is not null)
                {
                    <input class="jg-profile-input jg-profile-headinput" maxlength="30"
                           value="@_renameBuffer"
                           @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnRenameKey(e, _renamingProfile!)"
                           @onclick:stopPropagation />
                    <button class="jg-profile-headconfirm" data-tip="Confirm" aria-label="Confirm"
                            @onclick="() => ConfirmRename(_renamingProfile!)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="jg-sort-trigger" @onclick="ToggleProfile">
                        @ActiveProfileName
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (ActiveProfileName != "Default")
                    {
                        <button class="jg-profile-rename jg-profile-headrename" data-tip="Rename" aria-label="Rename"
                                @onclick="() => StartRenameProfile(ActiveProfileName)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                <path d="m15 5 4 4"/>
                            </svg>
                        </button>
                    }
                }
                <div class="jg-sort-menu jg-profile-menu">
                    @foreach (var p in AllProfiles)
                    {
                        <div class="jg-profile-item @(p.Name == ActiveProfileName ? "active" : "")">
                            @* v0.71.4: menu items only switch/delete; renaming is always started from the pencil entry to the right of the dropdown button *@
                            <button class="jg-profile-name"
                                    @onclick="() => ApplyProfileKeepOpen(p.Name)">@p.Name</button>
                            @if (p.Name != "Default")
                            {
                                <button class="jg-profile-del" @onclick="() => AskDeleteProfile(p.Name)">×</button>
                            }
                        </div>
                    }
                    <div class="jg-profile-item">
                        @if (_addingProfile)
                        {
                            <input class="jg-profile-input" placeholder="Profile name" maxlength="30"
                                   @bind="_newProfileName" @bind:event="oninput" />
                            <button class="jg-profile-name" style="font-weight:600;flex:none" @onclick="ConfirmAddProfile">Confirm</button>
                        }
                        else
                        {
                            @* dashed pill + hover pill tooltip (same data-tip style as the nav bar) *@
                            <button class="jg-profile-addcap" data-tip="New profile" aria-label="New profile" @onclick="StartAddProfile">
                                <span class="plus">+</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── SMAPI is always shown first (with its own exe icon, not an emoji) ── *@
    <div class="jg-card jg-smapi-card" style="margin-top:12px">
        <div style="display:flex;align-items:center;gap:12px">
            @* v0.37.0: fall back to the bundled pufferchick when no icon can be extracted from the exe; no more gray S placeholder *@
            @if (_smapiIcon is not null)
            {
                <img class="jg-modrow-icon" src="@_smapiIcon" alt="SMAPI" />
            }
            else
            {
                <img class="jg-modrow-icon" src="assets/smapi-pufferchick.svg" alt="SMAPI"
                     style="border-radius:8px;background:var(--jg-card);padding:2px" />
            }
            <div style="min-width:0;flex:1">
                <div style="font-weight:700">
                    SMAPI
                    <span style="opacity:.6;font-weight:400;font-size:12px">Mod loader</span>
                </div>
                <div style="opacity:.75;font-size:12.5px;margin-top:3px">
                    @if (_smapiVersion is null)
                    {
                        @* v0.36.0: dedicated hint shown when SMAPI is not installed *@
                        @if (_smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>Not installed · latest version @_smapiUpdate.LatestVersion — use the button on the right to download and install in one click</span>
                        }
                        else if (_smapiUpdate is { Error: not null })
                        {
                            <span style="color:#c50f1f">Not installed · failed to fetch version info (@_smapiUpdate.Error)</span>
                        }
                        else
                        {
                            <span>Not installed · fetching the latest version…</span>
                        }
                    }
                    else
                    {
                        <text>Current version: @SmapiDisplay</text>
                        @if (_smapiUpdate is { HasUpdate: true })
                        {
                            <span style="color:#b4009e;font-weight:600"> ⇧ New version @_smapiUpdate.LatestVersion available</span>
                        }
                    }
                </div>
            </div>
            @* v0.36.0: not installed -> one-click download & install; installed with update -> update. Both paths go through the same fully automatic installer *@
            @if (_smapiVersion is null && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? "Installing…" : $"⬇ Download and install SMAPI {_smapiUpdate.LatestVersion}")
                </button>
            }
            else if (_smapiUpdate is { HasUpdate: true })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="UpdateSmapi">
                    @(_smapiUpdating ? "Updating…" : $"⬇ Update to {_smapiUpdate.LatestVersion}")
                </button>
            }
        </div>
    </div>

    @if (_mods.Count == 0)
    {
        <div class="jg-card" style="margin-top:12px">
            The Mods folder is empty or the game hasn't been located. Pick the game directory in Settings first.
        </div>
    }

    @* ── v0.34.0 toolbar: sort first -> filter chips -> search (expands rightward on click, SVG icon) ── *@
    <div class="jg-mods-toolbar">
        <div class="jg-sort-dd @(_sortOpen ? "open" : "")" data-dd="sort">
            <button class="jg-sort-trigger" @onclick="ToggleSort">
                Sort by
                <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(_sortMode == "time-asc" ? "active" : "")" @onclick='() => SetSort("time-asc")'>Newest first</button>
                <button class="jg-sort-item @(_sortMode == "time-desc" ? "active" : "")" @onclick='() => SetSort("time-desc")'>Oldest first</button>
                <button class="jg-sort-item @(_sortMode == "alpha" ? "active" : "")" @onclick='() => SetSort("alpha")'>Alphabetical</button>
            </div>
        </div>
        @* v1.1.2: overlay moved to a permanent DOM element with a state-bound class (the old @if render lagged one
           frame behind JS dropdownToggle's same-frame .open flip, so outside clicks couldn't close the menu) *@
        <div class="jg-dd-overlay" data-dd="sort" @(_sortOpen ? "open" : "") @onclick="CloseSort"></div>
        <div class="jg-chips" role="group" style="align-items:center">
        @foreach (var f in _filterOptions)
        {
            <button class="jg-chip @(_filter == f.Key ? "active" : "")"
                    style="@(f.Key == "updatable" && FailedCheckCount > 0 ? "position:relative" : "")"
                    @onclick="() => SetFilter(f.Key)">
                @f.Label<span style="opacity:.7;font-weight:400"> · @CountFor(f.Key)</span>
                @if (f.Key == "updatable" && FailedCheckCount > 0)
                {
                    @* v1.08: mods with a failed check -> small red dot on the top-right corner of the Updatable chip *@
                    <span style="position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:#e81123;box-shadow:0 0 0 2px var(--jg-bg)"></span>
                }
            </button>
        }
        @if (FailedCheckCount > 0)
        {
            <span style="font-size:12px;color:#c50f1f;opacity:.85;white-space:nowrap">Update check timed out — check your network (@FailedCheckCount incomplete)</span>
        }
        else if (_checkingUpdates)
        {
            <span style="font-size:12px;opacity:.6;white-space:nowrap">Checking for updates…</span>
        }
        </div>
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt="Search" style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder="Search mod name / Nexus ID"
                       @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>

    @* ── v1.2.0: missing-dependency banner + one-click install ── *@
    @if (!_initialLoading && TotalMissingUids.Count > 0)
    {
        <div class="jg-card" style="margin-top:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;border-left:3px solid #f2b544">
            <span style="font-size:13px">
                Detected <b>@TotalMissingUids.Count</b> missing dependencies affecting @MissingAffectedMods mods
            </span>
            <button class="jg-pill-dark" style="padding:7px 16px;font-size:12.5px"
                    disabled="@(_depInstalling || Installer.Busy)"
                    @onclick="() => AskInstallMissingDeps(null)">
                @(_depInstalling ? "Installing… (see the task in the bottom-right corner)" : "Install missing dependencies")
            </button>
            <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px"
                    @onclick='() => SetFilter("missing")'>View list</button>
            @if (_depError is not null)
            {
                <span style="color:#c50f1f;font-size:12.5px">@_depError</span>
            }
        </div>
    }

    @* ── single-row mod list ── *@
    @* v1.06.9: on first load or while an update check is running, always show the shimmer skeleton; the real list stays display:none *@
    @if (_initialLoading)
    {
        <div class="jg-modrows jg-modrows-skeleton">
            @for (var i = 0; i < 8; i++)
            {
                <div class="jg-modrow-shimmer">
                    <div class="jg-shimmer jg-shimmer-avatar"></div>
                    <div class="jg-shimmer-lines">
                        <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                        <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                    </div>
                    <div class="jg-shimmer jg-shimmer-pill"></div>
                </div>
            }
        </div>
    }
    <div class="jg-modrows" style="@(_initialLoading ? "display:none" : "")">
        @foreach (var group in Groups)
        {
            @if (group.Key != "")
            {
                // v1.1.5: groups are no longer collapsible and always fully expanded. Clicking a group header =
                // select/deselect the whole bundle; the count shows "(X items)" or "(X items, Y selected)" depending on selection.
                var selInGroup = group.Items.Count(m => _selected.Contains(m.Folder));
                <div class="jg-group-head" @onclick="() => ToggleGroupSelection(group.Items)">
                    <span style="font-weight:600">@group.Key</span>
                    <span style="opacity:.55;font-size:11.5px">@(selInGroup > 0 ? $"({group.Items.Count} items, {selInGroup} selected)" : $"({group.Items.Count} items)")</span>
                    @if (group.Missing.Count > 0)
                    {
                        <span style="color:#c50f1f;font-size:11.5px"> Missing dependencies: @group.Missing.Count</span>
                    }
                </div>
            }

            @foreach (var (m, mi) in group.Items.Select((x, i) => (x, i)))
            {
                    var st = GetState(m.Folder);
                    var cover = GetCover(m);
                    var missing = MissingDeps(m);
                    <div class="jg-modrow @(_selected.Contains(m.Folder) ? "selected" : "")"
                         @key="@($"{m.Folder}#{mi}")"
                         data-al
                         @onclick="() => ToggleSelect(m.Folder)">

                        @if (cover is not null)
                        {
                            <img class="jg-modrow-icon" src="@cover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                            </div>
                        }

                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@RemarkName(m)</span>
                                <span class="divider">|</span>
                                <span class="ver">@m.Version</span>
                                @if (st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version))
                                {
                                    <span class="upd">⇧ @st.RemoteVersion</span>
                                }
                                else if (st.Status is "updating")
                                {
                                    <span class="upd">⇧ Updating…</span>
                                }
                                @if (m.Disabled)
                                {
                                    <span class="jg-tag">Disabled</span>
                                }
                                @if (!m.HasManifest)
                                {
                                    <span class="jg-tag" style="background:rgba(232,17,35,.12);color:#c50f1f">No manifest</span>
                                }
                            </div>
                            <div class="jg-modrow-desc">
                                @if (GetNexusCategory(m) is { } _cat)
                                {
                                    <span class="jg-cat">@_cat</span>
                                }
                                @(string.IsNullOrWhiteSpace(m.Description) ? m.Folder : m.Description)
                            </div>
                            @if (missing.Count > 0)
                            {
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    Missing dependencies: @string.Join(", ", missing)
                                </div>
                            }
                            @* v1.08: failed/timed-out checks no longer show red text in the row; consolidated into the filter bar hint *@
                        </div>

                        @* ── action buttons revealed on hover ── *@
                        <div class="jg-modrow-actions">
                            @if (missing.Count > 0)
                            {
                                @* v1.2.0: row-level one-click dependency install — installs only what this row is missing (including transitive deps) *@
                                <button class="jg-rowbtn" data-tip="Install missing dependencies"
                                        @onclick:stopPropagation @onclick="() => AskInstallMissingDeps(missing)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 3v11"/>
                                        <path d="m7 10 5 5 5-5"/>
                                        <path d="M4 19h16"/>
                                    </svg>
                                </button>
                            }
                            @if (m.NexusModId is not null
                                 && st.RemoteVersion is not null
                                 && IsNewer(st.RemoteVersion, m.Version))
                            {
                                @* v0.41.0: show the update button only when a newer version is confirmed; never render it when already up to date (st.RemoteVersion is null or not newer) *@
                                <button class="jg-rowbtn upd"
                                        data-tip="Update"
                                        @onclick:stopPropagation @onclick="() => OpenUpdatePage(m)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 1024 1024" aria-hidden="true">
                                        <path d="M512 68.571429a441.897143 441.897143 0 1 1-172.571429 34.822857A440.514286 440.514286 0 0 1 512 68.571429m0-68.571429C229.234286 0 0 229.234286 0 512s229.234286 512 512 512 512-229.234286 512-512S794.765714 0 512 0z"/>
                                        <path d="M709.291429 409.142857L541.394286 230.137143a34.205714 34.205714 0 0 0-29.108572-16.102857h-0.708571a34.285714 34.285714 0 0 0-29.234286 16.125714L314.685714 409.142857a34.285714 34.285714 0 0 0 50.057143 46.857143L477.714286 335.462857v440.228572a34.285714 34.285714 0 0 0 68.571428 0V335.508571L659.28 456a34.285714 34.285714 0 0 0 50.011429-46.857143z"/>
                                    </svg>
                                </button>
                            }
                            @if (m.NexusModId is not null)
                            {
                                <button class="jg-rowbtn" data-tip="Mod details"
                                        @onclick:stopPropagation @onclick="() => OpenDetail(m)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 1024 1024" aria-hidden="true">
                                        <path d="M182.044444 256m-28.444444 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 199.111111c-34.133333 0-56.888889 22.755556-56.888888 56.888889s22.755556 56.888889 56.888888 56.888889 56.888889-22.755556 56.888889-56.888889-22.755556-56.888889-56.888889-56.888889z"/>
                                        <path d="M182.044444 512m-28.444444 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 455.111111c-34.133333 0-56.888882 22.755556-56.888882 56.888889s22.755549 56.888882 56.888882 56.888882 56.888882-22.755549 56.888882-56.888882-22.755549-56.888882-56.888882-56.888882z"/>
                                        <path d="M182.044444 768m0 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 711.111111c-34.133333 0-56.889333 22.755556-56.889333 56.888889s22.756 56.888889 56.889333 56.888889 56.889333-22.755556 56.889333-56.888889-22.756-56.888889-56.889333-56.888889z"/>
                                        <path d="M381.155556 256h512"/>
                                        <path d="M893.155556 284.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                        <path d="M381.155556 512h512"/>
                                        <path d="M893.155556 540.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                        <path d="M381.155556 768h512"/>
                                        <path d="M893.155556 796.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                    </svg>
                                </button>
                            }
                            <button class="jg-rowbtn" data-tip="Remark / rename"
                                    @onclick:stopPropagation @onclick="() => OpenRemark(m)">
                                <img class="jg-rowbtn-icon" src="assets/actions/rename.svg" alt="" draggable="false" />
                            </button>
                            <button class="jg-rowbtn" data-tip="Open containing folder"
                                    @onclick:stopPropagation @onclick="() => OpenFolder(m)">
                                <img class="jg-rowbtn-icon" src="assets/actions/folder.svg" alt="" draggable="false" />
                            </button>
                            @if (m.Disabled)
                            {
                                <button class="jg-rowbtn" data-tip="Enable"
                                        @onclick:stopPropagation @onclick="() => SetDisabled(m, false)">
                                    <img class="jg-rowbtn-icon" src="assets/actions/enable.svg" alt="" draggable="false" />
                                </button>
                            }
                            else
                            {
                                <button class="jg-rowbtn" data-tip="Disable"
                                        @onclick:stopPropagation @onclick="() => SetDisabled(m, true)">
                                    <img class="jg-rowbtn-icon" src="assets/actions/disable.svg" alt="" draggable="false" />
                                </button>
                            }
                            <button class="jg-rowbtn danger" data-tip="Delete"
                                    @onclick:stopPropagation @onclick="() => AskDeleteMod(m)">
