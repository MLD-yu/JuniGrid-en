    /// <summary>Whether an update is available: the state records a remote version newer than the installed one (reuses the row logic).</summary>
    private bool IsUpdatable(ModEntry m)
    {
        // v1.08: disabled mods count as updatable too (check only, no install; updatable once enabled)
        var st = GetState(m.Folder);
        return st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version);
    }

    /// <summary>Groups by outermost folder (mods sitting directly in the root are the "" group).</summary>
    private IReadOnlyList<ModGroup> Groups
    {
        get
        {
            var list = new List<ModGroup>();
            var installed = InstalledUids;
            foreach (var g in FilteredMods.GroupBy(GroupKeyOf))
            {
                // v0.32.0: sort within groups by the selected mode
                var items = _sortMode switch
                {
                    "time-desc" => g.OrderBy(x => x.LastWrite).ToList(),
                    "time-asc"  => g.OrderByDescending(x => x.LastWrite).ToList(),
                    _           => g.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                };
                list.Add(new ModGroup
                {
                    Key = g.Key,
                    Items = items,
                    Installed = installed,
                    Missing = items
                        .Where(x => x.Dependencies is { Count: > 0 } || x.ContentPackIds is { Count: > 0 })
                        .SelectMany(x => x.Dependencies.Concat(x.ContentPackIds))
                        .Where(d => !string.IsNullOrWhiteSpace(d) && !installed.Contains(d))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList()
                });
            }
            // v0.32.0: group order also follows the sort mode (the root "" group always first)
            return _sortMode switch
            {
                "time-desc" => list.OrderBy(x => x.Key == "" ? 0 : 1)
                                   .ThenByDescending(x => x.Items.Count > 0 ? x.Items.Max(m => m.LastWrite) : DateTime.MinValue)
                                   .ToList(),
                "time-asc"  => list.OrderBy(x => x.Key == "" ? 0 : 1)
                                   .ThenBy(x => x.Items.Count > 0 ? x.Items.Min(m => m.LastWrite) : DateTime.MaxValue)
                                   .ToList(),
                _           => list.OrderBy(x => x.Key == "" ? 0 : 1).ThenBy(x => x.Key).ToList(),
            };
        }
    }

    private static string GroupKeyOf(ModEntry m)
    {
        // Folder looks like "SVE/[CP] xx" or "xx": the first segment is the group key.
        var idx = m.Folder.IndexOf('/');
        return idx > 0 ? m.Folder[..idx] : "";
    }

    private sealed class ModGroup
    {
        public string Key = "";
        public List<ModEntry> Items = new();
        public HashSet<string> Installed = new();

        /// <summary>Deduplicated union of all missing dependencies in this group (not in the installed set).</summary>
        public List<string> Missing { get; set; } = new();
    }

    private readonly Dictionary<string, ModUpdateState> _states = new();
    private static readonly Dictionary<string, RemoteVersionCache> _remoteVersionCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selected = new();

    private sealed class RemoteVersionCache(string version, DateTime at)
    {
        public string Version { get; } = version;
        public DateTime At { get; } = at;
    }

    private sealed class ModUpdateState
    {
        public string Status = "idle";   // idle/checking/latest/available/updating/updated/premium/failed
        public string? RemoteVersion;
        public string? Message;
        public string? PictureUrl;       // Nexus cover (picked up while checking for updates)
        public int? CategoryId;          // v0.46.0: website category ID (grabbed by GetModAsync along the way)
    }

    private string SmapiDisplay =>
        _smapiVersion is null ? "Not installed"
        : _smapiVersion == "installed" ? "Installed"
        : _smapiVersion;

    private ModUpdateState GetState(string folder) =>
        _states.TryGetValue(folder, out var s) ? s : new ModUpdateState();

    private void ApplyKnownRemoteVersions()
    {
        foreach (var m in _mods)
        {
            if (!_remoteVersionCache.TryGetValue(m.Folder, out var entry)) continue;
            // v1.06.7: align the restore window with the check TTL (60 min) — the old 30-minute value failed both ways
            // in the 30-60 min range: couldn't restore, and a re-check was skipped by the TTL
            if (DateTime.UtcNow - entry.At > UpdateCheckTtl) continue;
            _states[m.Folder] = new ModUpdateState
            {
                Status = "latest",
                RemoteVersion = entry.Version
            };
        }
    }

    // v0.44.0: update-check result cache (folder -> UTC time of last successful check); re-clicking "check for
    // updates" within 60 minutes skips already-checked mods — with hundreds of mods only new/expired ones get requests
    private static readonly Dictionary<string, DateTime> _lastCheckedUtc = new();
    private static readonly TimeSpan UpdateCheckTtl = TimeSpan.FromMinutes(60);

    // vNext: fingerprint cache lifetime — in theory valid forever while updatedAt is unchanged; a 7-day cap is kept
    // as a backstop against the edge case "file list changed but updatedAt didn't" (e.g. the author deleted the latest file) lingering forever
    private static readonly TimeSpan FingerprintMaxAge = TimeSpan.FromDays(7);
    /// <summary>vNext: the fingerprint cache (Cfg.ModUpdateFingerprints) was written this round and needs persisting.</summary>
    private bool _fpDirty;

    private static void RememberRemoteVersion(string folder, string? version)
    {
        if (string.IsNullOrWhiteSpace(version)) return;
        _remoteVersionCache[folder] = new RemoteVersionCache(version, DateTime.UtcNow);
    }


    private void OnCoverCached()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private string? GetCover(ModEntry m)
    {
        var st = GetState(m.Folder);
        if (st.PictureUrl is not null) return Covers.Get(st.PictureUrl);
        if (Cfg.Current.ModCovers.TryGetValue(m.Folder, out var url)) return Covers.Get(url);
        // v0.43.0: after disabling, the folder becomes ".X/..." while the cover cache still sits under the enabled
        // "X/..." key; fall back to the normalized key (top-level "." prefix stripped) so covers show in both states
        var norm = NormCoverKey(m.Folder);
        return norm != m.Folder && Cfg.Current.ModCovers.TryGetValue(norm, out var url2) ? Covers.Get(url2) : null;
    }

    private static string NormCoverKey(string folder)
    {
        var parts = folder.Split('/');
        parts[0] = parts[0].TrimStart('.');
        return string.Join('/', parts);
    }

    // vNext: cross-page static snapshot — keep the scan results when leaving /mods; returning from another page shows the
    // list instantly from the snapshot (zero disk IO, zero wait), then a background rescan refreshes. Survives component disposal.
    private static IReadOnlyList<ModEntry>? _svMods;
    // vNext: cross-page cache of SMAPI version/icon probe results (the icon is exe-extracted + base64; doing it on every entry is wasteful)
    private static string? _svSmapiPath;
    private static string? _svSmapiVersionCache;
    private static string? _svSmapiIconCache;

    protected override void OnInitialized()
    {
        Covers.Changed += OnCoverCached;   // v1.08: refresh after the image finishes caching in the background
        
        // v1.08: restore SMAPI task state from the task center — leaving and returning rebuilds the component,
        // and _smapiUpdating resetting to false would re-enable the button and create duplicate download tasks.
        _smapiUpdating = Center.Items.Any(t =>
            t.Status == "running" && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase));
        var gp = Cfg.Current.GamePath;
        if (_svSmapiPath == gp && _svSmapiVersionCache is not null)
        {
            _smapiVersion = _svSmapiVersionCache;
            _smapiIcon = _svSmapiIconCache;
        }
        else
        {
            _smapiVersion = Game.ProbeSmapiVersion(gp);
            _smapiIcon = Game.GetSmapiIconDataUri(gp);
            _svSmapiPath = gp;
            _svSmapiVersionCache = _smapiVersion;
            _svSmapiIconCache = _smapiIcon;
        }
        Installer.OnChanged += OnInstallerChanged;
        // v1.06.7: clicking the Mod Management icon for the current page in the top bar -> rescan + re-check updates
        PageRefresh.OnRefresh += OnPageRefresh;
    }

    /// <summary>Top-bar refresh signal (fires only while already on this page).
    /// Rescans + force re-checks all updates (ignoring the 60-minute TTL).</summary>
    private void OnPageRefresh(string key)
    {
        if (key != "mods" || _disposed) return;
        _ = InvokeAsync(async () =>
        {
            _initialLoading = true;
            StateHasChanged();
            // v1.1.6: manual refresh also runs duplicate-copy cleanup (the preScanned path skips the cleanup inside Rescan)
            var scanned = await Task.Run(() =>
            {
                try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                catch (Exception ex) { AppLog.Warn("Mods", "Duplicate-copy cleanup failed: " + ex.Message); }
                return ModSvc.Scan(Cfg.Current.GamePath);
            });
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
            await CheckUpdates(force: true);
            // v1.08: refresh also re-probes SMAPI (the exe changes after install/upgrade; the static cache holds the old
            // version) and force re-checks remote versions — refresh used to always serve the 5-minute cache, never
            // showing the freshly installed state.
            _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath);
            _smapiIcon = Game.GetSmapiIconDataUri(Cfg.Current.GamePath);
            _smapiUpdate = await Updater.CheckSmapiAsync(_smapiVersion, force: true);
            StateHasChanged();
            // vNext: manual refresh = start over — scroll to top and write 0 into the scroll store, otherwise leaving
            // without scrolling after a refresh would restore the stale pre-refresh position next time
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
            try { await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", 0, false); } catch { }
        });
    }

    // v0.72.8: dispose the FileSystemWatcher — the old code only unbound Installer; the watcher was never destroyed.
    // Every leave/return to /mods stacked another watcher; N round trips = N watchers on Mods/, and one batch rename of
    // 63 fired 63xN Rescan callbacks -> UI freeze (the root cause of "freezes only after visiting the detail page and back").
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Covers.Changed -= OnCoverCached;
        Installer.OnChanged -= OnInstallerChanged;
        PageRefresh.OnRefresh -= OnPageRefresh;
        // vNext: leave the scan snapshot behind — returning from another page shows the list instantly, then a background rescan refreshes
        _svMods = _mods;
        if (_modsWatcher is not null)
        {
            try { _modsWatcher.EnableRaisingEvents = false; } catch { }
            try { _modsWatcher.Dispose(); } catch { }
            _modsWatcher = null;
        }
    }

    private void OnInstallerChanged() =>
        InvokeAsync(RescanAndRestate);   // v1.1.6: cleanup+scan moved to a background thread

    private FileSystemWatcher? _modsWatcher;
    private int _pendingRescan;   // v0.72.8: watcher event coalescing gate

    protected override async Task OnInitializedAsync()
    {
        // v1.08: immediately prewarm all known cover URLs in the background on entry (zero requests on local cache
        // hits), so images are ready while the user is still looking at the list — the key head start for first-load feel.
        Covers.Prewarm(Cfg.Current.ModCovers.Values);

        // vNext: two entry paths — (1) with a cross-page snapshot (returning from another page): show the list instantly
        // from the snapshot, push the disk rescan to the background and swap in seamlessly; (2) cold start without a
        // snapshot: shimmer skeleton + background-thread scan.
        if (_svMods is { Count: > 0 } snap)
        {
            _mods = snap;
            ReindexMods();
            _initialLoading = false;
            StateHasChanged();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    // v1.1.6: the preScanned path skips the cleanup inside Rescan -> do it here
                    var scanned = await Task.Run(() =>
                    {
                        try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                        catch (Exception ex) { AppLog.Warn("Mods", "Duplicate-copy cleanup failed: " + ex.Message); }
                        return ModSvc.Scan(Cfg.Current.GamePath);
                    });
                    if (_disposed) return;
                    Rescan(scanned);
                    StateHasChanged();
                }
                catch { }
            });
        }
        else
        {
            // v0.59.0: show the shimmer skeleton first; switch to the real list once Rescan finishes
            _initialLoading = true;
            StateHasChanged();
            await Task.Yield();  // let the skeleton render one frame first
            // vNext: disk scan moved off the UI thread — parsing manifests for hundreds of mods no longer blocks rendering
            // v1.1.6: the preScanned path skips the cleanup inside Rescan -> do it here
            var scanned = await Task.Run(() =>
            {
                try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                catch (Exception ex) { AppLog.Warn("Mods", "Duplicate-copy cleanup failed: " + ex.Message); }
                return ModSvc.Scan(Cfg.Current.GamePath);
            });
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
        }
        // v1.06.7: must restore remote version markers after Rescan — backfill the updatable state by folder once
        // _mods is ready (the snapshot path must run this too: a new instance's _states is empty).
        ApplyKnownRemoteVersions();
        StateHasChanged();
        if (ActiveProfileName != "Default"
            && AllProfiles.Any(p => p.Name == ActiveProfileName))
        {
            _ = InvokeAsync(async () =>
            {
                // delay one frame so the first screen finishes rendering, then apply the profile
                await Task.Delay(300);
                await ApplyProfile(ActiveProfileName);
            });
        }

        // The SMAPI check and mod update checks are independent; run both — don't let the SMAPI network request
        // hold up the page, mod rows start checking remote versions as soon as they appear.
        var smapiTask = Updater.CheckSmapiAsync(_smapiVersion);
        // v0.68.3: on entering the Mod page, decided entirely by the Settings page\'s "auto-install updates" switch (EnableAutoInstall); no more prompt.
        _ = InvokeAsync(async () => { await AutoUpdateOnEnterAsync(); await InvokeAsync(StateHasChanged); });

        // Q4: watch the Mods folder so mods dropped in manually appear immediately
        try
        {
            var modsDir = System.IO.Path.Combine(Cfg.Current.GamePath, "Mods");
            if (Directory.Exists(modsDir))
            {
                _modsWatcher = new FileSystemWatcher(modsDir)
                {
                    IncludeSubdirectories = false,
                    NotifyFilter = NotifyFilters.DirectoryName | NotifyFilters.FileName | NotifyFilters.LastWrite
                };
                // v0.72.8: disposed guard + event coalescing — queued callbacks no longer re-enter after disposal;
                // several file events in quick succession coalesce into one RescanAndRestate (_pendingRescan debounce).
                FileSystemEventHandler onChange = (_, _) =>
                {
                    if (_disposed) return;
                    if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
                    _ = InvokeAsync(async () =>
                    {
                        try
                        {
                            await Task.Delay(120);   // coalescing window: consecutive events within 120ms trigger only one rescan
                            if (_disposed) return;
                            RescanAndRestate();
                        }
                        finally { Interlocked.Exchange(ref _pendingRescan, 0); }
                    });
                };
                _modsWatcher.Created += onChange;
                _modsWatcher.Deleted += onChange;
                _modsWatcher.Renamed += (_, _) =>
                {
                    if (_disposed) return;
                    if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
                    _ = InvokeAsync(async () =>
                    {
                        try
                        {
                            await Task.Delay(120);
                            if (_disposed) return;
                            RescanAndRestate();
                        }
                        finally { Interlocked.Exchange(ref _pendingRescan, 0); }
                    });
                };
                _modsWatcher.EnableRaisingEvents = true;
            }
        }
        catch { /* if the watcher can't be created, the user can still use manual refresh */ }

        _smapiUpdate = await smapiTask;
        if (_smapiUpdate is not null) StateHasChanged();
    }

    private void RescanAndRestate()
    {
        // v1.1.6: high-frequency entries (watcher, install-finished callbacks) go through the background rescan —
        // duplicate-copy cleanup + full scans no longer run on the UI thread (the old code scanned the whole disk 1-2 times on the UI thread).
        _ = RescanInBackground();
    }

    private bool _bgRescanRunning;
    private bool _bgRescanQueued;

    /// <summary>v1.1.6: background rescan — both CleanupDuplicateCopies (full disk enumeration + directory moves) and
    /// Scan run in Task.Run; only the results are applied back on the UI thread. Events arriving during a scan coalesce
    /// into one follow-up pass, so the last event is never lost. Callers must already be on the UI thread (all three
    /// entries are InvokeAsync callbacks).</summary>
    private async Task RescanInBackground()
    {
        if (_bgRescanRunning) { _bgRescanQueued = true; return; }
        _bgRescanRunning = true;
        try
        {
            while (true)
            {
                _bgRescanQueued = false;
                var scanned = await Task.Run(() =>
                {
                    try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                    catch (Exception ex) { AppLog.Warn("Mods", "Duplicate-copy cleanup failed: " + ex.Message); }
                    return ModSvc.Scan(Cfg.Current.GamePath);
                });
                if (_disposed) return;
                Rescan(scanned);
                StateHasChanged();
                if (!_bgRescanQueued) return;
            }
        }
        finally { _bgRescanRunning = false; }
    }

    /// <summary>vNext: preScanned lets the caller scan on a background thread first and apply results back on the UI
    /// thread (the scan itself never touches UI state; selection cleanup happens on the UI thread to avoid racing renders).
    /// Cleanup+scan run on the current thread only when preScanned is null — results from RescanInBackground already
    /// include cleanup, which is skipped to avoid two redundant full scans on the UI thread.</summary>
    private void Rescan(IReadOnlyList<ModEntry>? preScanned = null)
    {
        // v1.1.4: physical cleanup of duplicate copies sharing a UniqueID — SMAPI reads the disk directly, hiding in
        // the UI isn't enough (extra copies make the whole pack Skipped). Clean up from the raw scan, then do the real scan.
        if (preScanned is null)
        {
            try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
            catch (Exception __ex) { AppLog.Warn("Mods", "Duplicate-copy cleanup failed: " + __ex.Message); }
            _mods = ModSvc.Scan(Cfg.Current.GamePath);
        }
        else
        {
            _mods = preScanned;
        }
        ReindexMods();
        // v1.1.2: remark reconciliation — updating a mod resets the manifest Name; re-apply the remark here (while the game isn't running)
        if (Cfg.Current.ModRemarks.Count > 0)
            _ = Task.Run(() => ModSvc.SyncAllRemarks(Cfg.Current.GamePath, Cfg));
        // drop selected items no longer in the list (v1.1.6: via the index dictionary; no more full-table scan per selected item)
        _selected.RemoveWhere(f => !_modsByFolder.ContainsKey(f));
        // v0.72.7: Rescan only scans — it no longer secretly starts BackfillCoversAsync. The old code stacked a
        // network backfill task on every Rescan (init/batch/watcher callbacks, any of them), the core amplifier of the
        // "random freezes". Cover backfill now starts on demand from explicit entry points (with a concurrency gate).
    }

    private void ReindexMods()
    {
        _modsByFolder = new Dictionary<string, ModEntry>(_mods.Count, StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods) _modsByFolder[m.Folder] = m;
        // v1.2.3: rebuild the installed UID set along with the rescan — MissingDeps/filter counts/grouping are called
        // constantly during render; the old getter rebuilt the HashSet on every InstalledUids access (O(N^2) allocations per render).
        _installedUids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
            if (!string.IsNullOrWhiteSpace(m.UniqueID))
                _installedUids.Add(m.UniqueID.Trim());
    }

    /// <summary>Installed UniqueID set (cache rebuilt by ReindexMods; don't recompute during render).</summary>
    private HashSet<string> _installedUids = new(StringComparer.OrdinalIgnoreCase);

