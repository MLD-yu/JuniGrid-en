    // v1.2.0: one-click missing-dependency install (banner + row-level entry)
    // ------------------------------------------------------------------
    private List<string>? _pendingDepUids;   // data source for the confirmation dialog; empty list = all missing dependencies
    private bool _depInstalling;
    private string? _depError;
    private IReadOnlyList<InstallService.DependencyRunItem>? _depResults;
    // v1.2.1: dependency display info for the confirmation dialog (cover + mod name), filled asynchronously via keyless search; falls back to showing the UID
    private readonly Dictionary<string, InstallService.DependencyDisplayInfo> _depDisplay
        = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Union of all missing dependencies (banner + one-click install entry).</summary>
    private List<string> TotalMissingUids
    {
        get
        {
            var set = new List<string>();
            foreach (var m in _mods)
                foreach (var d in MissingDeps(m))
                    if (!set.Contains(d, StringComparer.OrdinalIgnoreCase)) set.Add(d);
            return set;
        }
    }

    private int MissingAffectedMods => _mods.Count(m => MissingDeps(m).Count > 0);

    /// <summary>uids == null means all missing dependencies; otherwise install only this batch (passed to the confirmation dialog and install pipeline).</summary>
    private void AskInstallMissingDeps(List<string>? uids)
    {
        _depError = null;
        _pendingDepUids = uids ?? new List<string>();
        // v1.2.1: open the dialog immediately (showing UIDs first); covers/mod names resolve asynchronously in the background one by one
        _ = ResolveDepDisplayAsync(_pendingDepUids.Count > 0 ? _pendingDepUids : TotalMissingUids);
    }

    /// <summary>Resolves each dependency's display name and cover for the dialog in parallel (keyless search; keeps showing the UID on failure).</summary>
    private async Task ResolveDepDisplayAsync(List<string> uids)
    {
        _depDisplay.Clear();
        StateHasChanged();
        await Task.WhenAll(uids.Select(async u =>
        {
            var info = await Installer.ResolveDependencyDisplayAsync(u);
            if (info is not null)
            {
                _depDisplay[u] = info;
                await InvokeAsync(StateHasChanged);
            }
        }));
    }

    private void CancelInstallDeps() => _pendingDepUids = null;

    /// <summary>v1.2.3: clicking a dependency row in the dialog -> in-app mod detail page (/mod/{nexusId}/{uid}).
    /// Rows without a resolved Nexus modId (search failed) are not clickable and are ignored.</summary>
    private void OpenDepDetail(InstallService.DependencyDisplayInfo? di)
    {
        if (di?.ModId is not int id) return;
        _pendingDepUids = null;   // close the dialog before leaving the page so it doesn't linger when returning
        Nav.NavigateTo($"mod/{id}" + (string.IsNullOrWhiteSpace(di.Uid) ? "" : "/" + Uri.EscapeDataString(di.Uid)));
    }

    private void CloseDepResults() => _depResults = null;

    private async Task ConfirmInstallDeps()
    {
        if (_depInstalling) return;
        var uids = _pendingDepUids;
        _pendingDepUids = null;
        _depInstalling = true;
        _depError = null;
        _depResults = null;
        try
        {
            // empty list = all missing dependencies; the service rescans disk each round, no snapshot needed here.
            // v1.2.3: pass the dialog's already-resolved UID -> modId map to the install pipeline (saves a second search;
            // UniqueID is still verified at install time). While waiting, Installer.OnChanged keeps the list rescanning live.
            var pre = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (var kv in _depDisplay)
                if (kv.Value.ModId is int mid) pre[kv.Key] = mid;
            var err = await Installer.InstallMissingDependenciesAsync(
                uids is { Count: > 0 } ? uids : null, pre);
            if (err is not null && err != "Cancelled") _depError = err;
        }
        finally
        {
            _depInstalling = false;
        }
        _depResults = Installer.LastDependencyRun;
        await InvokeAsync(StateHasChanged);
    }

