    // v0.36.0: AnimatedList scroll effect for the mod list (scale/opacity on entering viewport + top/bottom fade)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v0.71.1: restore the scroll position when returning from the detail page — setScrollWhenReady polls
        // until the container is tall enough, then sets it
        // v0.72.0: carry the "was at bottom" flag from when we left; the restore logic no longer guesses via y>limit
        var dedicatedRan = false;
        if (!_initialLoading && _restoreScroll >= 0)
        {
            dedicatedRan = true;   // v1.06.8: this run used the dedicated snapshot restore; the firstRender fallback must yield
            _entryRestoreRan = true;
            var y = _restoreScroll;
            var atBottom = _restoreAtBottom;
            _restoreScroll = -1;
            _restoreAtBottom = false;
            _scrollRestoreClassPending = false;
            AppLog.Warn("Mods", $"[diag] scroll restore started y={y} atBottom={atBottom}");
            try
            {
                var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, atBottom, reporter);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[diag] scroll restore call failed: " + ex.Message);
                try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
            }
        }
        else if (!_initialLoading && _scrollRestoreClassPending)
        {
            // v0.72.4: returned to the list with the "restore pending" flag but no snapshot to restore
            // (e.g. clicking top navigation from the detail page) -> remove the hiding flag so the list shows normally
            _scrollRestoreClassPending = false;
            _entryRestoreRan = true;
            try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
        }
        try { await JS.InvokeVoidAsync("junigridJs.animatedListInit", ".jg-main", ".jg-modrows"); } catch { }
        if (firstRender)
        {
            // v0.45.0: remember the /mods scroll position — when entering the detail page and returning,
            // restore the previous scroll height instead of jumping back to the top
            try { await JS.InvokeVoidAsync("junigridJs.scrollSpy", ".jg-main", "modslist", false); } catch { }
        }

        // vNext: entering the page always restores the position from when we left — no longer limited to popstate.
        // Returning from another page via a nav icon (forward navigation) restores too: scrollSpy keeps writing the
        // "position when leaving" to the modslist key, and we simply read it here. On cold start sessionStorage is
        // empty (y≈0) so nothing restores; a manual refresh does not rebuild the component and skips this.
        // The dedicated snapshot (detail-page return) takes priority.
        // vNext: only run after the list is actually shown (_initialLoading=false) — during the skeleton phase the
        // "restore pending" flag would hide the skeleton itself too (same .jg-modrows-skeleton class).
        if (!_initialLoading && !_entryRestoreRan)
        {
            _entryRestoreRan = true;
            if (!dedicatedRan && _restoreScroll < 0)
            {
                try
                {
                    var y = await JS.InvokeAsync<double>("junigridJs.readScrollKey", "modslist");
                    if (y > 1)
                    {
                        AppLog.Warn("Mods", $"[diag] generic entry restore y={y}");
                        // first attach the "restore pending" hiding flag (.jg-main persists across navigation);
                        // setScrollWhenReady removes it in the same frame after landing, avoiding a one-frame
                        // flash of the list at the top
                        await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                        var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                        await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, false, reporter);
                    }
                }
                catch (Exception ex)
                {
                    AppLog.Error("Mods", "[diag] generic entry restore failed: " + ex.Message);
                    try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
                }
            }
        }
    }

    /// <summary>vNext: gate so the generic entry restore runs only once (skipped during the skeleton phase; runs on the first render after the list is shown).</summary>
    private bool _entryRestoreRan;

    private void ToggleGroup(string key)
    {
        if (!_collapsed.Add(key)) _collapsed.Remove(key);
    }

    /// <summary>Missing dependencies (declared in Dependencies but not present in the installed UniqueID set).</summary>
    private List<string> MissingDeps(ModEntry m)
    {
        if (m.Dependencies == null || m.Dependencies.Count == 0) return new List<string>();
        var uids = InstalledUids;
        return m.Dependencies
            .Where(d => !string.IsNullOrWhiteSpace(d) && !uids.Contains(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Whether an update is available: the state has a remote version recorded and it is newer than the current one (same logic as the row).</summary>
    private bool IsUpdatable(ModEntry m)
    {
        if (m.Disabled) return false;
        var st = GetState(m.Folder);
        return st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version);
    }

    /// <summary>Group by outermost folder (mods sitting directly in the Mods root belong to the "" group).</summary>
    private IReadOnlyList<ModGroup> Groups
    {
        get
        {
            var list = new List<ModGroup>();
            var installed = InstalledUids;
            foreach (var g in FilteredMods.GroupBy(GroupKeyOf))
            {
                // v0.32.0: sort within each group by the selected mode
                var items = _sortMode switch
                {
                    "time-desc" => g.OrderBy(x => x.LastWrite).ToList(),
                    "time-asc"  => g.OrderByDescending(x => x.LastWrite).ToList(),
                    _           => g.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                };
                list.Add(new ModGroup
                {
                    Key = g.Key,
                    Items = items,
                    Installed = installed,
                    Missing = items
                        .Where(x => x.Dependencies is { Count: > 0 })
                        .SelectMany(x => x.Dependencies)
                        .Where(d => !string.IsNullOrWhiteSpace(d) && !installed.Contains(d))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList()
                });
            }
            // v0.32.0: group order also follows the sort mode (the root "" group always comes first)
            return _sortMode switch
            {
                "time-desc" => list.OrderBy(x => x.Key == "" ? 0 : 1)
                                   .ThenByDescending(x => x.Items.Count > 0 ? x.Items.Max(m => m.LastWrite) : DateTime.MinValue)
                                   .ToList(),
                "time-asc"  => list.OrderBy(x => x.Key == "" ? 0 : 1)
                                   .ThenBy(x => x.Items.Count > 0 ? x.Items.Min(m => m.LastWrite) : DateTime.MaxValue)
                                   .ToList(),
                _           => list.OrderBy(x => x.Key == "" ? 0 : 1).ThenBy(x => x.Key).ToList(),
            };
        }
    }

    private static string GroupKeyOf(ModEntry m)
    {
        // Folder looks like "SVE/[CP] xx" or "xx": take the first segment as the group key.
        var idx = m.Folder.IndexOf('/');
        return idx > 0 ? m.Folder[..idx] : "";
    }

    private sealed class ModGroup
    {
        public string Key = "";
        public List<ModEntry> Items = new();
        public HashSet<string> Installed = new();

        /// <summary>Union of all missing dependencies in this group (not in the installed set), deduplicated.</summary>
        public List<string> Missing { get; set; } = new();
    }

    private readonly Dictionary<string, ModUpdateState> _states = new();
    private static readonly Dictionary<string, RemoteVersionCache> _remoteVersionCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selected = new();

    private sealed class RemoteVersionCache(string version, DateTime at)
    {
        public string Version { get; } = version;
        public DateTime At { get; } = at;
    }

    private sealed class ModUpdateState
    {
        public string Status = "idle";   // idle/checking/latest/available/updating/updated/premium/failed
        public string? RemoteVersion;
        public string? Message;
        public string? PictureUrl;       // Nexus cover (picked up along the way during update checks)
        public int? CategoryId;          // v0.46.0: site category ID (picked up by GetModAsync)
    }

    private string SmapiDisplay =>
        _smapiVersion is null ? "Not installed"
        : _smapiVersion == "installed" ? "Installed"
        : _smapiVersion;

    private ModUpdateState GetState(string folder) =>
        _states.TryGetValue(folder, out var s) ? s : new ModUpdateState();

    private void ApplyKnownRemoteVersions()
    {
        foreach (var m in _mods)
        {
            if (!_remoteVersionCache.TryGetValue(m.Folder, out var entry)) continue;
            // v1.06.7: align the restore window with the check TTL (60 minutes) — the old 30-minute value
            // left a 30-60 minute dead zone where the restore failed but a re-check was skipped by the TTL
            if (DateTime.UtcNow - entry.At > UpdateCheckTtl) continue;
            _states[m.Folder] = new ModUpdateState
            {
                Status = "latest",
                RemoteVersion = entry.Version
            };
        }
    }

    // v0.44.0: update-check result cache (folder -> UTC time of last successful check);
    // re-running "check for updates" within 60 minutes skips already-checked mods, so even hundreds of mods
    // only issue requests for new/expired entries
    private static readonly Dictionary<string, DateTime> _lastCheckedUtc = new();
    private static readonly TimeSpan UpdateCheckTtl = TimeSpan.FromMinutes(60);

    // vNext: fingerprint cache lifetime — if updatedAt is unchanged the entry is theoretically valid forever,
    // but a 7-day cap is kept as a safeguard against the edge case "file list changed but updatedAt did not"
    // (e.g. the author deleted the latest file) lingering indefinitely
    private static readonly TimeSpan FingerprintMaxAge = TimeSpan.FromDays(7);
    /// <summary>vNext: the fingerprint cache (Cfg.ModUpdateFingerprints) was written this round and needs to be saved.</summary>
    private bool _fpDirty;

    private static void RememberRemoteVersion(string folder, string? version)
    {
        if (string.IsNullOrWhiteSpace(version)) return;
        _remoteVersionCache[folder] = new RemoteVersionCache(version, DateTime.UtcNow);
    }


    private string? GetCover(ModEntry m)
    {
        var st = GetState(m.Folder);
        if (st.PictureUrl is not null) return st.PictureUrl;
        if (Cfg.Current.ModCovers.TryGetValue(m.Folder, out var url)) return url;
        // v0.43.0: after disabling, the folder becomes ".X/..." while the cover cache still holds the
        // enabled-time "X/..." key; fall back to the normalized key (top-level "." prefix stripped) so
        // covers show in both the disabled and enabled states
        var norm = NormCoverKey(m.Folder);
        return norm != m.Folder && Cfg.Current.ModCovers.TryGetValue(norm, out var url2) ? url2 : null;
    }

    private static string NormCoverKey(string folder)
    {
        var parts = folder.Split('/');
        parts[0] = parts[0].TrimStart('.');
        return string.Join('/', parts);
    }

    // vNext: cross-page static snapshot — keep the scan results when leaving /mods; when returning from
    // another page, show the list instantly from the snapshot (zero disk IO, zero wait), then rescan the disk
    // in the background to refresh. Survives component disposal.
    private static IReadOnlyList<ModEntry>? _svMods;
    // vNext: cross-page cache for the SMAPI version/icon probe results (the icon is exe-extracted + base64; redoing it on every page entry would be wasteful)
    private static string? _svSmapiPath;
    private static string? _svSmapiVersionCache;
    private static string? _svSmapiIconCache;

    protected override void OnInitialized()
    {
        _apiKey = Cfg.Current.NexusApiKey;
        var gp = Cfg.Current.GamePath;
        if (_svSmapiPath == gp && _svSmapiVersionCache is not null)
        {
            _smapiVersion = _svSmapiVersionCache;
            _smapiIcon = _svSmapiIconCache;
        }
        else
        {
            _smapiVersion = Game.ProbeSmapiVersion(gp);
            _smapiIcon = Game.GetSmapiIconDataUri(gp);
            _svSmapiPath = gp;
            _svSmapiVersionCache = _smapiVersion;
            _svSmapiIconCache = _smapiIcon;
        }
        Installer.OnChanged += OnInstallerChanged;
        // v1.06.7: clicking the Mod Management "current page" icon in the top bar -> rescan + re-check updates
        PageRefresh.OnRefresh += OnPageRefresh;
    }

    /// <summary>Top-bar refresh signal (only fires while already on this page).
    /// Rescans and forces a full update re-check (ignoring the 60-minute TTL).</summary>
    private void OnPageRefresh(string key)
    {
        if (key != "mods" || _disposed) return;
        _ = InvokeAsync(async () =>
        {
            _initialLoading = true;
            StateHasChanged();
            var scanned = await Task.Run(() => ModSvc.Scan(Cfg.Current.GamePath));
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
            await CheckUpdates(force: true);
            StateHasChanged();
            // vNext: manual refresh = start from the top — scroll to the top and write 0 into the scroll store,
            // otherwise leaving without scrolling after the refresh would restore the stale pre-refresh position next time
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
            try { await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", 0, false); } catch { }
        });
    }

    // v0.72.8: dispose the FileSystemWatcher — the old version only unbound Installer and never destroyed the watcher.
    // Every leave/return of /mods stacked another watcher; N round trips = N watchers all listening to Mods/,
    // and a 63-item batch rename triggered 63×N Rescan callbacks → frozen UI (the root cause of "freezes only after visiting the detail page").
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Installer.OnChanged -= OnInstallerChanged;
        PageRefresh.OnRefresh -= OnPageRefresh;
        // vNext: keep the scan snapshot — show the list instantly from it when returning from another page, rescan the disk in the background
        _svMods = _mods;
        if (_modsWatcher is not null)
        {
            try { _modsWatcher.EnableRaisingEvents = false; } catch { }
            try { _modsWatcher.Dispose(); } catch { }
            _modsWatcher = null;
        }
    }

    private void OnInstallerChanged() =>
        InvokeAsync(() =>
        {
            Rescan();
            StateHasChanged();
        });

    private FileSystemWatcher? _modsWatcher;
    private int _pendingRescan;   // v0.72.8: watcher event-coalescing gate

    protected override async Task OnInitializedAsync()
    {
        // vNext: two entry paths — (1) cross-page snapshot exists (returned from another page): show the list
        // instantly from the snapshot, push the disk rescan to the background, and swap in results seamlessly;
        // (2) cold start without a snapshot: shimmer skeleton + background thread scan.
        if (_svMods is { Count: > 0 } snap)
        {
            _mods = snap;
            _initialLoading = false;
            StateHasChanged();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    var scanned = await Task.Run(() => ModSvc.Scan(Cfg.Current.GamePath));
                    if (_disposed) return;
                    Rescan(scanned);
                    StateHasChanged();
                }
                catch { }
            });
        }
        else
        {
            // v0.59.0: show the shimmer skeleton on first paint, then switch to the real list once Rescan finishes
            _initialLoading = true;
            StateHasChanged();
            await Task.Yield();  // let the skeleton render one frame first
            // vNext: move the disk scan off the UI thread — parsing manifests for hundreds of mods no longer blocks rendering
            var scanned = await Task.Run(() => ModSvc.Scan(Cfg.Current.GamePath));
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
        }
        // v1.06.7: remote version markers must be restored after Rescan — once _mods is ready, backfill the
        // "⇑ updatable" state by folder (the snapshot path must run this too: a new instance's _states is empty).
        ApplyKnownRemoteVersions();
        StateHasChanged();
        if (ActiveProfileName != "Default"
            && AllProfiles.Any(p => p.Name == ActiveProfileName))
        {
            _ = InvokeAsync(async () =>
            {
                // delay one frame so the first paint completes before applying the profile
                await Task.Delay(300);
                await ApplyProfile(ActiveProfileName);
            });
        }

        // The SMAPI check and the mod update detection are independent; run both concurrently. Don't let the
        // SMAPI network request block the whole page — mod rows start checking remote versions as soon as they appear.
        var smapiTask = Updater.CheckSmapiAsync(_smapiVersion);
        // v0.68.3: on entering the Mods page, behavior is decided entirely by the Settings page's "auto-install updates" toggle (EnableAutoInstall); no more prompt.
        _ = InvokeAsync(async () => { await AutoUpdateOnEnterAsync(); await InvokeAsync(StateHasChanged); });

        // Q4: watch the Mods folder so mods the user drops in manually appear immediately
        try
        {
            var modsDir = System.IO.Path.Combine(Cfg.Current.GamePath, "Mods");
            if (Directory.Exists(modsDir))
            {
                _modsWatcher = new FileSystemWatcher(modsDir)
                {
                    IncludeSubdirectories = false,
                    NotifyFilter = NotifyFilters.DirectoryName | NotifyFilters.FileName | NotifyFilters.LastWrite
                };
                // v0.72.8: disposed guard + event coalescing — queued callbacks no longer fire after disposal;
                // multiple file events in a short window coalesce into one RescanAndRestate (_pendingRescan debounce).
                FileSystemEventHandler onChange = (_, _) =>
                {
                    if (_disposed) return;
                    if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
                    _ = InvokeAsync(async () =>
                    {
                        try
                        {
                            await Task.Delay(120);   // coalescing window: consecutive events within 120ms trigger only one rescan
                            if (_disposed) return;
                            RescanAndRestate();
                        }
                        finally { Interlocked.Exchange(ref _pendingRescan, 0); }
                    });
                };
                _modsWatcher.Created += onChange;
                _modsWatcher.Deleted += onChange;
                _modsWatcher.Renamed += (_, _) =>
                {
                    if (_disposed) return;
                    if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
                    _ = InvokeAsync(async () =>
                    {
                        try
                        {
                            await Task.Delay(120);
                            if (_disposed) return;
                            RescanAndRestate();
                        }
                        finally { Interlocked.Exchange(ref _pendingRescan, 0); }
                    });
                };
                _modsWatcher.EnableRaisingEvents = true;
            }
        }
        catch { /* if the watcher cannot be created, so be it — the user can refresh manually */ }

        _smapiUpdate = await smapiTask;
        if (_smapiUpdate is not null) StateHasChanged();
    }

    private void RescanAndRestate()
    {
        Rescan();
        StateHasChanged();
    }

    /// <summary>vNext: preScanned lets the caller scan the disk on a background thread first, then apply the
    /// results back on the UI thread (the scan itself never touches UI state; selected-set cleanup happens on
    /// the UI thread to avoid racing with rendering).</summary>
    private void Rescan(IReadOnlyList<ModEntry>? preScanned = null)
    {
        _mods = preScanned ?? ModSvc.Scan(Cfg.Current.GamePath);
        // drop selections that are no longer in the list
        _selected.RemoveWhere(f => !_mods.Any(m => m.Folder == f));
        // v0.72.7: Rescan only scans — it no longer secretly starts BackfillCoversAsync.
        // The old version stacked a network backfill task on every Rescan (triggered by init/batch/watcher
        // callbacks alike), which was the core amplifier of "random freezes". Cover backfill now starts
        // on demand via an explicit entry point (with a concurrency gate).
    }

