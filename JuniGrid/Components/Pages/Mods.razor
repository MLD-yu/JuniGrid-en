    private void CancelRemark() => _remarkFolder = null;

    private void SaveRemark()
    {
        var folder = _remarkFolder;
        if (folder is not null)
        {
            var text = _remarkInput.Trim();
            if (text.Length > 20) text = text[..20];
            if (text.Length == 0) Cfg.Current.ModRemarks.Remove(folder);
