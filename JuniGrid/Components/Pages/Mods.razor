    /// <summary>Missing dependencies (declared in Dependencies but not in the installed UniqueID set).
    /// v1.1.4: a missing ContentPackFor host counts too — SMAPI directly skips content packs whose host is missing
    /// (e.g. [BL] Downtown Zuzu missing hootless.BusLocations); without a hint users have no idea why it won't run.</summary>
    private List<string> MissingDeps(ModEntry m)
    {
        var deps = m.Dependencies.Concat(m.ContentPackIds).ToList();
        if (deps.Count == 0) return new List<string>();
        var uids = InstalledUids;
        return deps
            .Where(d => !string.IsNullOrWhiteSpace(d) && !uids.Contains(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

