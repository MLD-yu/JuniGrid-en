    private void OpenUpdatePage(ModEntry m)
    {
        // v0.68.2: Nexus source first — mods with a Nexus ID (including dual-source mods like SDV-Glow)
        // always send free users to the Nexus files page for manual download; Premium members install in-app
        // (via the Nexus direct link). Only "GitHub-only" mods (no Nexus source) update in-app via GitHub.
        var isPremium = Cfg.Current.NexusIsPremium;
        if ((isPremium && m.NexusModId is not null)
            || (m.NexusModId is null && m.GitHubRepo is not null))
        {
            _ = InvokeAsync(async () =>
            {
                await UpdateOne(m);
                var st = GetState(m.Folder);
                if (st.Status == "updated")
                {
                    ShowNotice("ok", $"Updated {m.Name} ✔");
                    Rescan();
                }
                else if (st.Status == "premium" && m.NexusModId is not null)
                {
                    // account is actually not Premium (403) -> fall back to opening the site for manual download
                    UpdateService.OpenUrl(
                        $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                    ShowNotice("err", "The current Nexus account is not Premium; opened the site download page instead");
                }
                else if (st.Status == "failed")
                {
                    ShowNotice("err", $"Update failed: {st.Message}");
                }
                else if (st.Status == "available")
                {
                    // v0.68.1: a new version was detected but in-app download is not possible (e.g. the GitHub
                    // release has no zip asset) -> fall back to opening the download page (GitHub releases / Nexus
                    // files tab) instead of "clicking does nothing"
                    OpenUpdateDownloadPage(m);
                    ShowNotice("ok", $"Opened the download page for {m.Name}; please download {st.RemoteVersion} manually");
                }
                StateHasChanged();
            });
            return;
        }
        if (m.NexusModId is not null)
            UpdateService.OpenUrl(
                $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }

