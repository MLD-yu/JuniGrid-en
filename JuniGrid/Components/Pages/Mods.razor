    /// <summary>v0.71.1: keep the dropdown open after switching profiles (handy for comparing).</summary>
    private async Task ApplyProfileKeepOpen(string name)
    {
        await ApplyProfile(name);
        // do not close _profileOpen — the user may want to switch several profiles in a row
    }

    private bool _addingProfile;
    private string _newProfileName = "";
    private string? _deletingProfile;

    private List<ModProfile> AllProfiles
    {
        get
        {
            var list = Cfg.Current.ModProfiles;
            if (list.Count == 0 || list[0].Name != "Default")
                list.Insert(0, new ModProfile { Name = "Default" });
            return list;
