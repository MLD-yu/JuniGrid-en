    private string ActiveProfileName =>
        string.IsNullOrWhiteSpace(Cfg.Current.ActiveProfile) ? "Default" : Cfg.Current.ActiveProfile;

    /// <summary>Writes the currently enabled set back to ActiveProfile (the "Default" profile is a runtime view and is not persisted).</summary>
    private void PersistCurrentToActive()
    {
        var active = ActiveProfileName;
        // v0.71.4: snapshot the "Default" profile too — the old version returned early, so the Default enabled list
        // stayed stale forever; switching away and back "restored" the stale list (another cross-profile-mixing root cause).
        var p = Cfg.Current.ModProfiles.FirstOrDefault(x => x.Name == active);
        if (p is null) return;
        // v0.50.0: rescan before writing back so _mods reflects the real disk state (otherwise
        // _mods is still stale right after dependency linkage and stale data gets written back → cross-profile mixing)
        // v0.51.0: Stardrop-style clean snapshot — store every currently enabled mod, without excluding
        // dependency-linked items (excluding them caused state inconsistency and was a mixing root cause)
        p.EnabledModUids = _mods
            .Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
            .Select(m => m.UniqueID)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }



    private async Task ToggleProfile()
    {
        _profileOpen = !_profileOpen;
        _renamingProfile = null; _renameBuffer = "";   // v0.71.4: exit rename mode when toggling the dropdown
        if (!_profileOpen) { _addingProfile = false; _newProfileName = ""; }
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", _profileOpen); } catch { }
    }

    private async Task CloseProfile()
    {
        if (!_profileOpen) return;
        _profileOpen = false;
        _addingProfile = false; _newProfileName = "";
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
    }

    private void StartAddProfile() { _addingProfile = true; _newProfileName = ""; }

    private async Task ConfirmAddProfile()
    {
        var name = _newProfileName.Trim();
        _addingProfile = false;
        _newProfileName = "";
        if (string.IsNullOrWhiteSpace(name)) return;
        if (AllProfiles.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            ShowNotice("err", "A profile with this name already exists: " + name);
            return;
        }
        // v0.49.0: write the current enabled state back to the old profile first to prevent cross-profile mixing
        PersistCurrentToActive();
        // the new profile snapshots the current enabled state (Stardrop-style: creating = recording the currently enabled mods)
        var p = new ModProfile
        {
            Name = name,
            EnabledModUids = _mods.Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
                                  .Select(m => m.UniqueID).ToList()
        };
        Cfg.Current.ModProfiles.Add(p);
        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        _profileOpen = false;
        // v0.49.0: explicitly close the JS dropdown animation state; fixes "dropdown broken after creating"
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
        ShowNotice("ok", $"Profile \"{name}\" created");
    }

    private void AskDeleteProfile(string name)
    {
        _deletingProfile = name;
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }
    private void CancelDeleteProfile() => _deletingProfile = null;

    private async Task ConfirmDeleteProfile()
    {
        var name = _deletingProfile;
        _deletingProfile = null;
        if (name is null) return;
        var wasActive = ActiveProfileName == name;
        Cfg.Current.ModProfiles.RemoveAll(p => p.Name == name);
        if (wasActive)
        {
            // v0.71.4: do not set ActiveProfile before calling ApplyProfile — in the old order ApplyProfile
            // hit "name == ActiveProfileName" and returned immediately, so the on-disk mod state never switched
            // back to Default (the root cause of "Default" showing the deleted profile's state after deletion).
            // The old profile is already removed from the list here, so ApplyProfile's PersistCurrentToActive
            // cannot find it → no accidental write; ApplyProfile sets ActiveProfile itself after switching.
            await ApplyProfile("Default");
        }
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"Profile \"{name}\" deleted");
    }

    /// <summary>Switch profile: batch enable/disable according to the profile's recorded UniqueID set (with dependency linkage); everything else is disabled.</summary>
    private async Task ApplyProfile(string name)
    {
        if (name == ActiveProfileName) return;
        // v0.50.0: Rescan before writing back to get the real disk state, preventing stale data → cross-profile mixing
        Rescan();
        PersistCurrentToActive();
        var profile = AllProfiles.FirstOrDefault(p => p.Name == name);
        if (profile is null) return;

        var wantEnabled = new HashSet<string>(profile.EnabledModUids, StringComparer.OrdinalIgnoreCase);
        // dependency linkage: dependencies of mods being enabled must be enabled too (recursive closure)
        ExpandWithDependencies(wantEnabled);

        // v0.72.8: collect operations deduplicated by "top-level physical directory" — multi-part mods
        // (e.g. [CS]/[DLL]/[FTM] under Weather Wonders - Beta) have several sub-entries sharing one top-level
        // directory; the old version moved each sub-entry separately, so after the first rename succeeded the
        // rest inevitably "could not find the mod folder". Now each top-level directory is moved only once.
        var topOps = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);  // topLevel -> disable
        foreach (var m in _mods)
        {
            var uid = m.UniqueID;
            var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
            if (m.Disabled == !shouldEnable)
                continue;
            var top = m.Folder.Split('/')[0];
            topOps.TryAdd(top, !shouldEnable);
        }

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        try
        {
            var gamePath = Cfg.Current.GamePath;
            // v0.72.8: structured error results instead of parsing strings back with Split(':') (folder names containing ':' would truncate)
            var errs = await Task.Run(() =>
            {
                var list = new List<(string Folder, string Error)>();
                foreach (var (top, disable) in topOps)
                {
                    var err = ModSvc.SetDisabled(gamePath, top, disable);
                    if (err is not null) list.Add((top, err));
                }
                return list;
            });
            foreach (var (folder, err) in errs)
                AppLog.Warn("Mods", $"Profile switch failed: {folder} - {err}");

            // incrementally update in-memory state: update Disabled + Folder and migrate caches for each sub-entry
            var errTops = new HashSet<string>(errs.Select(e => e.Folder), StringComparer.OrdinalIgnoreCase);
            foreach (var m in _mods)
            {
                var uid = m.UniqueID;
                var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
                if (m.Disabled == !shouldEnable) continue;
                var top = m.Folder.Split('/')[0];
                if (errTops.Contains(top)) continue;   // rename failed for this top-level directory; skip all its sub-entries
                var disable = !shouldEnable;
                var newFolder = disable
                    ? (m.Folder.StartsWith('.') ? m.Folder : "." + m.Folder)
                    : m.Folder.TrimStart('.');
                if (newFolder != m.Folder)
                {
                    MigrateFolderCaches(m.Folder, disable);
                    m.Folder = newFolder;
                }
                m.Disabled = disable;
            }
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"Switched to profile \"{name}\"");
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Expands the to-enable set by dependency closure: if A depends on B, enabling A must enable B (recursive).</summary>
    private void ExpandWithDependencies(HashSet<string> uids)
    {
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var queue = new Queue<string>(uids);
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!byUid.TryGetValue(cur, out var mod)) continue;
            foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
            {
                if (!string.IsNullOrWhiteSpace(dep) && uids.Add(dep))
                    queue.Enqueue(dep);   // newly added dependencies may have dependencies of their own
            }
        }
    }

    /// <summary>When disabling a mod, also disable enabled mods that depend on it (recursive) — same linkage as Stardrop.</summary>
    private void DisableDependents(string uniqueId, HashSet<string> visited, Action<ModEntry> disableOne)
    {
        if (string.IsNullOrWhiteSpace(uniqueId) || !visited.Add(uniqueId)) return;
        foreach (var m in _mods)
        {
            if (m.Disabled || string.IsNullOrWhiteSpace(m.UniqueID)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                   .Any(d => d.Equals(uniqueId, StringComparison.OrdinalIgnoreCase)))
            {
                disableOne(m);
                DisableDependents(m.UniqueID, visited, disableOne);
            }
        }
    }

    /// <summary>When enabling a mod, also enable its disabled dependencies (recursive).</summary>
    private void EnableDependencies(ModEntry mod, HashSet<string> visited, Action<ModEntry> enableOne)
    {
        if (string.IsNullOrWhiteSpace(mod.UniqueID) || !visited.Add(mod.UniqueID)) return;
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
        {
            if (string.IsNullOrWhiteSpace(dep) || !byUid.TryGetValue(dep, out var depMod)) continue;
            if (depMod.Disabled)
            {
                enableOne(depMod);
                EnableDependencies(depMod, visited, enableOne);
            }
        }
    }

    /// <summary>Site category (official Nexus category name, cached in config). Falls back to the manifest category when not cached.</summary>
    private string? GetNexusCategory(ModEntry m)
    {
        // cached official category name
        if (Cfg.Current.ModCategories.TryGetValue(m.Folder, out var name)) return name;
        var norm = m.Folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        if (key != m.Folder && Cfg.Current.ModCategories.TryGetValue(key, out name)) return name;
        // has a category_id but no cached name table -> wait for EnsureCategoriesAsync to fetch it
        var st = GetState(m.Folder);
        if (st.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out name))
            return name;
        // fallback: coarse manifest category
        return string.IsNullOrEmpty(m.Category) ? null : m.Category;
    }

    /// <summary>If the category table is empty and an API key exists, fetch and cache the official category table once.</summary>
    private async Task EnsureCategoriesAsync()
    {
        if (Cfg.Current.NexusCategories.Count > 0 || string.IsNullOrWhiteSpace(_apiKey)) return;
        try
        {
            var cats = await Nexus.GetCategoriesAsync(_apiKey);
            if (cats is { Count: > 0 })
            {
                Cfg.Current.NexusCategories = cats;
                Cfg.Save(Cfg.Current);
            }
        }
        catch (Exception ex) { AppLog.Warn("Mods", "Failed to fetch category table: " + ex.Message); }
    }

