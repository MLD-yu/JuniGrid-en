    // v0.41.0: select all of the current filtered results (only visible rows, so filtered-out mods aren't accidentally selected)
    private void SelectAll()
    {
        foreach (var m in FilteredMods) _selected.Add(m.Folder);
        _pendingBatchDelete = false;
    }

    // ── delete confirmation dialog: cancel / confirm (single goes through Uninstall, batch through BatchDelete) ──
    private void CancelDeleteMods()
    {
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
    }

    private void ConfirmDeleteMods()
    {
        var mod = _pendingDeleteMod;
        var batch = _pendingBatchDelete;
        var toTrash = _deleteToTrash;
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
        if (mod is not null) Uninstall(mod, toTrash);
        else if (batch) BatchDelete(toTrash);
    }

    /// <summary>v0.71.0: remember the list scroll position before opening the detail page (static field; survives component disposal).</summary>
    private static double _restoreScroll = -1;
    /// <summary>v0.72.0: whether we were at the bottom when leaving — the sole basis for target=limit on restore,
    /// replacing the old setScrollWhenReady guess of "y > limit means at bottom".</summary>
    private static bool _restoreAtBottom;
    /// <summary>v0.72.4: whether .jg-main still carries the restore-pending hide flag (jg-restore-pending).
    /// Used as a fallback to clear the flag when returning to the list with no snapshot, so the rows can't stay hidden forever.</summary>
    private static bool _scrollRestoreClassPending;

    /// <summary>v0.72.0: JS scroll snapshot (y + at-bottom flag).</summary>
    private sealed record ScrollSnapshot(
        [property: System.Text.Json.Serialization.JsonPropertyName("y")] double Y,
        [property: System.Text.Json.Serialization.JsonPropertyName("atBottom")] bool AtBottom);

    /// <summary>v0.72.2: scroll restore result report (diagnostics; called once when setScrollWhenReady finishes).</summary>
    private sealed class ScrollRestoreReporter
    {
        [JSInvokable]
        public void Report(double target, double finalTop, int tries, string reason) =>
            AppLog.Warn("Mods", $"[Diag] scroll restore finished reason={reason} target={target} final scrollTop={finalTop} attempts={tries}");
    }

    private async Task OpenDetail(ModEntry m)
    {
        if (m.NexusModId is not null)
        {
            // v0.72.2: diagnostic logging — the scroll chain used to be completely silent, failures untraceable.
            // jsVer detects whether the loaded interop.js is new or old (this exposes WebView2 serving a cached old JS).
            try
            {
                var jsVer = await JS.InvokeAsync<string>("eval",
                    "(window.junigridJs && window.junigridJs.getScrollState) ? 'interop-new' : 'interop-OLD-CACHED'");
                var snap = await JS.InvokeAsync<ScrollSnapshot>("junigridJs.getScrollState", ".jg-main");
                _restoreScroll = snap.Y;
                _restoreAtBottom = snap.AtBottom;
                AppLog.Warn("Mods", $"[Diag] OpenDetail snapshot js={jsVer} y={snap.Y} atBottom={snap.AtBottom}");
                // v0.72.4: mark .jg-main restore-pending — the row list stays hidden until positioned after returning,
                // so the browser never paints the "list at the top" frame (the flicker root cause)
                await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                _scrollRestoreClassPending = true;
                // v0.71.2: dual-write to sessionStorage (same key as scrollSpy) — static fields are timing-unreliable
                // under Blazor server-side route caching; sessionStorage is the durable fallback; setScrollWhenReady reads either on return.
                await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", _restoreScroll, _restoreAtBottom);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[Diag] OpenDetail snapshot failed: " + ex.Message);
            }
            Nav.NavigateTo($"mod/{m.NexusModId}" + (string.IsNullOrEmpty(m.UniqueID) ? "" : "/" + Uri.EscapeDataString(m.UniqueID)));
        }
    }

    // ------------------------------------------------------------------
    // remark/rename dialog
    // ------------------------------------------------------------------
    private void OpenRemark(ModEntry m)
    {
        CloseDropdownsForDialog();
        _remarkFolder = m.Folder;
        _remarkOriginal = m.Name;
        Cfg.Current.ModRemarks.TryGetValue(m.Folder, out var cur);
        _remarkInput = cur ?? "";
    }

    private void CancelRemark() => _remarkFolder = null;

    private void SaveRemark()
    {
        var folder = _remarkFolder;
        if (folder is not null)
        {
            var text = _remarkInput.Trim();
            if (text.Length > 20) text = text[..20];
            if (text.Length == 0) Cfg.Current.ModRemarks.Remove(folder);
            else Cfg.Current.ModRemarks[folder] = text;
            Cfg.Save(Cfg.Current);
            // v1.1.2: sync the remark into manifest.json — the in-game GMCM title uses the remark name (empty remark = restore the original name)
            var f = folder;
            var r = text;
            _ = Task.Run(() =>
            {
                var err = ModSvc.ApplyRemarkToManifest(Cfg.Current.GamePath, f, r, Cfg.Current.ModOriginalNames);
                if (err is not null)
                    AppLog.Warn("Mods", $"[remark sync] {f}: {err}");
                else
                {
                    if (r.Length > 0)
                        AppLog.Warn("Mods", $"[remark sync] {f}: wrote remark \"{r}\"; takes effect in GMCM after restarting the game");
                    // Fix: ApplyRemarkToManifest records the original name in ModOriginalNames (removed on restore),
                    // but that's an in-memory change inside this Task — the Cfg.Save above already ran, and with no other
                    // save the original-name record was lost on exit -> the parenthesized original vanished. After a
                    // successful sync, immediately save once more to pin remark/original/manifest together.
                    try { Cfg.Save(Cfg.Current); } catch { }
                }
            });
        }
        _remarkFolder = null;
    }

    private void OnRemarkKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveRemark();
        else if (e.Key == "Escape") CancelRemark();
    }

    /// <summary>Mod name shown in the list: with a remark shows "Remark(Original)", otherwise the original/translated name.
    /// v1.1.4: when the manifest has already been synced to the remark name (m.Name == remark after rescan), show the
    /// remark directly and take the original from the ModOriginalNames store, avoiding "Remark(Remark)".</summary>
    private string RemarkName(ModEntry m)
    {
        if (Cfg.Current.ModRemarks.TryGetValue(m.Folder, out var remark)
            && !string.IsNullOrWhiteSpace(remark))
        {
            var original = Cfg.Current.ModOriginalNames.TryGetValue(m.Folder, out var o)
                ? o : m.Name;
            if (!string.Equals(original, remark, StringComparison.Ordinal))
                return $"{remark}({original})";
            return remark;
        }
        return m.Name;
    }

    private void OpenUpdatePage(ModEntry m)
    {
        // v0.68.2: Nexus source first — mods with a Nexus ID (including dual-source mods like SDV-Glow) always open
        // the Nexus files page for manual download for free users; Premium members install in-app (Nexus direct link).
        // Only "pure GitHub source" mods (no Nexus source) use the in-app GitHub update.
        var isPremium = Cfg.Current.NexusIsPremium;
        if ((isPremium && m.NexusModId is not null)
            || (m.NexusModId is null && m.GitHubRepo is not null))
        {
            _ = InvokeAsync(async () =>
            {
                await UpdateOne(m);
                var st = GetState(m.Folder);
                if (st.Status == "updated")
                {
                    ShowNotice("ok", $"Updated {m.Name} ✔");
                    Rescan();
                }
                else if (st.Status == "premium" && m.NexusModId is not null)
                {
                    // account is actually not Premium (403) -> fall back to opening the website for manual download
                    UpdateService.OpenUrl(
                        $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                    ShowNotice("err", "The current Nexus account is not Premium; the Nexus download page has been opened for you");
                }
                else if (st.Status == "failed")
                {
                    ShowNotice("err", $"Update failed: {st.Message}");
                }
                else if (st.Status == "available")
                {
                    // v0.68.1: a new version exists but in-app download isn't possible (e.g. the GitHub release has no zip
                    // asset) -> fall back to opening the matching download page (GitHub releases / Nexus files page); no more dead click
                    OpenUpdateDownloadPage(m);
                    ShowNotice("ok", $"Opened the download page for {m.Name}; please download {st.RemoteVersion} manually");
                }
                StateHasChanged();
            });
            return;
        }
        if (m.NexusModId is not null)
            UpdateService.OpenUrl(
                $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }

    // ------------------------------------------------------------------
    // v1.07.0: header folder icon — opens the Mods root directory directly
    private void OpenModsRootFolder()
    {
        try
        {
            var dir = Path.Combine(Cfg.Current.GamePath, "Mods");
            if (Directory.Exists(dir))
                System.Diagnostics.Process.Start("explorer.exe", $"\"{dir}\"");
            else
                _ = JS.InvokeVoidAsync("junigridJs.toast", "Please select a valid game directory", "err");
        }
        catch { }
    }

    // ------------------------------------------------------------------
    private void OpenFolder(ModEntry m)
    {
        try
        {
            // Folder can be a multi-level relative path with / separators (nested sub-packages); explorer.exe rejects
            // forward slashes and would open the default Documents folder as an invalid argument — normalize to \ first
            var dir = Path.Combine(Cfg.Current.GamePath, "Mods", m.Folder).Replace('/', '\\');
            if (Directory.Exists(dir))
                System.Diagnostics.Process.Start("explorer.exe", $"\"{dir}\"");
            else
                _ = JS.InvokeVoidAsync("junigridJs.toast", "Folder not found; it may have been moved or deleted", "err");
        }
        catch { }
    }

    // ------------------------------------------------------------------
    // single enable / disable / delete
    // ------------------------------------------------------------------
    private void SetDisabled(ModEntry m, bool disabled)
    {
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        if (err is not null) ShowNotice("err", err);
        else
        {
            // v0.46.0: dependency linking (Stardrop-style) —
            // disable: also disable enabled mods that depend on it; enable: also enable its disabled dependencies
            var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (disabled) DisableDependents(m.UniqueID, visited, x => SetDisabledDirect(x, true));
            else EnableDependencies(m, visited, x => SetDisabledDirect(x, false));
            ShowNotice("ok", $"{(disabled ? "Disabled" : "Enabled")} {m.Name}");
            // v0.42.0: after renaming .X <-> X, migrate the update state + cover cache to the new name, otherwise
            // GetCover misses the cache under the new folder name and falls back to the letter placeholder
            MigrateFolderCaches(m.Folder, disabled);
        }
        Rescan();
        // v0.49.0: write back to the active profile immediately after a state change
        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
    }

    private void Uninstall(ModEntry m, bool toTrash)
    {
        var err = ModSvc.Uninstall(Cfg.Current.GamePath, m.Folder, toTrash);
        if (err is not null) ShowNotice("err", err);
        else ShowNotice("ok", toTrash ? $"Moved to recycle bin: {m.Name}" : $"Deleted {m.Name}");
        Rescan();
    }

    // ------------------------------------------------------------------
    // batch operations
    // ------------------------------------------------------------------
    /// <summary>Low-level enable/disable without dependency linking (used by the linking recursion to avoid infinite loops).</summary>
    private void SetDisabledDirect(ModEntry m, bool disabled)
    {
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        if (err is not null) { AppLog.Warn("Mods", $"Linked {(disabled ? "disable" : "enable")} of {m.Folder} failed: {err}"); return; }
        MigrateFolderCaches(m.Folder, disabled);
    }

    /// <summary>After disable/enable, migrate the update state + cover/category caches to the new folder name (.X <-> X).</summary>
    private void MigrateFolderCaches(string folder, bool disabled)
    {
        var newFolder = disabled
            ? (folder.StartsWith('.') ? folder : "." + folder)
            : folder.TrimStart('.');
        if (newFolder == folder) return;
        if (_states.TryGetValue(folder, out var st)) { _states[newFolder] = st; _states.Remove(folder); }
        MigrateDictKey(Cfg.Current.ModCovers, folder, newFolder);
        MigrateDictKey(Cfg.Current.ModCategories, folder, newFolder);
        _coversDirty = true;
        Cfg.Save(Cfg.Current);
    }

    private static void MigrateDictKey(Dictionary<string, string> dict, string oldKey, string newKey)
    {
        if (dict.TryGetValue(oldKey, out var v)) { dict[newKey] = v; dict.Remove(oldKey); }
    }

    private async Task BatchSetDisabled(bool disabled)
    {
        // v0.72.7: batch enable/disable moved to a background thread (same pattern as ApplyProfile) — the old code
        // ran N Directory.Move calls synchronously on the UI thread, freezing the window at 63 mods. watcher OFF/ON is
        // wrapped in try/finally so an exception mid-way doesn't permanently kill file watching.
        var topLevels = _selected
            .Select(f => f.Split('/')[0])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var gamePath = Cfg.Current.GamePath;
        var selCount = _selected.Count;

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        int failed;
        try
        {
            failed = await Task.Run(() =>
            {
                var f = 0;
                foreach (var top in topLevels)
                    if (ModSvc.SetDisabled(gamePath, top, disabled) is not null)
                        f++;
                return f;
            });
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0
                ? $"{(disabled ? "Disabled" : "Enabled")} {selCount} mods"
                : $"{failed} operations failed");
        ClearSelection();

        // v0.72.9: migrate cover/category caches uniformly after batch rename — v0.72.7 dropped MigrateFolderCaches
        // from the batch path, so after renaming the _states/ModCovers/ModCategories keys kept the old folder names,
        // GetCover/GetNexusCategory missed -> covers vanished and categories fell back to "code mod".
        foreach (var top in topLevels)
            MigrateFolderCaches(top, disabled);

        Rescan();
        // v0.72.9: explicitly trigger one cover backfill (with a concurrency gate, never stacked) — the folder changed
        // after the batch rename, so covers under the new keys need to be fetched again.
        if (!!NexusService.IsAuthenticated) _ = BackfillCoversAsync();

        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
    }

    private void BatchDelete(bool toTrash)
    {
        _pendingBatchDelete = false;
        var count = _selected.Count;
        var failed = 0;
        foreach (var folder in _selected.ToList())
            if (ModSvc.Uninstall(Cfg.Current.GamePath, folder, toTrash) is not null)
                failed++;

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0
                ? toTrash ? $"Moved {count} mods to the recycle bin" : $"Deleted {count} mods"
                : $"{failed} deletions failed");
        ClearSelection();
        Rescan();
    }

    private async Task BatchUpdate()
    {
        // v0.68.0: batch update — routed strictly by "verified Premium":
        //  free users -> open each selected mod's Nexus files page in the system browser one by one (one tab each);
        //            v0.68.2: anything with a Nexus source goes to Nexus (dual-source mods can jump too);
        //            only pure GitHub sources (no Nexus source) update in-app for free;
        //  Premium  -> everything auto-updates in-app one by one (Nexus first), no browser tabs.
        var selectedMods = _mods.Where(m => _selected.Contains(m.Folder)).ToList();
        if (selectedMods.Count == 0)
        {
            ShowNotice("err", "No mods selected.");
            return;
        }
        var isPremium = Cfg.Current.NexusIsPremium;
        var ghTargets = selectedMods
            .Where(m => m.NexusModId is null && m.GitHubRepo is not null && !m.Disabled).ToList();

        if (!isPremium)
        {
            var webTargets = selectedMods
                .Where(m => m.NexusModId is not null).ToList();
            foreach (var m in webTargets)
            {
                UpdateService.OpenUrl(
                    $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                await Task.Delay(200);   // open one by one so the browser doesn't merge or block the tabs
            }
            if (webTargets.Count > 0)
                ShowNotice("ok", $"Opened Nexus download pages for {webTargets.Count} mods (free accounts must download manually in the browser)");
            if (webTargets.Count == 0 && ghTargets.Count == 0)
            {
                ShowNotice("err", "None of the selected mods has a Nexus ID or GitHub source to update from (mostly local/other-source mods)");
                return;
            }
            if (ghTargets.Count > 0)
            {
                ShowNotice("ok", $"Updating {ghTargets.Count} GitHub-source mods in-app…");
                await RunUpdatePipeline(ghTargets);
            }
            return;
        }

        var targets = selectedMods
            .Where(m => (m.NexusModId is not null || m.GitHubRepo is not null) && !m.Disabled)
            .ToList();
        if (targets.Count == 0)
        {
            ShowNotice("err", "None of the selected mods can be auto-updated (missing Nexus/GitHub update identifiers, or disabled).");
            return;
        }
        ShowNotice("ok", $"Updating {targets.Count} mods in-app one by one… (runs in the background; you'll be notified when done)");
        if (NexusService.IsAuthenticated)
            _ = BackfillCoversAsync();
        await RunUpdatePipeline(targets);
        // v0.68.1: for GitHub-source releases without a zip asset that can't be installed in-app, open their download page too
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    /// <summary>v0.41.0: backfills Nexus covers for every mod missing one (disabled mods included).
    /// v0.72.7: single-instance concurrency gate — at most one backfill task runs at a time.
    /// vNext: serial one-by-one fetching became 6-way concurrency (sharing the update-check budget) — with dozens of
    /// missing covers the old version waited through dozens of serial round trips, covers "popping in" one at a time.</summary>
    private int _backfillRunning;

    private async Task BackfillCoversAsync()
    {
        // the old wrapper BackfillCoversCoreAsync had its try block recursively call itself (not the real implementation),
        // so opening the gate meant infinite recursion and a stack overflow — deleted outright, gate moved to the top of this method
        if (Interlocked.Exchange(ref _backfillRunning, 1) == 1) return;
        try
        {
            var need = _mods
                .Where(m => m.NexusModId is not null)
                .Where(m => string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                            && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                            && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                .ToList();
            if (need.Count == 0) return;
            var semaphore = new SemaphoreSlim(12);   // v1.06.8: cover backfill concurrency doubled
            await Task.WhenAll(need.Select(async m =>
            {
                await semaphore.WaitAsync();
                try
                {
                    var info = await Nexus.GetModAsync(m.NexusModId!.Value);
                    if (info is not null && !string.IsNullOrEmpty(info.PictureUrl))
                    {
                        GetState(m.Folder).PictureUrl = info.PictureUrl;
                        Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                        _coversDirty = true;
                    }
                    // v0.46.0: also cache the website category (category_id -> name via the NexusCategories table)
                    if (info?.CategoryId is int cid)
                    {
                        GetState(m.Folder).CategoryId = cid;
                        if (Cfg.Current.NexusCategories.TryGetValue(cid, out var cname))
                            Cfg.Current.ModCategories[m.Folder] = cname;
                    }
                }
                catch (Exception ex) { AppLog.Warn("Mods", "Cover backfill failed (" + m.Folder + "): " + ex.Message); }
                finally { semaphore.Release(); }
            }));
            if (_coversDirty)
            {
                Cfg.Save(Cfg.Current);
                _coversDirty = false;
            }
            await InvokeAsync(StateHasChanged);
        }
        finally { Interlocked.Exchange(ref _backfillRunning, 0); }
    }

    // ------------------------------------------------------------------
    // update check + auto-update
    // ------------------------------------------------------------------

    private async Task AutoUpdateOnEnterAsync()
    {
        // v0.68.3: auto-update policy on entering the Mod page — decided entirely by the Settings page's
        // "auto-install updates" switch (EnableAutoInstall, Premium only); no more prompting.
        //  (1) switch off / free account -> only CheckOnlyOne marks the updatable arrow; never installs
        //  (2) switch on (Premium) -> after checking, runs RunUpdatePipeline on every updatable item in-app
        await CheckUpdates();

        if (!Cfg.Current.NexusIsPremium || !Cfg.Current.EnableAutoInstall) return;

        var targets = _mods.Where(IsUpdatable).ToList();
        if (targets.Count == 0) return;
        ShowNotice("ok", $"Auto-updating {targets.Count} mods…");
        await RunUpdatePipeline(targets);
        // for GitHub-source releases without a zip asset, open their download page too
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    private async Task CheckUpdates(bool force = false)
    {
        // v1.08: disabled mods are checked too — disabling doesn't mean "don't update"; check only, no install, no side effects
        var targets = _mods
            .Where(m => m.NexusModId is not null || m.GitHubRepo is not null)
            // v0.44.0: skip mods checked within the last 60 minutes (no request right now); their remote version state keeps displaying
            // v1.06.7: force=true (top-bar current-page icon refresh) ignores the TTL and re-checks everything —
            // otherwise after installing an older mod version, a refresh within the hour would skip it ("no update found")
            .Where(m => force || !_lastCheckedUtc.TryGetValue(m.Folder, out var t)
                        || DateTime.UtcNow - t > UpdateCheckTtl)
            .ToList();

        // v0.46.0: on the first update check, also fetch the official category table (works only with a key)
        if (NexusService.IsAuthenticated) _ = EnsureCategoriesAsync();

        // works without a Nexus key too — GitHub-source mods need no key at all
        if (!NexusService.IsAuthenticated)
            targets = targets.Where(m => m.GitHubRepo is not null).ToList();

        // vNext: nothing to check (all hits within TTL / no key and no GitHub sources) -> return silently, no more
        // flashing the "Checking for updates…" state (it used to blink every time you returned to the page)
        if (targets.Count == 0) return;

        // vNext: the list is already visible; the checking state shows only in the header small text instead of swapping the whole page to a skeleton
        _checkingUpdates = true;
        _checkingTick = Environment.TickCount64;
        StateHasChanged();

        // v0.41.0: cover backfill — disabled mods don't take part in update checks, but their covers are still
        // fetched once via Nexus detail so "disabling doesn't lose the cover". Only the lightest GetModAsync, caching
        // PictureUrl, no update logic triggered.
        // vNext: moved to AFTER the check pipeline — the fingerprint fast path already brings most covers back (zero
        // requests for the vast majority); the rest (failed batches/GitHub sources/disabled rows) fall back to here, no
        // longer competing with version checks for connections and rate-limit windows.
        // v0.68.0: checking runs the "check-only" pipeline (CheckOnlyOne never downloads or installs);
        // installing only happens via RunUpdatePipeline after the user confirms.
        await RunCheckPipeline(targets);
        if (NexusService.IsAuthenticated)
            _ = BackfillCoversAsync();
    }

    /// <summary>v0.68.0: parallel pipeline that only detects versions — never downloads or installs.
    /// vNext: runs the "fingerprint batch fast path" first — one keyless GraphQL batch (50 per batch) fetches updatedAt
    /// for all Nexus mods and compares against persisted fingerprints character by character: matching mods directly
    /// reuse the latest MAIN file version found by the last precise check (file list unchanged, so results can't be
    /// stale), the whole batch returns in seconds with zero requests; only the few mods with changed/missing
    /// fingerprints or missing batch results fall through to per-mod files.json precise checks, whose results plus new
    /// fingerprints are written back to cache.
    /// Regular page entries (app restart / past the 60-minute TTL) collapse from N requests to ~N/50, and the shimmer
    /// skeleton drops from tens of seconds to about 1 second. If the batch fails entirely, everything falls back to
    /// precise checks (same as the old behavior — slow is better than wrong).</summary>
    // ------------------------------------------------------------------
    // v1.08: region-friendly fast path — batch pre-check via the official smapi.io web API
    // one POST queries every mod (Cloudflare direct connection in ~1 second, no VPN, no timeout).
    // folder -> latest version; null = the fast path didn't cover that mod (continue to the Nexus precise check).
    // if the whole request fails the entire field is null and behavior falls back to the original Nexus/GitHub flow.
    // ------------------------------------------------------------------
    private Dictionary<string, string?>? _smapiPrecheck;

    // v1.08: session-level cache of pre-check results, uid -> (latest version, time). Repeated refreshes within
    // 10 minutes hit the cache and skip even that one smapi.io request. null versions (fast path confirmed up to date) are cached too.
    private static readonly Dictionary<string, (string? Ver, DateTime At)> SmapiPrecheckCache = new();
    private static readonly TimeSpan SmapiPrecheckTtl = TimeSpan.FromMinutes(10);

    private static readonly HttpClient SmapiWebHttp = CreateSmapiWebHttp();
    private static HttpClient CreateSmapiWebHttp()
    {
        var h = new HttpClient();
        h.DefaultRequestHeaders.UserAgent.ParseAdd("JuniGrid-Launcher");
        h.Timeout = TimeSpan.FromSeconds(15);
        return h;
    }

    private async Task SmapiBatchPrecheck(List<ModEntry> targets)
    {
        _smapiPrecheck = null;
        if (targets.Count == 0) return;

        var keyOf = (ModEntry m) => string.IsNullOrEmpty(m.UniqueID) ? $"FAKE.Nexus.{m.NexusModId ?? 0}" : m.UniqueID;

        // v1.08: consume the session cache first — a full hit finishes the pre-check with zero requests
        var needFetch = new List<ModEntry>();
        foreach (var m in targets)
        {
            if (SmapiPrecheckCache.TryGetValue(keyOf(m), out var hit)
                && DateTime.UtcNow - hit.At < SmapiPrecheckTtl)
                continue;
            needFetch.Add(m);
        }
        if (needFetch.Count == 0)
        {
            _smapiPrecheck = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Ver : null);
            return;
        }

        // when the same UniqueID/ID is installed multiple times (original + stale copy), send one request per id and share the results
        var payload = System.Text.Json.JsonSerializer.Serialize(new
        {
            mods = needFetch.Select(m => new
            {
                id = keyOf(m),
                updateKeys =
                    (m.NexusModId is int nid ? new[] { $"nexus:{nid}" } : Array.Empty<string>())
                    .Concat(m.GitHubRepo is string gh ? new[] { $"github:{gh}" } : Array.Empty<string>()),
                installedVersion = m.Version,
            }),
        });

        try
        {
            using var resp = await SmapiWebHttp.PostAsync(
                "https://smapi.io/api/v4.0.0/mods",
                new StringContent(payload, System.Text.Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode) return;
            using var doc = System.Text.Json.JsonDocument.Parse(await resp.Content.ReadAsStringAsync());

            var versionById = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var id = item.TryGetProperty("id", out var i) ? i.GetString() : null;
                var ver = item.TryGetProperty("suggestedUpdate", out var su)
                    && su.ValueKind == System.Text.Json.JsonValueKind.Object
                    && su.TryGetProperty("version", out var v) ? v.GetString() : null;
                if (!string.IsNullOrEmpty(id)) versionById[id] = ver;
            }

            foreach (var m in targets)
            {
                var k = keyOf(m);
                if (versionById.TryGetValue(k, out var v))
                    SmapiPrecheckCache[k] = (v ?? "", DateTime.UtcNow);
            }
            _smapiPrecheck = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Ver : null);
            // value semantics: non-empty string = latest version from the fast path; empty string = fast path confirmed
            // up to date; null = fast path didn't cover it (no UpdateKey / not indexed) -> fall back to the precise check.
        }
        catch (Exception ex)
        {
            AppLog.Warn("Mods", "[smapi fast path] smapi.io pre-check failed (falling back to Nexus/GitHub): " + ex.Message);
        }
    }

    private async Task RunCheckPipeline(List<ModEntry> targets)
    {
        // v1.08: the smapi.io fast path and the Nexus fingerprint batch run in parallel (previously serial, wasting a
        // round trip); the pre-check results aren't needed until the precise-check phase starts.
        var smapiTask = SmapiBatchPrecheck(targets);

        var precise = targets;
        Dictionary<int, string>? fpUpdatedAt = null;   // modId -> batch fingerprint updatedAt (written back to cache after a successful precise check)
        if (NexusService.IsAuthenticated)
        {
            var nexusIds = targets.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToList();
            if (nexusIds.Count > 0)
            {
                var fps = await Nexus.GetModFingerprintsBatchAsync(nexusIds);
                if (fps is not null)
                {
                    fpUpdatedAt = fps.ToDictionary(kv => kv.Key, kv => kv.Value.UpdatedAt);
                    var rest = new List<ModEntry>();
                    foreach (var m in targets)
                    {
                        if (m.NexusModId is int id && fps.TryGetValue(id, out var fp))
                        {
                            _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
                            // cover comes free with the batch (pictureUrl), eliminating most cover backfill requests
                            if (!string.IsNullOrEmpty(fp.PictureUrl)
                                && string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                                && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                                && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                            {
                                Cfg.Current.ModCovers[m.Folder] = fp.PictureUrl;
                                _coversDirty = true;
                            }
                            if (Cfg.Current.ModUpdateFingerprints.TryGetValue(id, out var cached)
                                && string.Equals(cached.UpdatedAt, fp.UpdatedAt, StringComparison.Ordinal)
                                && !string.IsNullOrWhiteSpace(cached.LatestFileVersion)
                                && DateTime.UtcNow - cached.CheckedAtUtc < FingerprintMaxAge)
                            {
                                // fingerprint matches -> remote file list unchanged -> reuse the last precise check's file version
                                RememberRemoteVersion(m.Folder, cached.LatestFileVersion);
                                _states[m.Folder] = new ModUpdateState
                                {
                                    Status = IsNewer(cached.LatestFileVersion, m.Version) ? "available" : "latest",
                                    RemoteVersion = cached.LatestFileVersion,
                                };
                                continue;
                            }
                        }
                        rest.Add(m);   // missing/changed fingerprint, no cache, or GitHub source -> precise-check one by one
                    }
                    precise = rest;
                    StateHasChanged();   // fast-path results go up immediately; precise-check states let the arrows trickle in
                }
            }
        }

        await smapiTask;   // v1.08: wait for the fast-path result before precise checks (usually already done in parallel)

        if (precise.Count > 0)
        {
            var semaphore = new SemaphoreSlim(32);   // v1.06.8: check-only, no downloads; concurrency maxed at 32
            // vNext: precise-check requests for the same modId are shared across the whole pipeline (one request even if a mod is installed twice)
            var byId = new System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>();
            await Task.WhenAll(precise.Select(async m =>
            {
                await semaphore.WaitAsync();
                try { await CheckOnlyOne(m, byId, fpUpdatedAt); }
                finally { semaphore.Release(); }
            }));
        }

        if (_fpDirty)
        {
            // also purge fingerprints of uninstalled mods so the cache doesn't grow forever
            var liveIds = _mods.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToHashSet();
            foreach (var staleId in Cfg.Current.ModUpdateFingerprints.Keys.Where(id => !liveIds.Contains(id)).ToList())
                Cfg.Current.ModUpdateFingerprints.Remove(staleId);
        }
        if (_coversDirty || _fpDirty)
        {
            Cfg.Save(Cfg.Current);
            _coversDirty = false;
            _fpDirty = false;
        }
        // vNext: the list is visible during checks (no more skeleton swap); the artificial 0.6s minimum delay was removed
        _checkingUpdates = false;
        StateHasChanged();
    }

    /// <summary>
    /// v0.68.0: check-only for a single mod — fetches the remote version + cover + category,
    /// marks updatable versions with the ⇧ arrow only; never starts a download or install.
    /// (Split out of UpdateOne: separating check from install is the prerequisite for "ask, then update")
    /// </summary>
    private async Task CheckOnlyOne(ModEntry m,
        System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>? sharedFetch = null,
        IReadOnlyDictionary<int, string>? fpUpdatedAt = null,
        bool isRetry = false)
    {
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        try
        {
            // v1.08: smapi.io batch fast-path hit -> adopt the result with zero requests.
            //   non-empty = latest version from the fast path; empty string = fast path confirmed up to date;
            //   null = fast path didn't cover this mod (no UpdateKey/not indexed), continue with the normal precise check.
            if (_smapiPrecheck is not null && _smapiPrecheck.TryGetValue(m.Folder, out var preVer))
            {
                if (preVer is not null)
                {
                    if (preVer.Length > 0)
                    {
                        st.RemoteVersion = preVer;
                        RememberRemoteVersion(m.Folder, preVer);
                        st.Status = IsNewer(preVer, m.Version) ? "available" : "latest";
                    }
                    else
                    {
                        st.Status = "latest";
                    }
                    StateHasChanged();
                    return;
                }
            }

            // v0.68.2: check the Nexus source first; only query GitHub when there's no Nexus source or the fetch failed
            // v0.72.0: unify the check and install sources — go by the latest MAIN file version in files.json
            // (same authoritative source as UpdateOne/one-click install's GetLatestMainFileAsync). The old logic took
            // the top-level version in mods/{id}.json (author-entered, often lagging the main file), which caused the
            // contradiction of "local 1.3.0 judged up to date, yet clicking update installs 1.3.1".
            if (m.NexusModId is not null && NexusService.IsAuthenticated)
            {
                // vNext: precise-check results for the same modId are shared within the pipeline — a mod installed
                // twice (original + stale copy) sends one files.json request and both rows use the result
                NexusFileInfo? file;
                if (sharedFetch is not null)
                    file = await sharedFetch.GetOrAdd(m.NexusModId!.Value,
                        k => Nexus.GetLatestMainFileAsync(k));
                else
                    file = await Nexus.GetLatestMainFileAsync(m.NexusModId!.Value);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // fallback when the main file has no version: use the mod's top-level version (grabbing the cover
                    // too; routine missing covers are BackfillCoversAsync's job, so no extra requests here)
                    var info = await Nexus.GetModAsync(m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }
                if (remoteVer is not null)
                {
                    st.RemoteVersion = remoteVer;
                    RememberRemoteVersion(m.Folder, remoteVer);
                    st.Status = IsNewer(remoteVer, m.Version) ? "available" : "latest";
                    // vNext: precise check succeeded -> write the version to the persistent cache along with this
                    // round's updatedAt fingerprint; on the next page entry an unchanged fingerprint reuses it directly
                    // (the fast path's zero-request data source)
                    if (fpUpdatedAt is not null && fpUpdatedAt.TryGetValue(m.NexusModId!.Value, out var ua))
                    {
                        Cfg.Current.ModUpdateFingerprints[m.NexusModId!.Value] = new ModUpdateFingerprintEntry
                        {
                            UpdatedAt = ua,
                            LatestFileVersion = remoteVer,
                            CheckedAtUtc = DateTime.UtcNow,
                        };
                        _fpDirty = true;
                    }
                    StateHasChanged();
                    return;
                }
            }

            // GitHub fallback: mods with no Nexus source (or a failed Nexus query)
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    st.Status = IsNewer(gh.Tag, m.Version) ? "available" : "latest";
                    StateHasChanged();
                    return;
                }
            }

            if (st.Status is "checking")
                st.Status = st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version)
                    ? "available" : "latest";
        }
        catch (Exception ex)
        {
            // v1.08: auto-retry once on timeout/network jitter; only mark red and show a friendly error if it still fails
            if (!isRetry && IsTransientNetworkError(ex))
            {
                await Task.Delay(800);
                await CheckOnlyOne(m, sharedFetch, fpUpdatedAt, isRetry: true);
                return;
            }
            st.Status = "failed"; st.Message = FriendlyUpdateError(ex);
        }
        StateHasChanged();
    }

    /// <summary>Timeout/network failure -> friendly message; other exceptions keep the original text for troubleshooting.</summary>
    private static string FriendlyUpdateError(Exception ex)
    {
        if (ex is TaskCanceledException or OperationCanceledException
            || ex.Message?.Contains("HttpClient.Timeout", StringComparison.Ordinal) == true)
            return "Update check timed out (unstable Nexus connection); the automatic retry also failed. Please try again later";
        if (ex is HttpRequestException)
            return "Network connection failed — check your network and try again";
        return ex.Message ?? "Unknown error";
    }

    private static bool IsTransientNetworkError(Exception ex)
        => ex is TaskCanceledException or OperationCanceledException or HttpRequestException
           || ex.Message?.Contains("HttpClient.Timeout", StringComparison.Ordinal) == true;

    private async Task RunUpdatePipeline(List<ModEntry> targets)
    {
        StateHasChanged();

        // v0.60.0: version checks run in parallel (8-way concurrency) so one slow/timing-out source can't hold up the page's update states.
        var semaphore = new SemaphoreSlim(16);
        await Task.WhenAll(targets.Select(async m =>
        {
            await semaphore.WaitAsync();
            try { await UpdateOne(m); }
            finally { semaphore.Release(); }
        }));

        if (_coversDirty)
        {
            Cfg.Save(Cfg.Current);   // persist the cover cache picked up along the way
            _coversDirty = false;
        }

        _checkingUpdates = false;

        var states = targets.Select(t => GetState(t.Folder)).ToList();
        var updated = states.Count(s => s.Status == "updated");
        var failed = states.Count(s => s.Status == "failed");
        var premiumBlocked = states.Count(s => s.Status == "premium");
        if (updated > 0) Rescan();
        // v0.68.0: merged into one completion summary (two toasts used to push each other out), and a premium
        // block (free account entering the pipeline by mistake) gets explicit feedback; no more dead silence
        var manualGh = states.Count(s => s.Status == "available");
        if (updated > 0 || failed > 0 || premiumBlocked > 0 || manualGh > 0)
            ShowNotice(failed == 0 && premiumBlocked == 0 ? "ok" : "err",
                $"Auto-updated {updated} mods ✔"
                + (failed > 0 ? $"; {failed} failed (see each row for the reason)" : "")
                + (premiumBlocked > 0 ? $"; {premiumBlocked} require Premium (click the row update button to download manually on Nexus)" : "")
                + (manualGh > 0 ? $"; {manualGh} releases have no install package; the download page is open / use the row ⇧ button to update manually" : ""));

        // vNext: the artificial 0.6s "loading feel" delay was removed — updating states all render live in the rows

        StateHasChanged();
    }

    private async Task UpdateOne(ModEntry m, bool isRetry = false)
    {
        // v0.61.0: keep the old RemoteVersion when creating a new state so the updatable list isn't wiped and rebuilt mid-check (screenshot-3 flicker)
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        StateHasChanged();
        try
        {
            // ── (1) Nexus source first (v0.68.2): mods with a Nexus source always check and download via Nexus,
            //    dual-source mods like SDV-Glow are no longer snatched by the GitHub source (free users' batch updates can jump to Nexus too) ──
            if (m.NexusModId is not null && NexusService.IsAuthenticated)
            {
                // v0.72.0: resolve the "latest MAIN file" first; check and install share this one authoritative source.
                // The old logic checked the top-level version in mods/{id}.json but only consulted the files.json main
                // file at install time; mismatched versions produced "no update found, yet updating installs a higher version".
                var file = await Nexus.GetLatestMainFileAsync(m.NexusModId!.Value);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // fallback when the main file has no version: use the mod's top-level version (grabbing the cover too)
                    var info = await Nexus.GetModAsync(m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }

                if (remoteVer is not null)
                {
                    st.RemoteVersion = remoteVer;
                    RememberRemoteVersion(m.Folder, remoteVer);

                    if (IsNewer(remoteVer, m.Version))
                    {
                        // ── new version found -> automatic download & install via Nexus direct link, no website ──
                        if (file is null)
                        {
                            // judged updatable but no downloadable file available -> mark as available for the in-row ⇧ manual path instead of failing hard
                            st.Status = "available"; st.Message = null;
                            StateHasChanged(); return;
                        }
                        st.Status = "updating";
                        st.Message = $"New version {remoteVer} found (Nexus source); auto-updating…";
                        StateHasChanged();

                        var dl = await Nexus.GetDownloadUrlAsync(m.NexusModId!.Value, file.FileId);
                        if (dl.NeedsPremium)
                        {
                            st.Status = "premium";
                            st.Message = null;   // minimal: only a purple ⇧ new tag after the version number; no yellow message
                            StateHasChanged(); return;
                        }
                        if (dl.Url is null)
                        {
                            st.Status = "failed"; st.Message = "Failed to get the download URL: " + dl.Error;
                            StateHasChanged(); return;
                        }

                        var zip = Path.Combine(StoragePaths.DownloadsDir,
                            $"mod-{m.NexusModId}-{file.FileId}.zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(zip)!);
                        await DownloadWithTask(
                            dl.Url, zip,
                            $"Update mod \"{m.Name}\"",
                            $"Downloading {m.Name}…",
                            (msg, pct, spd) => { st.Message = msg; StateHasChanged(); });

                        var err = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, zip, out var newVer);
                        if (err is null)
                        {
                            st.Status = "updated";
                            st.Message = null;   // v0.60.0: no green message row when an update completes
                            // v0.69.0: record the download date (used by the detail page\'s "last downloaded")
                            Cfg.Current.ModLastDownload[m.NexusModId!.Value.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            Cfg.Current.ModFileLastDownload[file.FileId.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            Cfg.Save(Cfg.Current);
                        }
                        else
                        {
                            st.Status = "failed"; st.Message = "Install failed: " + err;
                        }
                        StateHasChanged();
                        return;
                    }

                    // already latest on Nexus: dual-source mods keep checking GitHub as fallback; pure Nexus mods finalize here
                    if (m.GitHubRepo is null)
                    {
                        st.Status = "latest"; st.Message = null;
                        StateHasChanged(); return;
                    }
                }
            }

            // ── (2) GitHub fallback: pure GitHub sources (no Nexus source) or dual-source mods whose Nexus query failed ──
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    if (IsNewer(gh.Tag, m.Version) && gh.ZipUrl is not null)
                    {
                        st.Status = "updating";
                        st.Message = $"New version {gh.Tag} found (GitHub source); auto-updating…";
                        StateHasChanged();

                        var ghZip = Path.Combine(StoragePaths.DownloadsDir,
                            "gh-" + m.GitHubRepo.Replace('/', '-') + ".zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(ghZip)!);
                        await DownloadWithTask(
                            gh.ZipUrl, ghZip,
                            $"Update mod \"{m.Name}\"",
                            $"Downloading {m.Name} (GitHub source)…",
                            (msg, pct, spd) => { st.Message = msg; StateHasChanged(); });

                        // expectedUniqueId safety lock: prevents installing the wrong mod when several share a repository
                        var ghErr = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, ghZip,
                            out var ghNewVer,
                            expectedUniqueId: string.IsNullOrEmpty(m.UniqueID) ? null : m.UniqueID);
                        if (ghErr is null)
                        {
                            st.Status = "updated";
                            st.Message = null;
                        }
                        else
                        {
                            st.Status = "failed";
                            st.Message = "GitHub update failed: " + ghErr;
                        }
                        StateHasChanged();
                        return;
                    }
                    if (IsNewer(gh.Tag, m.Version))
                    {
                        st.Status = "available";
                        st.Message = $"GitHub {gh.Tag}";
                        StateHasChanged();
                        return;
                    }
                }
            }

            // neither source has an update / both queries failed -> keep the existing remote marker or set latest
            if (st.Status is "checking")
            {
                st.Status = st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version)
                    ? "available" : "latest";
                st.Message = null;
            }
        }
        catch (Exception ex)
        {
            // v1.08: auto-retry once on timeout/network jitter; only mark red and show a friendly error if it still fails
            if (!isRetry && IsTransientNetworkError(ex))
            {
                await Task.Delay(800);
                await UpdateOne(m, isRetry: true);
                return;
            }
            st.Status = "failed"; st.Message = FriendlyUpdateError(ex);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Mod downloads also go through the task center (bottom-right task pill + /tasks page),
    /// sharing the same download page as SMAPI updates. Reports percent/speed/current step while downloading.
    /// </summary>
    private async Task DownloadWithTask(
        string url, string zipPath, string taskTitle, string startMsg,
        Action<string, double?, double?>? onTick = null)
    {
        var task = Center.Start(taskTitle, "download");
        try
        {
            Center.Report(task, startMsg, 0, 0);
            onTick?.Invoke(startMsg, null, null);
            var progress = new Progress<NexusDownloadProgress>(p =>
                _ = InvokeAsync(() =>
                {
                    Center.Report(task, p.Message, p.Percent, p.SpeedMBps);
                    onTick?.Invoke(p.Message, p.Percent, p.SpeedMBps);
                }));
            // v1.08: if a direct GitHub download fails (blocked 443 in some regions), automatically retry with mirror
            // prefixes; Nexus CDN URLs are signed and can't be proxied by mirrors, so they stay direct.
            if (url.Contains("github.com/", StringComparison.OrdinalIgnoreCase)
                && !url.StartsWith("https://api.github.com/", StringComparison.Ordinal))
            {
                Exception? last = null;
                foreach (var candidate in UpdateService.GithubUrls(url))
                {
                    try
                    {
                        if (candidate != url)
                        {
                            try { System.IO.File.Delete(zipPath); } catch { }
                            Center.Report(task, "GitHub direct connection failed; switching to mirror download…", 0, 0);
                        }
                        await Nexus.DownloadFileAsync(candidate, zipPath, progress);
                        Center.Finish(task, true, "Download complete");
                        return;
                    }
                    catch (Exception ex) when (ex is not OperationCanceledException) { last = ex; }
                }
                throw last!;
            }

            await Nexus.DownloadFileAsync(url, zipPath, progress);
            Center.Finish(task, true, "Download complete");
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, ex.Message);
            throw;
        }
    }

    /// <summary>
    /// SMAPI one-click auto-update: downloads the official installer in the background -> runs
    /// SMAPI.Installer.exe unattended (--install --no-prompt --game-path),
    /// with no windows or browser jumps throughout; the status refreshes automatically when done.
    /// </summary>
    /// <summary>v0.36.0: one-click download & install when SMAPI isn't installed — shares the same fully automatic
    /// installer as UpdateSmapi (RunSmapiInstallerAsync downloads the zip + deploys files silently),
    /// requiring no manual steps from the user.</summary>
    private async Task InstallSmapi()
    {
        if (_smapiUpdating) return;
        // v1.08: task-center-level dedupe — also blocks the window where a page rebuild resets _smapiUpdating to false
        if (Center.Items.Any(t => t.Status == "running"
                && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase)))
        { ShowNotice("err", "An SMAPI task is already running; please wait for it to finish"); return; }
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null || _smapiUpdate.InstallerZipUrl is null)
        {
            ShowNotice("err", "SMAPI download URL not available yet; try again later (or check your network).");
            return;
        }

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "install");
        var progress = new Progress<UpdateService.InstallProgress>(p =>
            _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));

        // v1.08: no longer auto-navigates to the tasks page — the bottom-right task pill shows progress without interrupting the page

        try
        {
            var err = await Updater.RunSmapiInstallerAsync(
                _smapiUpdate, Cfg.Current.GamePath, progress);

            if (err is null)
            {
                Center.Finish(task, true, $"SMAPI {_smapiUpdate.LatestVersion} installed");
                _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath);
                _smapiUpdate = await Updater.CheckSmapiAsync(_smapiVersion);
                // rescan the mod list after installing (SMAPI's bundled ConsoleCommands/SaveBackup will appear in the list)
                _ = InvokeAsync(RescanAndRestate);
            }
            else
            {
                Center.Finish(task, false, "❌ " + err);
            }
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, "❌ " + ex.Message);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateSmapi()
    {
        if (_smapiUpdating) return;
        if (Center.Items.Any(t => t.Status == "running"
                && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase)))
        { ShowNotice("err", "An SMAPI task is already running; please wait for it to finish"); return; }
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null) return;

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "update");
        var progress = new Progress<UpdateService.InstallProgress>(p =>
            _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));

        // jump to the tasks page immediately to watch progress (the bottom-right pill updates in sync)
        Nav.NavigateTo("/tasks");

        try
        {
            var err = await Updater.RunSmapiInstallerAsync(
                _smapiUpdate, Cfg.Current.GamePath, progress);

            if (err is null)
            {
                Center.Finish(task, true, $"SMAPI updated to {_smapiUpdate.LatestVersion}");   // v1.1.3: ✅ removed — the last timeline row already has a solid green check
                _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath);
                _smapiUpdate = await Updater.CheckSmapiAsync(_smapiVersion);
            }
            else
            {
                Center.Finish(task, false, "❌ " + err);
            }
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, "❌ " + ex.Message);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>v0.68.1: opens the mod's download page (GitHub releases first, then the Nexus files page).</summary>
    private static void OpenUpdateDownloadPage(ModEntry m)
    {
        if (m.GitHubRepo is not null)
            UpdateService.OpenUrl($"https://github.com/{m.GitHubRepo}/releases/latest");
        else if (m.NexusModId is not null)
            UpdateService.OpenUrl($"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }

    private void ShowNotice(string kind, string text)
    {
        // v0.43.1: success/deletion -> black toast with white text; errors -> red toast with white text; everything is also logged
        if (kind == "err") AppLog.Error("Mods", text); else AppLog.Warn("Mods", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, kind == "err" ? "err" : "ok");
    }

    private static bool IsNewer(string remote, string local)
    {
        // v0.71.8: segment-by-segment numeric comparison of semantic versions. The old logic degraded to
        // "string inequality = update available" whenever Version.TryParse failed — prerelease suffixes (0.2.8-beta),
        // four segments (0.2.8.1), or space/hyphen differences all made "same version" falsely updatable (the root
        // cause of Event Lookup showing an update button while already current). Now strips the v/V prefix and -beta
        // style suffixes, then compares segment values numerically, padding missing segments with 0; fully equal -> no update.
        static int[] Parts(string v)
        {
            var s = v.Trim().TrimStart('v', 'V');
            var dash = s.IndexOfAny(new[] { '-', '+', ' ' });   // strip prerelease/build metadata
            if (dash >= 0) s = s[..dash];
            var segs = s.Split('.', StringSplitOptions.RemoveEmptyEntries);
            var nums = new int[segs.Length];
            for (var i = 0; i < segs.Length; i++)
            {
                var digits = new string(segs[i].TakeWhile(char.IsDigit).ToArray());
                nums[i] = int.TryParse(digits, out var n) ? n : 0;
            }
            return nums;
        }
        var rp = Parts(remote); var lp = Parts(local);
        var len = Math.Max(rp.Length, lp.Length);
        for (var i = 0; i < len; i++)
        {
            var r = i < rp.Length ? rp[i] : 0;
            var l = i < lp.Length ? lp[i] : 0;
            if (r != l) return r > l;
        }
        return false;   // numerically equal -> not an update
    }
}
