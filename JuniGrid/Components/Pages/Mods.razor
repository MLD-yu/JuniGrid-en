@code {
    private IReadOnlyList<ModEntry> _mods = Array.Empty<ModEntry>();
    // v1.1.6: folder -> entry index. The batch bar and selection cleanup used to run FirstOrDefault/Any full-table
    // scans (selection count x mod count) — tens of thousands of string comparisons per render with hundreds of mods.
    private Dictionary<string, ModEntry> _modsByFolder = new(StringComparer.OrdinalIgnoreCase);
    // v0.59.0: shimmer loading state on first page entry
    private bool _initialLoading = true;
    // v0.60.0: shimmer loading state while checking for updates
    private bool _checkingUpdates = false;
    
    private string? _smapiVersion;
    private string? _smapiIcon;
    private SmapiUpdateInfo? _smapiUpdate;
    private bool _smapiUpdating;
    private long _checkingTick;
    private ModEntry? _pendingDeleteMod;   // single mod awaiting delete confirmation (actually uninstalled after the dialog is confirmed)
    private bool _pendingBatchDelete;      // batch deletion awaiting confirmation (actually uninstalled after the dialog is confirmed)
    // v1.09: "move to mod recycle bin" checkbox in the delete dialog — unchecked by default (keeps the old permanent
    // delete); checked mods go to the persistent Mods/.junigrid_trash bin, restorable from Settings -> Storage
    private bool _deleteToTrash;
    private bool _coversDirty;

    // ---- remark/rename dialog ----
    private string? _remarkFolder;      // null = dialog closed; otherwise the Folder of the mod whose remark is being edited
    private string _remarkOriginal = "";
    private string _remarkInput = "";

    // ---- filter / grouping / missing dependencies ----
    private string _filter = "all";
    private string SearchText { get; set; } = "";

    // v0.32.0: sort (alpha = alphabetical / time-desc = newest first / time-asc = oldest first) + dropdown/search open state
    private string _sortMode = "time-asc";
    private bool _sortOpen;
    private bool _searchOpen;

    // ── v0.46.0: profile system, modeled after Stardrop ──
    private bool _profileOpen;
    private string? _renamingProfile;
    private string _renameBuffer = "";

    /// <summary>v0.71.1: double-click starts renaming.</summary>
    private void StartRenameProfile(string name)
    {
        _renamingProfile = name;
        _renameBuffer = name;
        // v1.08: collapse the profile dropdown while renaming — the input+confirm header is now standalone;
        // leaving the dropdown open only blocks the view and lets other profiles be clicked, making state confusing.
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }

    private void OnRenameKey(KeyboardEventArgs e, string oldName)
    {
        if (e.Key == "Enter") _ = ConfirmRename(oldName);
        else if (e.Key == "Escape") { _renamingProfile = null; _renameBuffer = ""; }
    }

    private async Task ConfirmRename(string oldName)
    {
        var newName = _renameBuffer.Trim();
        _renamingProfile = null;
        _renameBuffer = "";
        if (string.IsNullOrEmpty(newName) || newName == oldName) return;
        if (AllProfiles.Any(p => p.Name == newName))
        {
            ShowNotice("err", "A profile with this name already exists: " + newName);
            return;
        }
        try
        {
            var p = Cfg.Current.ModProfiles.FirstOrDefault(x => x.Name == oldName);
            if (p is not null) p.Name = newName;
            if (Cfg.Current.ActiveProfile == oldName) Cfg.Current.ActiveProfile = newName;
            Cfg.Save(Cfg.Current);
            ShowNotice("ok", $"Renamed to \"{newName}\"");
        }
        catch (Exception ex) { ShowNotice("err", "Rename failed: " + ex.Message); }
    }

    /// <summary>v0.71.1: keep the dropdown open after switching profiles (handy for comparing and switching repeatedly).</summary>
    private async Task ApplyProfileKeepOpen(string name)
    {
        await ApplyProfile(name);
        // don't close _profileOpen — the user may want to switch through several profiles
    }

    private bool _addingProfile;
    private string _newProfileName = "";
    private string? _deletingProfile;

    private List<ModProfile> AllProfiles
    {
        get
        {
            var list = Cfg.Current.ModProfiles;
            // v1.08: dedupe by name (case-insensitive) — a historical bug could write duplicate profiles (two "Default"
            // profiles, empty "Default" shells). Keep the first; if it's an empty shell and the later one has enabled mods, use the latter.
            var deduped = new List<ModProfile>();
            foreach (var p in list)
            {
                var same = deduped.FirstOrDefault(x => x.Name.Equals(p.Name, StringComparison.OrdinalIgnoreCase));
                if (same is null) { deduped.Add(p); continue; }
                if ((same.EnabledModUids?.Count ?? 0) == 0 && (p.EnabledModUids?.Count ?? 0) > 0)
                    deduped[deduped.IndexOf(same)] = p;
            }
            if (deduped.Count == 0 || deduped[0].Name != "Default")
                deduped.Insert(0, new ModProfile { Name = "Default" });
            if (deduped.Count != list.Count)
                Cfg.Current.ModProfiles = deduped;   // sync the deduped list back to config; fixed on next save
            return deduped;
        }
    }

    private string ActiveProfileName =>
        string.IsNullOrWhiteSpace(Cfg.Current.ActiveProfile) ? "Default" : Cfg.Current.ActiveProfile;

    /// <summary>Writes the current enabled set back to ActiveProfile (the "Default" profile is a runtime view and is not persisted).</summary>
    private void PersistCurrentToActive()
    {
        var active = ActiveProfileName;
        // v0.71.4: snapshot the "Default" profile too — the old code returned early, so the "Default" enabled list
        // stayed stale forever and switching away and back "restored" an outdated list (another root cause of the
        // profile cross-contamination users saw).
        var p = Cfg.Current.ModProfiles.FirstOrDefault(x => x.Name.Equals(active, StringComparison.OrdinalIgnoreCase));
        if (p is null) return;
        // v0.50.0: rescan before writing back so _mods reflects the real disk state (otherwise dependency linking just
        // changed things while _mods is stale and the write-back persists stale data -> cross-contamination)
        // v0.51.0: Stardrop-style clean snapshot — store every mod currently actually enabled, without excluding linked
        // items (excluding them caused inconsistent state, the root cause of profile cross-contamination)
        p.EnabledModUids = _mods
            .Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
            .Select(m => m.UniqueID)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }



    private async Task ToggleProfile()
    {
        if (_deletingProfile is not null) return;   // v1.08: don't open while a delete confirmation is up
        _profileOpen = !_profileOpen;
        // v1.08: the two dropdowns are mutually exclusive — opening profiles closes sort
        if (_profileOpen && _sortOpen)
        {
            _sortOpen = false;
            try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-sort-dd", false); } catch { }
        }
        _renamingProfile = null; _renameBuffer = "";   // v0.71.4: leave rename mode when toggling the dropdown
        if (!_profileOpen) { _addingProfile = false; _newProfileName = ""; }
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", _profileOpen); } catch { }
    }

    private async Task CloseProfile()
    {
        if (!_profileOpen) return;
        _profileOpen = false;
        _addingProfile = false; _newProfileName = "";
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
    }

    private void StartAddProfile() { _addingProfile = true; _newProfileName = ""; }

    private async Task ConfirmAddProfile()
    {
        var name = _newProfileName.Trim();
        _addingProfile = false;
        _newProfileName = "";
        if (string.IsNullOrWhiteSpace(name)) return;
        if (AllProfiles.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            ShowNotice("err", "A profile with this name already exists: " + name);
            return;
        }
        // v0.49.0: write the current enabled state back to the old profile first to prevent cross-contamination when switching
        PersistCurrentToActive();
        // the new profile snapshots the current enabled state (Stardrop-style: creating = recording the mods enabled right now)
        var p = new ModProfile
        {
            Name = name,
            EnabledModUids = _mods.Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
                                  .Select(m => m.UniqueID).ToList()
        };
        Cfg.Current.ModProfiles.Add(p);
        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        _profileOpen = false;
        // v0.49.0: explicitly reset the JS dropdown animation state; fixes the dropdown breaking after creation
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
        ShowNotice("ok", $"Profile \"{name}\" created");
    }

    private void AskDeleteProfile(string name)
    {
        _deletingProfile = name;
        CloseDropdownsForDialog();
    }

    /// <summary>v1.1.1: collapse every dropdown before any modal dialog (delete/remark) opens —
    /// the modal overlay (99998) covers the dropdown (9500), but an overlay click only closes the dialog,
    /// leaving the dropdown hanging beneath it.</summary>
    private void CloseDropdownsForDialog()
    {
        if (_sortOpen)
        {
            _sortOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-sort-dd", false);
        }
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }

    private void AskDeleteMod(ModEntry m)
    {
        CloseDropdownsForDialog();
        _pendingDeleteMod = m;
    }

    private void AskBatchDelete()
    {
        CloseDropdownsForDialog();
        _pendingBatchDelete = true;
    }
    private void CancelDeleteProfile() => _deletingProfile = null;

    private async Task ConfirmDeleteProfile()
    {
        var name = _deletingProfile;
        _deletingProfile = null;
        if (name is null) return;
        var wasActive = ActiveProfileName == name;
        Cfg.Current.ModProfiles.RemoveAll(p => p.Name == name);
        if (wasActive)
        {
            // v0.71.4: do not set ActiveProfile before calling ApplyProfile — in that order ApplyProfile hits
            // name == ActiveProfileName and returns immediately, so disk mod state never switches back to Default
            // (the root cause of "Default" showing the deleted profile's state after deletion). The old profile has
            // already been removed from the list here, so PersistCurrentToActive inside ApplyProfile cannot find it
            // and won't mis-write; ApplyProfile sets ActiveProfile itself after switching.
            await ApplyProfile("Default");
        }
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"Profile \"{name}\" deleted");
    }

    /// <summary>Switch profile: batch enable/disable by the UniqueID set recorded in the profile (with dependency linking); everything else is disabled.</summary>
    private async Task ApplyProfile(string name)
    {
        if (name == ActiveProfileName) return;
        // v0.50.0: Rescan before writing back to get real disk state; prevents persisting stale data -> cross-contamination
        Rescan();
        PersistCurrentToActive();
        var profile = AllProfiles.FirstOrDefault(p => p.Name == name);
        if (profile is null) return;

        var wantEnabled = new HashSet<string>(profile.EnabledModUids, StringComparer.OrdinalIgnoreCase);
        // dependency linking: dependencies of mods being enabled are enabled too (recursive closure)
        ExpandWithDependencies(wantEnabled);

        // v0.72.8: collect operations deduplicated by "top-level physical directory" — multi-part mods (like the
        // [CS]/[DLL]/[FTM] under Weather Wonders - Beta) have several sub-entries sharing one top-level directory; the
        // old code Moved once per sub-entry, so after the first rename succeeded the rest inevitably "couldn't find the
        // mod folder". Now each top-level directory is Moved only once.
        var topOps = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);  // topLevel -> disable
        foreach (var m in _mods)
        {
            var uid = m.UniqueID;
            var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
            if (m.Disabled == !shouldEnable)
                continue;
            var top = m.Folder.Split('/')[0];
            topOps.TryAdd(top, !shouldEnable);
        }

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        try
        {
            var gamePath = Cfg.Current.GamePath;
            // v0.72.8: structured error results instead of re-parsing with string Split(':') (folder names containing ':' would truncate)
            var errs = await Task.Run(() =>
            {
                var list = new List<(string Folder, string Error)>();
                foreach (var (top, disable) in topOps)
                {
                    var err = ModSvc.SetDisabled(gamePath, top, disable);
                    if (err is not null) list.Add((top, err));
                }
                return list;
            });
            foreach (var (folder, err) in errs)
                AppLog.Warn("Mods", $"Profile switch failed: {folder} - {err}");

            // incrementally update in-memory state: update Disabled + Folder and migrate caches per sub-entry
            var errTops = new HashSet<string>(errs.Select(e => e.Folder), StringComparer.OrdinalIgnoreCase);
            foreach (var m in _mods)
            {
                var uid = m.UniqueID;
                var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
                if (m.Disabled == !shouldEnable) continue;
                var top = m.Folder.Split('/')[0];
                if (errTops.Contains(top)) continue;   // renaming this top-level directory failed; skip all of its sub-entries
                var disable = !shouldEnable;
                var newFolder = disable
                    ? (m.Folder.StartsWith('.') ? m.Folder : "." + m.Folder)
                    : m.Folder.TrimStart('.');
                if (newFolder != m.Folder)
                {
                    MigrateFolderCaches(m.Folder, disable);
                    m.Folder = newFolder;
                }
                m.Disabled = disable;
            }
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"Switched to profile \"{name}\"");
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Expands the to-enable set with the dependency closure: enabling A requires enabling B when A depends on B (recursive).</summary>
    private void ExpandWithDependencies(HashSet<string> uids)
    {
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var queue = new Queue<string>(uids);
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!byUid.TryGetValue(cur, out var mod)) continue;
            foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
            {
                if (!string.IsNullOrWhiteSpace(dep) && uids.Add(dep))
                    queue.Enqueue(dep);   // newly added dependencies may have dependencies of their own
            }
        }
    }

    /// <summary>When disabling a mod, also disable enabled mods that depend on it (recursive) — the same linking as Stardrop.</summary>
    private void DisableDependents(string uniqueId, HashSet<string> visited, Action<ModEntry> disableOne)
    {
        if (string.IsNullOrWhiteSpace(uniqueId) || !visited.Add(uniqueId)) return;
        foreach (var m in _mods)
        {
            if (m.Disabled || string.IsNullOrWhiteSpace(m.UniqueID)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                   .Any(d => d.Equals(uniqueId, StringComparison.OrdinalIgnoreCase)))
            {
                disableOne(m);
                DisableDependents(m.UniqueID, visited, disableOne);
            }
        }
    }

    /// <summary>When enabling a mod, also enable its disabled dependencies (recursive).</summary>
    private void EnableDependencies(ModEntry mod, HashSet<string> visited, Action<ModEntry> enableOne)
    {
        if (string.IsNullOrWhiteSpace(mod.UniqueID) || !visited.Add(mod.UniqueID)) return;
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
        {
            if (string.IsNullOrWhiteSpace(dep) || !byUid.TryGetValue(dep, out var depMod)) continue;
            if (depMod.Disabled)
            {
                enableOne(depMod);
                EnableDependencies(depMod, visited, enableOne);
            }
        }
    }

    /// <summary>Website category (official Nexus category name, cached in config). Falls back to the manifest category when not cached.</summary>
    private string? GetNexusCategory(ModEntry m)
    {
        // official category name already cached
        if (Cfg.Current.ModCategories.TryGetValue(m.Folder, out var name)) return name;
        var norm = m.Folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        if (key != m.Folder && Cfg.Current.ModCategories.TryGetValue(key, out name)) return name;
        // has category_id but no cached name table -> wait for EnsureCategoriesAsync to fetch it
        var st = GetState(m.Folder);
        if (st.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out name))
            return name;
        // fallback: coarse manifest category
        return string.IsNullOrEmpty(m.Category) ? null : m.Category;
    }

    /// <summary>When the category table is empty and signed in, fetch the official category table once and cache it.</summary>
    private async Task EnsureCategoriesAsync()
    {
        if (Cfg.Current.NexusCategories.Count > 0 || !NexusService.IsAuthenticated) return;
        try
        {
            var cats = await Nexus.GetCategoriesAsync();
            if (cats is { Count: > 0 })
            {
                Cfg.Current.NexusCategories = cats;
                Cfg.Save(Cfg.Current);
            }
        }
        catch (Exception ex) { AppLog.Warn("Mods", "Failed to fetch category table: " + ex.Message); }
    }

