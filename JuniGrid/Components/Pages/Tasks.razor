@namespace JuniGrid.Components.Pages
@page "/tasks"
@inject TaskCenterService Center
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="jg-page jg-tasks-page">
    <div class="jg-tasks-inner" style="display:flex;gap:16px;">
        <aside style="flex:0 0 200px;">
            @* ─── Back arrow, black on transparent (floating white-on-black pill tooltip follows the mouse) ─── *@
            <button class="jg-tasks-back" @onclick="GoBack" data-tip="Back" aria-label="Back">
                <svg width="20" height="20" viewBox="0 0 1024 1024" fill="none">
                    <path d="M532.526499 904.817574L139.506311 511.797385 532.526499 118.777197c12.258185-12.258185 12.432147-32.892131-0.187265-45.51052-12.707416-12.707416-32.995485-12.703323-45.511543-0.187265L75.166957 484.739123c-7.120165 7.120165-10.163477 17.065677-8.990768 26.624381-1.500167 9.755178 1.5104 20.010753 8.990768 27.491121l411.660734 411.660734c12.258185 12.258185 32.892131 12.432147 45.511543-0.187265 12.707416-12.707416 12.7023-32.995485 0.187265-45.51052z" fill="currentColor"/>
                </svg>
            </button>
            <div style="margin-top:24px;font-size:13px;opacity:.7;">Total progress</div>
            <div style="font-size:26px;font-weight:600;color:var(--jg-text)">@Center.TotalPercent.ToString("F2") %</div>
            <div style="margin-top:16px;font-size:13px;opacity:.7;">Download speed</div>
            <div style="font-size:22px;font-weight:600;color:var(--jg-text)">@Center.TotalSpeedMBps.ToString("F2") M/s</div>
            <div style="margin-top:16px;font-size:13px;opacity:.7;">Remaining tasks</div>
            <div style="font-size:22px;font-weight:600;color:var(--jg-text)">@Center.RunningCount</div>
            <div style="margin-top:24px;">
                <button class="jg-tasks-clear" @onclick="AskClear" data-tip="Clear all tasks matching the current filter"
                        disabled="@(_visible.Count == 0)">Clear all</button>
            </div>
        </aside>
        <section style="flex:1;min-width:0;">
            <h1 style="margin-top:0;">Task Manager</h1>
            @* ─── Filter nav: the first pill = task kind (clicking the pill itself jumps back to "All" in one click,
                   only the small arrow opens the dropdown) + status pills Running/Succeeded/Failed ─── *@
            <div class="jg-tfilters">
                <div class="jg-sort-dd jg-tf-kind @(_filter == "all" ? "active" : "")" id="jgKindFilter">
                    <span class="jg-tf-label" @onclick="KindPillClick" title="Click to show all tasks of this kind">@KindLabel(_kind)</span>
                    <span class="jg-tf-caret" @onclick="ToggleKindMenu" title="Select task kind">
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <div class="jg-sort-menu">
                        @foreach (var k in Kinds)
                        {
                            <button type="button" class="jg-sort-item @(_kind == k.Key ? "active" : "")"
                                    @onclick="() => SelectKind(k.Key)">@k.Label</button>
                        }
                    </div>
                </div>
                @foreach (var f in Filters)
                {
                    var key = f.Key;
                    <button class="jg-tfilter @(_filter == key ? "active" : "")" @onclick="() => SetFilter(key)">@f.Label</button>
                }
            </div>
            @if (_visible.Count == 0)
            {
                <div class="jg-note">No tasks match the current filter.</div>
            }
            else
            {
                @foreach (var (t, log) in _visible)
                {
                    var dropId = "jgDrop-" + t.Id.ToString("N");
                    var arrowId = "jgArr-" + t.Id.ToString("N");
                    <div class="jg-card" @key="t.Id" style="margin-bottom:10px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div style="font-weight:600;word-break:break-word;overflow-wrap:anywhere;flex:1;min-width:0;">@t.Title</div>
                            <button class="jg-rowbtn" @onclick="() => Remove(t)" title="Remove">×</button>
                        </div>
                        <div style="margin-top:6px;font-size:12px;display:flex;align-items:center;gap:6px;">
                            <span style="opacity:.7;">@(t.Status == "running" ? "Running" : t.Status == "done" ? "Completed" : "Failed") · @t.Percent.ToString("F0")% @(t.SpeedMBps > 0 ? $" · {t.SpeedMBps:F2} M/s" : "")</span>
                            @if (log.Count > 0)
                            {
                                @* ─── Dropdown button after the numeric progress: expands this task's download details ─── *@
                                <button class="jg-taskdrop-trigger" @onclick="() => ToggleDrop(t)" aria-label="Expand download details">
                                    <svg id="@arrowId" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            }
                        </div>
                        <div style="height:6px;background:var(--jg-track);border-radius:3px;margin-top:6px;">
                            <div style="height:100%;border-radius:3px;background:@(t.Status=="failed"?"#e11d48":"var(--jg-ink)");width:@(t.Percent)%"></div>
                        </div>

                        @* ─── Download details dropdown panel (GSAP easeReverse elastic expansion; progress-noise lines never enter) ───
                           v1.07: the expanded state is driven by class (_openDrops) — frequent re-renders during a download no longer lose it;
                           gsap only plays the animation, inline styles are cleared when it ends, the steady state belongs to CSS
                           v1.08.1: the panel's render condition now matches the trigger button (Log.Count > 0) — the old version
                           rendered the panel only when UsefulLines had content, so when the log was all progress noise clicking
                           the button silently returned in JS because #jgDrop-* did not exist, looking like "clicking does nothing";
                           now the button implies the panel is there, and a placeholder row shows when there is no useful log *@
                        @if (log.Count > 0)
                        {
                            <div class="jg-taskdrop-menu @(_openDrops.Contains(t.Id) ? "open" : "")" id="@dropId">
                                <div class="jg-tl">
                                @{
                                    var lines = UsefulLines(log).ToList();
                                    int[] ringOrder = { 0, 1, 2, 5, 8, 7, 6, 3 };   // 3x3 ring, clockwise (0 starts at top-left)
                                }
                                @if (lines.Count == 0)
                                {
                                    <div class="jg-tl-empty">No detailed log yet (processing in the background, please wait...)</div>
                                }
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    var line = lines[i];
                                    var isLast = i == lines.Count - 1;
                                    // last line of a running task = in progress (pixel square); last line of a finished task = solid check; last line of a failed task = red cross
                                    // v1.2.2: success rows' text/icon adapt to the theme (white on dark / black on light); failures stay red
                                    var status = t.Status == "running" && isLast ? "running"
                                               : t.Status == "failed" && isLast ? "error"
                                               : t.Status == "done" && isLast ? "final"
                                               : "done";
                                    var phase = PhaseOf(line);   // backup=blue / connect=red / others=black
                                    var iconColor = status == "done" || status == "final" ? "var(--tl-black)"
                                                  : status == "error" ? "var(--tl-red)"
                                                  : phase == "backup" ? "var(--tl-blue)"
                                                  : phase == "connect" ? "var(--tl-red)"
                                                  : "var(--tl-black)";
                                    <div class="jg-tl-row" data-status="@status" style="--c:@iconColor">
                                        <div class="jg-tl-icon">
                                            @if (status == "running")
                                            {
                                                <div class="jg-pxgrid">
                                                    @for (var c = 0; c < 9; c++)
                                                    {
                                                        if (c == 4)
                                                        {
                                                            <i class="center"></i>
                                                        }
                                                        else
                                                        {
                                                            <i style="--i:@(Array.IndexOf(ringOrder, c))"></i>
                                                        }
                                                    }
                                                </div>
                                            }
                                            else if (status == "error")
                                            {
                                                <svg class="jg-tl-mark" viewBox="0 0 26 26"><circle cx="13" cy="13" r="12"/><path d="M8.5 8.5l9 9M17.5 8.5l-9 9"/></svg>
                                            }
                                            else if (status == "final")
                                            {
                                                @* Last row Success: solid green with white check (unchanged) *@
                                                <svg class="jg-tl-check jg-tl-mark" viewBox="0 0 26 26"><circle cx="13" cy="13" r="12"/><path d="M7 13.5l4 4 8-9"/></svg>
                                            }
                                            else
                                            {
                                                @* Arc check with an opening: the gap sits toward the top right at 1:30, the check's tail reaches into the gap (same as the video style) *@
                                                <svg class="jg-tl-check jg-tl-mark" viewBox="0 0 26 26"><path d="M21.49 4.51A12 12 0 1 1 13 1"/><path d="M7 13.5l4 4 8.5-9.5"/></svg>
                                            }
                                        </div>
                                        <span class="jg-tl-text">@line</span>
                                    </div>
                                    @if (i < lines.Count - 1 || t.Status == "running")
                                    {
                                        @* ── v1.1.3: dashed connector between steps (the running task's last line also gets one, meaning more to come) ── *@
                                        <div class="jg-tl-connector"><i></i></div>
                                    }
                                }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </div>

    @* ─── Clear confirmation dialog ─── *@
    @if (_confirmClear)
    {
        <div class="jg-tasks-confirm-mask" @onclick="() => _confirmClear = false">
            <div class="jg-tasks-confirm" @onclick:stopPropagation>
                <div style="font-weight:600;margin-bottom:6px;">Clear tasks</div>
                <div style="font-size:13px;opacity:.8;">Clear all tasks matching the current filter?</div>
                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
                    <button class="jg-tasks-cancel" @onclick="() => _confirmClear = false">Cancel</button>
                    <button class="jg-tasks-clear" style="margin:0;" @onclick="DoClear">Clear</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // v1.1.6: rendering now uses a thread-safe snapshot — it used to enumerate Center.Items directly (background
    // download threads Insert/Remove at any time), and hitting "collection was modified" mid-render crashed the
    // whole page; the t.Log enumeration likewise switched to a copy.
    private List<(TaskItem Item, List<string> Log)> _visible = new();

    protected override void OnInitialized()
    {
        RebuildVisible();
        Center.OnChanged += Refresh;
    }
    public void Dispose() => Center.OnChanged -= Refresh;
    private void Refresh() => InvokeAsync(() => { RebuildVisible(); StateHasChanged(); });

    private void RebuildVisible()
    {
        IEnumerable<TaskItem> q = Center.Snapshot();
        // Kind dimension: mod download = download/install/update; cache cleanup = cleanup
        if (_kind == "mod") q = q.Where(t => t.Kind != "cleanup");
        else if (_kind == "cleanup") q = q.Where(t => t.Kind == "cleanup");
        // Status dimension
        q = _filter switch
        {
            "running" => q.Where(t => t.Status == "running"),
            "done"    => q.Where(t => t.Status == "done"),
            "failed"  => q.Where(t => t.Status == "failed"),
            _         => q
        };
        _visible = q.Select(t => (t, Center.CopyLog(t))).ToList();
    }

    // ─── Filter nav: status pills x task kind dropdown ───
    // Clicking the kind pill itself = one click back to "All"; only the small arrow opens the dropdown — so one click always returns to all
    private static readonly (string Key, string Label)[] Filters =
    {
        ("running", "Running"), ("done", "Succeeded"), ("failed", "Failed")
    };
    private static readonly (string Key, string Label)[] Kinds =
    {
        ("all", "All"), ("mod", "Mod download"), ("cleanup", "Cache cleanup")
    };
    private string _filter = "all";   // status dimension: all / running / done / failed
    private string _kind = "all";     // kind dimension: all / mod / cleanup

    private string KindLabel(string key) =>
        Kinds.FirstOrDefault(k => k.Key == key).Label ?? "All";

    private void SetFilter(string key)
    {
        _filter = key;
        RebuildVisible();
        StateHasChanged();
    }

    /// <summary>Clicking the kind pill itself: only resets the status filter to "All", keeping the kind shown on the pill —
    /// if it shows "Mod download" you return to the Mod download view; to clear the kind selection use "All" in the dropdown menu.</summary>
    private void KindPillClick()
    {
        _filter = "all";
        RebuildVisible();
        StateHasChanged();
    }

    private async Task ToggleKindMenu()
    {
        try { await JS.InvokeVoidAsync("junigridJs.logsFilterToggle", "#jgKindFilter"); } catch { }
    }

    private async Task SelectKind(string key)
    {
        _kind = key;
        RebuildVisible();
        StateHasChanged();
        try { await JS.InvokeVoidAsync("junigridJs.logsFilterClose", "#jgKindFilter"); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Close on outside click + arrow animation binding (reuses the same component as the logs page)
            try { await JS.InvokeVoidAsync("junigridJs.logsFilterInit", "#jgKindFilter"); } catch { }
        }
        // v1.1.3: attach observers to expanded task timelines — detect the "pixel square → check" switch and play the morph animation
        foreach (var id in _openDrops)
        {
            try { await JS.InvokeVoidAsync("junigridJs.taskTimelineWatch", "#jgDrop-" + id.ToString("N")); } catch { }
        }
    }

    // ─── Log cleaning: progress noise is not shown ───
    // Noise = intermediate progress report lines (with %, KB/MB per second, downloaded / downloading X KB|MB / Y KB|MB, etc.) —
    // the progress bar and step list already show this live; these lines once flooded the log past two hundred lines.
    private static readonly System.Text.RegularExpressions.Regex TsPrefix =
        new(@"^\[\d{2}:\d{2}:\d{2}\]\s*", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex ProgressNoise =
        new(@"(\d+\s*%|\d+(\.\d+)?\s*(KB|MB)/s|[Dd]ownloaded\s*[\d.]+\s*(KB|MB)|[\d.]+\s*(KB|MB)\s*/\s*[\d.]+\s*(KB|MB))",
            System.Text.RegularExpressions.RegexOptions.Compiled);

    private static IEnumerable<string> UsefulLines(List<string> log)
    {
        // v1.1.2: download heartbeat lines ("Downloading… x MB / y MB") used to be hidden entirely by ProgressNoise,
        // leaving the download phase invisible in the step list — the percent climbed alone while the label stayed
        // stuck on "Getting download URL…", then jumped straight to "Install complete" at 100%. Consecutive heartbeats
        // are now folded into a single numberless "Downloading…" line shown as a visible step.
        // v1.1.6: the parameter is now a log copy (CopyLog); TaskItem.Log is no longer enumerated directly.
        var lastWasDl = false;
        foreach (var raw in log)
        {
            var line = TsPrefix.Replace(raw, "").Trim();
            if (line.Length == 0) continue;
            if (line.StartsWith("Downloading"))
            {
                if (lastWasDl) continue;   // consecutive heartbeats keep only one line
                yield return "Downloading…";
                lastWasDl = true;
                continue;
            }
            lastWasDl = false;
            if (ProgressNoise.IsMatch(line)) continue;
            yield return line;
        }
    }

    // ─── v1.1.3: log line → phase (keyword auto-match) ───
    // backup/restore → blue; connect/server → red; download/install/extract/others → black.
    // The completion check is always green and failures always red, decided at the marker rendering site — unrelated to the phase color here.
    private static string PhaseOf(string line)
    {
        // Keyword keys must match the English log lines the services emit
        // ("Back"/"back" = Backing up/backed up/back up; "estor" = Restoring/restored;
        //  "onnect" = Connecting/Connection; "erver" = server/Server)
        if (line.Contains("Back") || line.Contains("back") || line.Contains("estor")) return "backup";
        if (line.Contains("onnect") || line.Contains("erver")) return "connect";
        return "work";
    }

    // ─── Download details dropdown: one expanded state per task; the GSAP animation lives in JS ───
    private readonly HashSet<Guid> _openDrops = new();
    private async Task ToggleDrop(TaskItem t)
    {
        var open = !_openDrops.Contains(t.Id);
        if (open) _openDrops.Add(t.Id); else _openDrops.Remove(t.Id);
        try { await JS.InvokeVoidAsync("junigridJs.taskDrop", "#jgDrop-" + t.Id.ToString("N"), "#jgArr-" + t.Id.ToString("N"), open); } catch { }
        // v1.07: the class is synced on render (CSS .open guarantees the steady state, so re-renders do not lose it)
        StateHasChanged();
    }

    private void Remove(TaskItem t)
    {
        Center.Remove(t);
        _openDrops.Remove(t.Id);
    }

    // ─── Clear all (current filter): confirmation dialog → clear by the filter condition ───
    private bool _confirmClear;
    private void AskClear() => _confirmClear = true;
    private void DoClear()
    {
        _confirmClear = false;
        Center.ClearMatching(t => _filter switch
        {
            "running" => t.Status == "running",
            "done"    => t.Status == "done",
            "failed"  => t.Status == "failed",
            _         => true
        });
    }

    private void Clear() => Center.ClearFinished();
    // v1.06.6: back = history.back to the page you came from
    private void GoBack() => _ = JS.InvokeVoidAsync("junigridJs.goBack");
    private void OpenSmapiInstallerFolder()
    {
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(StoragePaths.SmapiInstallerDir) { UseShellExecute = true }); } catch { }
    }
    private void OpenSmapiSite() =>
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("https://smapi.io") { UseShellExecute = true });
}
