@namespace JuniGrid.Components.Pages
@page "/"
@inject ConfigService Cfg
@inject GameService Game
@inject ModService Mods
@inject LauncherService Launcher
@inject UpdateService Updater
@inject PlayTimeService PlayTime
@inject IJSRuntime JS
@implements IDisposable

<div class="jg-page">
    <div class="jg-grid-4">
        <div class="jg-card">
            <div class="jg-stat-label">Installed Mods</div>
            <div class="jg-stat-num">@_totalModCount</div>
            <div class="jg-stat-sub">@_activeModCount enabled · @(_totalModCount - _activeModCount) disabled</div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">SMAPI</div>
            <div class="jg-stat-num">@(_smapiVersion is null ? "Not installed" : _smapiVersion)</div>
            <div class="jg-stat-sub">
                @(_smapiVersion is null ? "Official Steam launch only" : "Mod loader ready")
            </div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">Game version</div>
            <div class="jg-stat-num">@(_gameVersion ?? "Not detected")</div>
            <div class="jg-stat-sub">Stardew Valley</div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">Last played</div>
            <div class="jg-stat-num" style="font-size:18px;line-height:1.3;">
                @(_cfg.LastLaunchTime is null ? "Never launched" : FormatTime(_cfg.LastLaunchTime))
            </div>
            @* v1.1.2: total time now uses the heatmap's accounting (sum of PlayTimeService seconds across all years) *@
            <div class="jg-stat-sub">
                @_cfg.TotalLaunchCount launches · @FormatHours(PlayTime.TotalSeconds) total
            </div>
        </div>
    </div>

    @* ── v1.1.5: playtime heatmap (GitHub contributions style) ──
       Data comes only from PlayTimeService's system tracking (auto-accumulated every 30s while the game process runs); no manual editing entry *@
    <div class="jg-card jg-heat-card">
        <div class="jg-heat-head">
            <div class="jg-heat-title">@FormatHours(_yearTotalSeconds) played in @_heatYear (@_yearDays days)</div>
            @* v1.1.6: year picker switched to the generic dropdown (reuses dropdownToggle's GSAP spring animation + outside-click dismiss);
               jg-dd-right right-aligns the menu (flush against the title row's right edge without overflowing the card) *@
            <div class="jg-sort-dd jg-dd-right jg-heat-yeardd @(_heatDdOpen ? "open" : "")" data-dd="heatyear">
                <button class="jg-sort-trigger" @onclick="ToggleYearDd">
                    @_heatYear
                    <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div class="jg-sort-menu">
                    @foreach (var y in _years)
                    {
                        var year = y;
                        <button class="jg-sort-item @(_heatYear == year ? "active" : "")" @onclick="() => PickYear(year)">@year</button>
                    }
                </div>
            </div>
            <div class="jg-dd-overlay" data-dd="heatyear" @(_heatDdOpen ? "open" : "") @onclick="CloseYearDd"></div>
        </div>
        <div class="jg-heat-scroll">
            <table class="jg-heat-grid">
                <tr>
                    <th class="jg-heat-wday"></th>
                    @foreach (var m in _monthLabels)
                    {
                        @* Month labels are absolutely positioned floating above the columns and take no table column width (taking width would periodically widen the month column,
                           pushing out horizontal scroll on small screens and leaving large gaps at Oct/Nov/Dec on large ones) *@
                        <th class="jg-heat-month"><span>@m</span></th>
                    }
                </tr>
                @for (var r = 0; r < 7; r++)
                {
                    var row = r;
                    <tr>
                        <th class="jg-heat-wday">@WdayLabel(row)</th>
                        @for (var c = 0; c < _weeks.Count; c++)
                        {
                            var cell = _weeks[c][row];
                            <td>
                            @if (cell.InYear && !cell.Future)
                            {
                                <span class="jg-heat-cell l@(cell.Level)" data-tip="@Tip(cell)"></span>
                            }
                            else if (cell.InYear && cell.Future)
                            {
                                <span class="jg-heat-cell future"></span>
                            }
                            @* Out-of-year overflow cells (previous year in the first column / next year in the last) render no element — same whitespace as GitHub *@
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>
        @* v1.1.6: bottom-left caption removed (color meanings are carried by the legend data-tips) *@
        <div class="jg-heat-foot">
            @* v1.1.6: legend swatches scale up on hover + data-tip pill shows the time range for that color
               (data-tip works automatically via global delegation; text maps one-to-one with HeatCell.Level thresholds) *@
            <div class="jg-heat-legend">
                Less
                <span class="jg-heat-cell l0" data-tip="No playtime"></span>
                <span class="jg-heat-cell l1" data-tip="Less than 1 hour"></span>
                <span class="jg-heat-cell l2" data-tip="1–2 hours"></span>
                <span class="jg-heat-cell l3" data-tip="2–4 hours"></span>
                <span class="jg-heat-cell l4" data-tip="Over 4 hours"></span>
                More
            </div>
        </div>
    </div>
</div>

@code {
    private JuniGridConfig _cfg = new();
    private string? _smapiVersion;
    private string? _gameVersion;
    private int _totalModCount;
    private int _activeModCount;

    // ─── v1.1.5: heatmap ───
    private sealed record HeatCell(string Key, bool InYear, bool Future, long Seconds)
    {
        public int Level => Seconds <= 0 ? 0
            : Seconds < 3600 ? 1        // <1 hour
            : Seconds < 7200 ? 2        // 1–2 hours
            : Seconds < 14400 ? 3       // 2–4 hours
            : 4;                        // ≥4 hours
    }

    private int _heatYear = DateTime.Now.Year;
    private List<int> _years = new();
    private List<List<HeatCell>> _weeks = new();   // one week per column (Sunday→Saturday), 7 rows
    private List<string> _monthLabels = new();     // month headers aligned with the week columns
    private long _yearTotalSeconds;
    private int _yearDays;

    protected override void OnInitialized()
    {
        _cfg = Cfg.Current;

        if (string.IsNullOrWhiteSpace(_cfg.GamePath))
        {
            var detected = Game.DetectGamePath();
            if (!string.IsNullOrEmpty(detected))
            {
                _cfg.GamePath = detected;
                Cfg.Save(_cfg);
            }
        }

        _smapiVersion = Game.ProbeSmapiVersion(_cfg.GamePath);
        _gameVersion = Updater.GetGameVersion(_cfg.GamePath);

        // v1.1.6: moved the full scan off the UI thread — the home page only needs two counts, and the old synchronous Scan
        // of hundreds of mod manifests made page switches visibly janky; refresh one frame once the counts are in.
        _ = Task.Run(() =>
        {
            var mods = Mods.Scan(_cfg.GamePath);
            _totalModCount = mods.Count;
            _activeModCount = mods.Count(m => !m.Disabled);
            return InvokeAsync(StateHasChanged);
        });

        // v1.1.5: playtime data can be accumulated in the background every 30s; subscribe to changes to refresh the heatmap in real time
        PlayTime.OnChanged += OnPlayChanged;
        RebuildHeat();
    }

    private void OnPlayChanged() => InvokeAsync(RebuildHeat);

    public void Dispose() => PlayTime.OnChanged -= OnPlayChanged;

    private void RebuildHeat()
    {
        var data = PlayTime.Snapshot;

        // Year list: first year of JuniGrid use → current year ∪ years with play records
        var firstYear = DateTime.TryParse(_cfg.FirstRunDate, out var fr) ? fr.Year : DateTime.Now.Year;
        var ys = new HashSet<int>();
        for (var y = firstYear; y <= DateTime.Now.Year; y++) ys.Add(y);
        foreach (var k in data.Keys)
            if (k.Length >= 4 && int.TryParse(k.AsSpan(0, 4), out var y)) ys.Add(y);
        _years = ys.OrderByDescending(x => x).ToList();

        // Columns start at the Sunday of the week containing Jan 1 and run through Dec 31 (GitHub-style layout)
        var start = new DateTime(_heatYear, 1, 1);
        var d = start.AddDays(-((int)start.DayOfWeek));   // step back to Sunday
        var end = new DateTime(_heatYear, 12, 31);
        var today = DateTime.Today;

        _weeks = new();
        _monthLabels = new();
        var monthNames = new[] { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        int lastMonth = -1;
        long total = 0;
        int days = 0;

        while (d <= end)
        {
            var col = new List<HeatCell>(7);
            int colMonth = -1;   // month of the first in-year date in this column (used for the column header month label)
            for (var i = 0; i < 7; i++)
            {
                if (d.Year == _heatYear) { if (colMonth < 0) colMonth = d.Month; }
                col.Add(new HeatCell(d.ToString("yyyy-MM-dd"), d.Year == _heatYear, d > today,
                    d.Year == _heatYear && d <= today && data.TryGetValue(d.ToString("yyyy-MM-dd"), out var s) ? s : 0));
                d = d.AddDays(1);
            }
            _weeks.Add(col);

            // Month labels: only mark the column where a month first appears, same rule as the demo
            if (colMonth > 0 && colMonth != lastMonth)
            {
                _monthLabels.Add(monthNames[colMonth]);
                lastMonth = colMonth;
            }
            else _monthLabels.Add("");
        }

        foreach (var cell in _weeks.SelectMany(w => w))
        {
            if (cell.InYear && !cell.Future && cell.Seconds > 0) { total += cell.Seconds; days++; }
        }
        _yearTotalSeconds = total;
        _yearDays = days;
    }

    // ─── v1.1.6: year dropdown (generic dropdownToggle GSAP animation, dismissed by clicking the overlay) ───
    private bool _heatDdOpen;

    private async Task ToggleYearDd()
    {
        _heatDdOpen = !_heatDdOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-heat-yeardd", _heatDdOpen); } catch { }
    }

    private async Task CloseYearDd()
    {
        if (!_heatDdOpen) return;
        _heatDdOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-heat-yeardd", false); } catch { }
    }

    private async Task PickYear(int y)
    {
        _heatYear = y;
        await CloseYearDd();
        RebuildHeat();
    }

    private static string WdayLabel(int row) => row switch
    {
        1 => "Mon", 3 => "Wed", 5 => "Fri", _ => ""
    };

    // Hover pill tooltip (data-tip global delegation, works for dynamically rendered cells too)
    private static string Tip(HeatCell cell) =>
        cell.Seconds > 0
            ? $"{Math.Round(cell.Seconds / 3600.0, 1)} hours · {cell.Key}"
            : $"No playtime · {cell.Key}";

    private static string FormatHours(long seconds) =>
        seconds <= 0 ? "0 hours" : (seconds / 3600.0).ToString("0.0") + " hours";

    private static string FormatTime(string iso) =>
        DateTime.TryParse(iso, out var t) ? t.ToString("MM-dd HH:mm") : iso;
}
