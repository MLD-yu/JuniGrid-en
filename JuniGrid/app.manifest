<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="JuniGrid.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- v1.1.8: PerMonitorV2 — required for multi-monitor across screens.
       Under the default System awareness, the system virtualizes secondary-screen coordinates into
      another set of numbers from the process's point of view (e.g. a 1280×720 tablet looks like a
       scaled rectangle to the process), while the WM_GETMINMAXINFO hook / MonitorFromWindow /
       GetMonitorInfo keep writing values in true physical pixels (the code
       comments assume exactly this). When maximizing, the two coordinate systems misalign — in practice the window ended up
       off-screen starting around (5120,0), appearing as "the window disappears after maximizing on the secondary screen".
       PerMonitorV2 makes all Win32 geometry APIs return true physical pixels, matching the code's assumptions;
       both WPF(net10) and WebView2(Chromium) natively support it, and the UI re-lays out per DPI across screens. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">PerMonitor</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
