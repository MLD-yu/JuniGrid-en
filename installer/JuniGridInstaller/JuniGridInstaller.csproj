<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JuniGridInstaller</RootNamespace>
    <AssemblyName>JuniGridSetup</AssemblyName>
    <!-- Keep in sync with JuniGrid\Services\AppInfo.cs; build-installer.ps1 overrides this with the version from AppInfo.cs -->
    <Version>1.0.15</Version>
    <ApplicationIcon>..\..\JuniGrid\Assets\junigrid-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.48.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\keyart.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- Install payload: LZMA solid container of publish\sc (generated by make-payload.ps1 / build-installer.ps1 via PayloadTool) -->
  <ItemGroup>
    <EmbeddedResource Include="payload.lz" Condition="Exists('payload.lz')" />
  </ItemGroup>

  <!-- Fallback: auto-generate payload.lz when missing (normally produced by build-installer.ps1) -->
  <Target Name="EnsurePayload" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)payload.lz')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\make-payload.ps1&quot;" />
  </Target>

</Project>
